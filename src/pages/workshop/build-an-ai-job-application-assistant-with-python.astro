---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import WorkshopRegistrationForm from "../../components/WorkshopRegistrationForm.astro";
import WorkshopBreadcrumb from "../../components/WorkshopBreadcrumb.astro";
import WorkshopFAQ from "../../components/WorkshopFAQ.astro";
import InstructorStrip from "../../components/InstructorStrip.astro";
import MeetInstructorSection from "../../components/MeetInstructorSection.astro";
import { aiCohort, AI_COHORT_PATH } from "../../data/aiCohort";

const workshop = {
  title: "Build an AI Job Application Assistant with Python",
  startDate: "Saturday, October 24, 2026",
  time: "4:00 PM WAT",
  targetDate: "2026-10-24T16:00:00+01:00",
  level: "Basic Python required",
  thumbnail: "/images/ai-job-application-workshop-cover.png",
  instructorName: "Abasiodiong Udofia",
  instructorRole: "CTO at ChatJourno · 3MTT Mentor · Ex-Senior Backend Engineer at Paydue",
  instructorPhoto: "/images/abasiodiong-hs.png",
  slug: "build-an-ai-job-application-assistant-with-python",
};

const whatsappGroupUrl = "https://chat.whatsapp.com/CLuhwyHdqdyBEvgPF7o0W9?mode=gi_t";

const reasonsToJoin = [
  {
    title: "A project for your portfolio",
    description: "Start a project you can keep developing after the workshop. Add your own features and show how you built it when discussing your work with an employer or client.",
    icon: "M8 6V4h8v2M3 7h18v13H3V7Zm0 5a20 20 0 0 0 18 0M10 12h4v3h-4v-3Z",
  },
  {
    title: "Skills you can use at work",
    description: "Use the same techniques to pull useful details from documents, compare information, or draft responses. Learn where an AI model can help with tasks you already do.",
    icon: "M4 4h16v12H4V4Zm4 16h8m-4-4v4M8 8h8M8 12h5",
  },
  {
    title: "Understand what your code does",
    description: "Learn what you’re sending to the model, how its response is used, and what to change when the result is wrong. You’ll have a clearer idea of how to improve the app yourself.",
    icon: "m8 8-4 4 4 4m8-8 4 4-4 4m-3-11-2 22",
  },
];

const lessons = [
  {
    title: "Connect Python to an AI model",
    description: "Make an API call from Python, send instructions to an AI model, and use its response in your code.",
    icon: "m8 8-4 4 4 4m8-8 4 4-4 4m-3-11-2 22",
  },
  {
    title: "Read a CV and job description",
    description: "Write prompts that extract the skills a job requires and the experience a candidate has. Work with pasted text as you build.",
    icon: "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6Zm0 0v6h6M8 13h8M8 17h5",
  },
  {
    title: "Compare skills with job requirements",
    description: "Bring the two sets of information together. Find relevant experience and flag requirements the CV doesn’t cover.",
    icon: "M9 5H4v14h5M15 5h5v14h-5M8 8l3 4-3 4m8-8-3 4 3 4",
  },
  {
    title: "Write a personalised application",
    description: "Generate a draft for a specific role using the candidate’s experience. Check the result and learn how to improve the instructions.",
    icon: "M12 20H4V4h10M16 3l5 5-9 9-5 1 1-5 8-10Zm-2 3 5 5",
  },
];

const cohortBuilds = [
  "AI apps that use tools and APIs",
  "Document assistants with cited answers",
  "Multi-step agents with LangGraph",
  "A deployed project for your portfolio",
];

const faqs = [
  { question: "Is it free?", answer: "Yes. The live 60-minute workshop is free. Join us on Saturday, October 24, 2026 at 4:00 PM WAT." },
  { question: "How much Python do I need?", answer: "You should know basic Python and be comfortable following code. No previous AI or machine-learning experience is required." },
  { question: "Will you explain the code?", answer: "Yes. Your instructor will explain how the Python code, API calls, and prompts work together. You can ask questions during the live session, including why a particular approach is being used." },
  { question: "Can I turn this into a portfolio project?", answer: "Yes. The workshop build is a starting point you can extend afterwards. Add your own features, try different CVs and roles, and document how it works so you can explain the project when showing it to employers or clients." },
  { question: "How do I join?", answer: "Register, then join the WhatsApp group shown on your confirmation for access details, setup notes, and reminders." },
];
---

<Layout
  title={`${workshop.title} | UniversityX`}
  description="Learn to build and understand an AI application with Python. Start a portfolio project in this free live workshop on October 24, 2026 at 4 PM WAT."
  image={workshop.thumbnail}
  url={`https://universityx.app/workshop/${workshop.slug}/`}
>
  <div class="min-h-screen bg-white text-[#1A0533]">
    <Navbar />
    <main data-workshop-slug={workshop.slug}>
      <!-- Standard UniversityX workshop hero -->
      <section class="mx-auto max-w-7xl px-6 pb-12 pt-10 md:px-12 md:pb-16 lg:px-16 xl:px-24">
        <WorkshopBreadcrumb title={workshop.title} />

        <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-[1fr_360px] xl:gap-16">
          <div>
            <span class="mb-5 inline-block rounded-full bg-[#8A40F5]/10 px-4 py-1.5 text-sm font-bold text-[#8A40F5]">Free Workshop</span>

            <h1 class="mb-5 text-3xl font-extrabold leading-tight text-[#1A0533] md:text-4xl">
              Build an AI Job Application Assistant
              <em class="font-['Playfair_Display',serif] font-bold">with Python</em>
            </h1>

            <p class="mb-6 text-lg leading-relaxed text-gray-700">
              Learn to build an AI application you can understand and improve yourself. In this free 60-minute Python workshop, you’ll build a job application assistant that reads a CV, compares it with a job description, and drafts an application.
            </p>

            <ul class="mb-8 space-y-2.5 text-lg">
              {[
                "Understand how your Python code talks to an AI model.",
                "Build a project you can develop and add to your portfolio.",
                "Learn techniques you can use to automate tasks at work.",
                "Know how to check the AI’s output and improve your app.",
              ].map((item) => (
                <li class="flex items-start gap-3 text-gray-700">
                  <svg class="mt-0.5 h-5 w-5 shrink-0 text-[#8A40F5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m20 6-11 11-5-5" /></svg>
                  {item}
                </li>
              ))}
            </ul>

            <div class="mb-8 flex flex-wrap gap-3" aria-label="Workshop details">
              <span class="workshop-chip"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M16 3v4M8 3v4M3 10h18" /></svg>{workshop.startDate}</span>
              <span class="workshop-chip"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>{workshop.time}</span>
              <span class="workshop-chip"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12v8H4v-8M2 7h20v5H2zM12 7v13M12 7H7.5A2.5 2.5 0 1 1 10 4.5L12 7Zm0 0h4.5A2.5 2.5 0 1 0 14 4.5L12 7Z" /></svg>Free</span>
              <span class="workshop-chip"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12l-2 6 3 3H5l3-3-2-6Z" /><path d="M12 12v9" /></svg>{workshop.level}</span>
            </div>

            <InstructorStrip
              name={workshop.instructorName}
              role={workshop.instructorRole}
              photo={workshop.instructorPhoto}
            />
          </div>

          <aside class="lg:sticky lg:top-6">
            <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-lg">
              <img src={workshop.thumbnail} alt="Build an AI Job Application Assistant with Python — workshop with Abasiodiong Udofia" class="aspect-video w-full object-cover" loading="eager" />

              <div class="space-y-4 p-6">
                <div class="flex items-baseline gap-3">
                  <span class="text-3xl font-extrabold text-[#1A0533]">FREE</span>
                  <span class="text-base text-gray-400">Live 1-Hour Session</span>
                </div>

                <div class="flex items-center gap-2 text-lg text-gray-600">
                  <svg class="h-6 w-6 text-[#8A40F5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
                  {workshop.startDate}
                </div>
                <div class="flex items-center gap-2 text-lg text-gray-600">
                  <svg class="h-6 w-6 text-[#8A40F5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" /></svg>
                  {workshop.time}
                </div>

                <div class="mt-6 rounded-xl border border-[#F5F2EB]/80 bg-[#F5F2EB] p-4 text-center">
                  <p class="mb-2 text-xs font-bold uppercase tracking-wider text-[#8A40F5]">Workshop Starts In</p>
                  <div class="countdown-container flex items-center justify-center gap-3" data-target={workshop.targetDate}>
                    <div class="days-group flex flex-col"><span class="days-val text-3xl font-extrabold text-[#1A0533]">00</span><span class="mt-0.5 text-xs uppercase tracking-widest text-gray-500">Days</span></div>
                    <span class="days-sep pb-2 text-xl font-bold text-[#1A0533]/30">:</span>
                    <div class="flex flex-col"><span class="hours-val text-3xl font-extrabold text-[#1A0533]">00</span><span class="mt-0.5 text-xs uppercase tracking-widest text-gray-500">Hrs</span></div>
                    <span class="pb-2 text-xl font-bold text-[#1A0533]/30">:</span>
                    <div class="flex flex-col"><span class="minutes-val text-3xl font-extrabold text-[#1A0533]">00</span><span class="mt-0.5 text-xs uppercase tracking-widest text-gray-500">Min</span></div>
                    <span class="pb-2 text-xl font-bold text-[#1A0533]/30">:</span>
                    <div class="flex flex-col"><span class="seconds-val text-3xl font-extrabold text-[#1A0533]">00</span><span class="mt-0.5 text-xs uppercase tracking-widest text-gray-500">Sec</span></div>
                  </div>
                </div>

                <a id="enroll" href="#enroll-form" data-registration-cta="hero" class="mt-4 block w-full rounded-lg bg-[#8A40F5] px-8 py-4 text-center text-base font-semibold text-white transition-colors duration-200 hover:bg-[#7434D8] focus:outline-none focus:ring-2 focus:ring-[#8A40F5] focus:ring-offset-2">Reserve Free Spot</a>
              </div>
            </div>
          </aside>
        </div>
      </section>

      <section class="outcomes-section" aria-labelledby="outcomes-heading">
        <div class="section-shell">
          <div class="outcomes-intro">
            <h2 id="outcomes-heading" class="workshop-heading">Build the skills to create <em>your own AI applications.</em></h2>
            <p>If you’ve used AI to generate code and then got stuck trying to change it, this workshop is for you. We’ll build a small application and explain the decisions behind the code, so you can start making those decisions yourself.</p>
          </div>
          <div class="outcomes-grid">
            {reasonsToJoin.map((reason) => (
              <article class="outcome-card">
                <span class="lesson-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d={reason.icon} /></svg></span>
                <h3>{reason.title}</h3>
                <p>{reason.description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="what-youll-learn" class="learning-section" aria-labelledby="learning-heading">
        <div class="section-shell">
          <div class="learning-intro">
            <h2 id="learning-heading" class="workshop-heading">What you’ll <em>learn.</em></h2>
            <p>Your instructor, Abasiodiong Udofia, is CTO at ChatJourno and a 3MTT mentor. He’ll build the assistant live, explain how the code works, and answer your questions.</p>
          </div>

          <ol class="learning-grid">
            {lessons.map((lesson, index) => (
              <li class="lesson-card">
                <div class="lesson-card-top">
                  <span class="lesson-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d={lesson.icon} /></svg>
                  </span>
                  <span class="lesson-number" aria-hidden="true">0{index + 1}</span>
                </div>
                <h3>{lesson.title}</h3>
                <p>{lesson.description}</p>
              </li>
            ))}
          </ol>

          <div class="learning-footer">
            <p><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="m8 12 3 3 5-6" /></svg><span>Know basic Python? You’re ready to join.<br /><span class="learning-footer-detail">No previous AI experience needed.</span></span></p>
            <a href="#enroll-form" data-registration-cta="agenda" class="workshop-action">Reserve Free Spot <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a>
          </div>
        </div>
      </section>

      <section id="what-youll-build" class="project-section" aria-labelledby="build-heading">
        <div class="section-shell">
          <div class="project-intro">
            <h2 id="build-heading" class="workshop-heading">The project we’ll <em>build together.</em></h2>
            <p>You’ll put these skills into practice by building a job application assistant. Give it a CV and a job description, and it will compare the experience with the role and draft an application. Here’s an example.</p>
          </div>

          <figure class="project-example">
            <figcaption><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2" /><path d="M8 21h8m-4-4v4M7 9l2 2-2 2m5 0h4" /></svg>From the information you provide to a draft you can edit</figcaption>
            <div class="project-panels">
              <div class="project-panel project-input">
                <h3><span class="project-panel-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6Zm0 0v6h6M8 13h8M8 17h5" /></svg></span>Give it a role and a CV</h3>
                <div class="input-detail">
                  <h4>The job description</h4>
                  <p class="input-title">Junior Python Developer · Lagos</p>
                  <p>The role asks for Python, REST APIs, SQL, and deployment experience.</p>
                </div>
                <div class="input-detail">
                  <h4>The candidate’s CV</h4>
                  <p>Built an inventory API with Flask and PostgreSQL. Deployment experience isn’t mentioned.</p>
                </div>
              </div>

              <div class="project-panel project-output">
                <h3><span class="project-panel-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4h6m-6 0a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2H9V4ZM9 4H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-3M8 13l2 2 5-5M8 18h8" /></svg></span>Get a comparison and draft</h3>
                <ul class="comparison-results">
                  <li><svg class="result-match" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="m8 12 3 3 5-6" /></svg><span><strong>Relevant experience</strong>Flask API development and PostgreSQL.</span></li>
                  <li><svg class="result-gap" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v6m0 4h.01" /></svg><span><strong>Missing information</strong>Deployment experience needs clarification.</span></li>
                </ul>
                <div class="draft-excerpt">
                  <h4>An application draft</h4>
                  <blockquote>“I built an inventory API with Flask and PostgreSQL, giving me practical experience with REST endpoints and SQL databases.”</blockquote>
                </div>
              </div>
            </div>
            <p class="project-takeaway">After the session, you can build on this project: try other roles, improve the drafts, or add your own interface. You’ll have seen how the code works before making it your own.</p>
          </figure>
        </div>
      </section>

      <MeetInstructorSection
        name={workshop.instructorName}
        role={workshop.instructorRole}
        photo={workshop.instructorPhoto}
        background="warm"
        workshopDescription="In this workshop, he’ll explain the Python code as he builds the assistant, show why each step is needed, and answer your questions so you can apply what you learn to your own projects."
      />

      <WorkshopRegistrationForm
        workshopTitle={workshop.title}
        startDate={workshop.startDate}
        time={workshop.time}
        targetDate={workshop.targetDate}
        collectionName="Build_an_AI_Job_Application_Assistant_with_Python"
        workshopSlug={workshop.slug}
        cohortName={`${aiCohort.shortTitle} cohort`}
        collectWhatsApp={true}
        whatsappGroupUrl={whatsappGroupUrl}
        successMessage="Your free seat is reserved for Saturday, October 24 at 4:00 PM WAT. Join the WhatsApp group below for the workshop link, setup notes, and reminders."
      />

      <section class="cohort-section" aria-labelledby="cohort-heading">
        <div class="section-shell cohort-layout">
          <div class="cohort-copy">
            <p class="cohort-eyebrow">{aiCohort.durationWeeks}-week live cohort</p>
            <h2 id="cohort-heading" class="workshop-heading">Build and ship AI applications.</h2>
            <p class="cohort-description">Build on what you learn in this workshop with six weeks of live classes and hands-on projects. Learn to build AI applications with your own data, connect APIs, and improve your code with feedback from your instructor. Finish with a deployed project you can explain confidently and add to your portfolio.</p>
            <p class="cohort-start"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M16 3v4M8 3v4M3 11h18" /></svg><span>Starts <time datetime={aiCohort.startDate}>{aiCohort.startDateLabel}</time></span></p>
            <a href={AI_COHORT_PATH} data-cohort-cta class="workshop-action cohort-action">Explore the 6-week cohort <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a>
          </div>
          <div class="cohort-projects">
            <h3><span class="cohort-projects-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m13 2-9 12h7l-1 8 10-12h-7l1-8Z" /></svg></span>What you’ll build</h3>
            <ul>
              {cohortBuilds.map((build) => (
                <li><svg class="cohort-project-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="m8 12 3 3 5-6" /></svg><p>{build}</p></li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <WorkshopFAQ faqs={faqs} />
    </main>
    <Footer />
  </div>
</Layout>

<style>
  :global(html) { scroll-behavior: smooth; }
  .section-shell { max-width: 80rem; margin-inline: auto; padding-inline: 1.5rem; }
  .workshop-chip { display: inline-flex; align-items: center; gap: .65rem; border-radius: 999px; background: #F5F2EB; padding: .65rem 1.05rem; color: #1A0533; font-size: 1rem; font-weight: 500; line-height: 1.5; }
  .workshop-chip svg { width: 1.25rem; height: 1.25rem; flex: 0 0 auto; fill: none; stroke: #8A40F5; stroke-width: 2.15; stroke-linecap: round; stroke-linejoin: round; }
  .outcomes-section { padding-block: 3.5rem 4.5rem; border-top: 1px solid #EAE5DD; background: white; }
  .outcomes-intro { max-width: 49rem; margin-bottom: 2rem; }
  .outcomes-intro > p { margin-top: 1.25rem; color: #544D5D; font-size: 1.125rem; line-height: 1.625; }
  .outcomes-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.25rem; }
  .outcome-card { min-width: 0; padding: 1.75rem; border: 1px solid #E5DEEB; border-radius: 1.25rem; background: #FAF8FD; }
  .outcome-card h3 { margin-top: 1.5rem; color: #1A0533; font-size: 1.25rem; font-weight: 700; line-height: 1.4; }
  .outcome-card > p { margin-top: 1rem; color: #544D5D; font-size: 1.125rem; line-height: 1.625; }
  .learning-section { padding-block: 4.5rem; background: #F5F2EB; border-block: 1px solid #EAE5DD; }
  .workshop-heading { color: #1A0533; font-size: 1.875rem; font-weight: 800; line-height: 1.25; letter-spacing: -.035em; }
  .workshop-heading em { font-family: 'Playfair Display', serif; font-weight: 700; }
  .learning-intro { display: grid; align-items: start; gap: 1.25rem; margin-bottom: 2.25rem; }
  .learning-intro > p, .project-intro > p { max-width: 46rem; color: #544D5D; font-size: 1.125rem; line-height: 1.625; }
  .learning-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.25rem; list-style: none; padding: 0; }
  .lesson-card { min-width: 0; padding: 1.5rem; border: 1px solid #E5DEEB; border-radius: 1.25rem; background: #FFFFFF; box-shadow: 0 4px 16px rgb(26 5 51 / .035); }
  .lesson-card-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; }
  .lesson-icon { display: grid; flex-shrink: 0; width: 3.5rem; height: 3.5rem; place-items: center; border-radius: 1rem; background: #F0E7FD; color: #7130C6; }
  .lesson-icon svg { width: 1.75rem; height: 1.75rem; }
  .lesson-number { color: #766782; font-size: 1rem; font-weight: 600; font-variant-numeric: tabular-nums; }
  .lesson-card h3 { max-width: 24ch; color: #1A0533; font-size: 1.25rem; line-height: 1.4; font-weight: 700; }
  .lesson-card > p { margin-top: 1rem; color: #544D5D; font-size: 1.125rem; line-height: 1.625; }
  .learning-footer { display: flex; flex-direction: column; gap: 1.5rem; margin-top: 2rem; }
  .learning-footer > p { display: flex; align-items: flex-start; gap: .75rem; color: #1A0533; font-size: 1.125rem; font-weight: 600; line-height: 1.6; }
  .learning-footer > p > svg { flex-shrink: 0; width: 1.5rem; height: 1.5rem; margin-top: .2rem; color: #7130C6; }
  .learning-footer-detail { color: #544D5D; font-size: 1rem; font-weight: 400; line-height: 1.5; }
  .workshop-action { display: inline-flex; align-items: center; justify-content: center; gap: .75rem; min-height: 3.5rem; flex-shrink: 0; padding: 1rem 1.5rem; border-radius: .65rem; background: #8A40F5; color: white; font-size: 1rem; font-weight: 600; transition: background-color .2s; }
  .workshop-action svg { width: 1.25rem; height: 1.25rem; }
  .workshop-action:hover { background: #7434D8; }
