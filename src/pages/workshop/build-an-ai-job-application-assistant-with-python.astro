<script>
  declare global {
    interface Window {
      posthog?: any;
    }
  }

  function getAnalyticsContext() {
    const main = document.querySelector("main[data-workshop-slug]");
    const params = new URLSearchParams(window.location.search);
    const utmSource = params.get("utm_source")?.trim();
    let trafficSource = utmSource || "direct";

    if (!utmSource && document.referrer) {
      try {
        trafficSource = new URL(document.referrer).hostname || "direct";
      } catch {
        trafficSource = "direct";
      }
    }

    return {
      workshop_slug:
        main?.getAttribute("data-workshop-slug") ||
        "build-an-ai-job-application-assistant-with-python",
      referral_code: params.get("ref")?.trim() || null,
      traffic_source: trafficSource,
    };
  }

  function initWorkshopPage() {
    const analyticsContext = getAnalyticsContext();
    window.posthog?.capture("workshop_page_viewed", analyticsContext);

    document.querySelectorAll("[data-registration-cta]").forEach((cta) => {
      cta.addEventListener("click", () => {
        window.posthog?.capture("workshop_registration_cta_clicked", {
          ...analyticsContext,
          placement: cta.getAttribute("data-registration-cta"),
        });
      });
    });

    document.querySelectorAll("[data-cohort-cta]").forEach((cta) => {
      cta.addEventListener("click", () => {
        window.posthog?.capture("cohort_cta_clicked", {
          ...analyticsContext,
          destination: cta.getAttribute("href"),
        });
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initWorkshopPage);
  } else {
    initWorkshopPage();
  }
</script>
