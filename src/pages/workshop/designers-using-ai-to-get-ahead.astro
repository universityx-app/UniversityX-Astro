---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const workshop = {
  title: 'How Designers Are Using AI to Get Ahead',
  price: 0,
  startDate: 'Friday, May 29th',
  duration: '1-Day Live Workshop',
  level: 'Beginner - Intermediate',
  format: 'Free Live Event',
  thumbnail: '/images/tayo-workshop-cover.png',
  instructorPhoto: '/images/tayo-hs.png',
};
---

