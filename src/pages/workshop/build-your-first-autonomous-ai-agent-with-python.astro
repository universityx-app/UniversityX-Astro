            Frequently Asked Questions
          </h2>
          <p class="text-gray-600 text-base md:text-lg">
            Everything you need to know before joining the live session.
          </p>
        </div>

        <div class="max-w-3xl mx-auto space-y-4" id="faq">
          {
            faqs.map(({ q, a }) => (
              <div class="accordion-item border border-gray-200 rounded-2xl overflow-hidden bg-white shadow-sm hover:border-gray-300 transition-colors">
                <button
                  class="accordion-trigger w-full flex items-center justify-between px-6 md:px-8 py-5 text-left bg-white hover:bg-gray-50/80 transition-colors duration-200 cursor-pointer"
                  aria-expanded="false"
                >
                  <span class="font-bold text-[#1A0533] text-base md:text-lg pr-4">
                    {q}
                  </span>
                  <svg
                    class="accordion-chevron w-5 h-5 text-gray-400 transition-transform duration-300 shrink-0"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <polyline points="6 9 12 15 18 9" />
