---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Growth Co-founder Conversation - UniversityX"
  description="UniversityX is live and looking for a growth and commercial co-founder to help build the distribution engine for AI-first learning in Africa."
>
  <Navbar />

  <!-- Hero -->
  <section class="bg-[#1A0533] text-white px-6 pt-16 pb-14 relative overflow-hidden mt-5">
    <div class="absolute -top-20 -right-20 w-80 h-80 rounded-full bg-[#8A40F5]/10 pointer-events-none"></div>
    <div class="max-w-2xl mx-auto relative z-10">
      <div class="inline-block text-[11px] font-semibold tracking-widest uppercase text-[#D4A853] border border-[#D4A853]/40 px-4 py-1.5 rounded-sm mb-8">
        Co-founder role &middot; Equity-based
      </div>
      <h1 class="text-4xl md:text-6xl font-extrabold leading-[1.1] tracking-tight mb-5">
        We're looking for a<br>
        <span class="italic font-extrabold text-[#D4A853]">Chief Growth Officer</span><br>
        Co-founder
      </h1>
      <p class="text-white/70 text-base md:text-lg leading-relaxed max-w-xl mb-10">
        We're building AI-first learning infrastructure for African professionals, creators, universities, and businesses. The product is already live, we've hosted programs and workshops, and we're now looking for a growth/commercial co-founder to help turn this into a serious distribution engine.
      </p>
      <div class="flex flex-wrap gap-8 border-t border-white/10 pt-7">
        <div class="flex flex-col">
          <span class="text-2xl font-bold text-white leading-none">Live product</span>
          <span class="text-xs text-white/50 mt-1 tracking-wide">Already in market</span>
        </div>
        <div class="flex flex-col">
          <span class="text-2xl font-bold text-white leading-none">Programs run</span>
          <span class="text-xs text-white/50 mt-1 tracking-wide">Courses and workshops</span>
        </div>
        <div class="flex flex-col">
          <span class="text-2xl font-bold text-white leading-none">Growth gap</span>
          <span class="text-xs text-white/50 mt-1 tracking-wide">Distribution and revenue</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Form area -->
  <div class="bg-[#FBF8F1] min-h-screen">
    <div class="max-w-2xl mx-auto px-6 py-16">

      <!-- Note box -->
      <div class="bg-[#D4A853]/10 border-l-4 border-[#D4A853] rounded-r-lg px-5 py-4 text-sm text-[#8a6318] leading-relaxed mb-12">
        This is not a job application. It's the start of a conversation with someone who may want to build UniversityX from the ground up with us. If that's not you but you know who it is, please send this to them.
      </div>

      <form
        id="appForm"
        novalidate
        class="space-y-0"
      >

        <!-- Section 1: A bit about you -->
        <div class="mb-14">
          <div class="flex items-center gap-3 mb-6">
            <span class="text-[11px] font-semibold tracking-widest uppercase text-[#D4A853]">01. A bit about you</span>
            <div class="flex-1 h-px bg-gray-200"></div>
          </div>

          <div class="mb-5">
            <div>
              <label for="full-name" class="block text-sm font-semibold text-[#1A0533] mb-2">Full name</label>
              <input type="text" id="full-name" name="full_name" placeholder="Your name" required
                class="w-full bg-gray-50 rounded-xl px-4 py-3 text-sm text-gray-800 placeholder-gray-400 border border-transparent focus:outline-none focus:ring-2 focus:ring-[#D4A853] transition-shadow" />
            </div>
          </div>

          <div class="mb-5">
            <label for="email" class="block text-sm font-semibold text-[#1A0533] mb-2">Email address</label>
            <input type="email" id="email" name="email" placeholder="you@example.com" required
              class="w-full bg-gray-50 rounded-xl px-4 py-3 text-sm text-gray-800 placeholder-gray-400 border border-transparent focus:outline-none focus:ring-2 focus:ring-[#D4A853] transition-shadow" />
          </div>

          <div class="mb-5">
            <label for="linkedin" class="block text-sm font-semibold text-[#1A0533] mb-2">LinkedIn profile URL</label>
            <input type="url" id="linkedin" name="linkedin" placeholder="https://linkedin.com/in/..." required
              class="w-full bg-gray-50 rounded-xl px-4 py-3 text-sm text-gray-800 placeholder-gray-400 border border-transparent focus:outline-none focus:ring-2 focus:ring-[#D4A853] transition-shadow" />
          </div>

          <div class="mb-5">
            <label for="current-role" class="block text-sm font-semibold text-[#1A0533] mb-2">
              Current role <span class="font-normal text-gray-400 text-xs ml-1">if any</span>
            </label>
            <input type="text" id="current-role" name="current_role" placeholder="e.g. BD Manager at TechCorp, or Freelance" required
              class="w-full bg-gray-50 rounded-xl px-4 py-3 text-sm text-gray-800 placeholder-gray-400 border border-transparent focus:outline-none focus:ring-2 focus:ring-[#D4A853] transition-shadow" />
          </div>

        </div>  

        <!-- Section 2: The conversation starter -->
        <div class="mb-14">
          <div class="flex items-center gap-3 mb-6">
            <span class="text-[11px] font-semibold tracking-widest uppercase text-[#D4A853]">02. The conversation starter</span>
            <div class="flex-1 h-px bg-gray-200"></div>
          </div>

          <div class="mb-5">
            <label for="creative-growth" class="block text-sm font-semibold text-[#1A0533] mb-2">What have you grown before?</label>
            <textarea id="creative-growth" name="creative_growth_story" placeholder="An audience, community, product, revenue line, partnership channel, creator brand..." rows="4" required
              class="w-full bg-gray-50 rounded-xl px-4 py-3 text-sm text-gray-800 placeholder-gray-400 border border-transparent focus:outline-none focus:ring-2 focus:ring-[#D4A853] transition-shadow resize-y"></textarea>
          </div>

          <div class="mb-5">
            <label for="universityx-interest" class="block text-sm font-semibold text-[#1A0533] mb-2">Why does UniversityX interest you?</label>
            <textarea id="universityx-interest" name="one_sentence_pitch" placeholder="What about the problem, market, product, or mission pulls you in?" rows="4" required
              class="w-full bg-gray-50 rounded-xl px-4 py-3 text-sm text-gray-800 placeholder-gray-400 border border-transparent focus:outline-none focus:ring-2 focus:ring-[#D4A853] transition-shadow resize-y"></textarea>
          </div>

          <div>
            <label for="anything-else" class="block text-sm font-semibold text-[#1A0533] mb-2">Anything else you want us to know?</label>
            <textarea id="anything-else" name="cofounder_vision" rows="4" placeholder="Context, links, questions, constraints, referrals, anything useful..."
              class="w-full bg-gray-50 rounded-xl px-4 py-3 text-sm text-gray-800 placeholder-gray-400 border border-transparent focus:outline-none focus:ring-2 focus:ring-[#D4A853] transition-shadow resize-y"></textarea>
          </div>
        </div>

        <!-- Submit -->
        <div class="pt-2">
          <button type="submit"
            class="w-full bg-[#8A40F5] hover:bg-[#7434D8] text-white font-bold text-base rounded-full py-4 transition-colors duration-200 cursor-pointer">
            Start the conversation
          </button>
          <p class="text-xs text-gray-400 text-center mt-4 leading-relaxed">
            Every note is reviewed personally. If there is a potential fit, Damilare or someone from UniversityX will follow up for a real conversation.
          </p>
        </div>
      </form>

      <!-- Success state -->
      <div id="successState" class="hidden text-center py-20">
        <div class="w-14 h-14 bg-[#8A40F5] rounded-full flex items-center justify-center mx-auto mb-6">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        <h2 class="text-3xl font-extrabold text-[#1A0533] mb-3">Conversation started.</h2>
        <p class="text-gray-500 text-base max-w-sm mx-auto">Thanks for reaching out. Damilare or someone from UniversityX will follow up if there is a potential fit.</p>
      </div>

    </div>
  </div>

  <Footer />
</Layout>

<script>
  function initCofounderForm() {
    const form = document.getElementById('appForm');
    const successState = document.getElementById('successState');
    if (!form) return;

    const submitBtn = form.querySelector('button[type="submit"]');
    const pbUrl = import.meta.env.PUBLIC_POCKETBASE_URL;
    const endpoint = `${pbUrl}/api/collections/Cofounder_Applications/records`;
    const emailInput = form.querySelector('#email');
    const linkedInInput = form.querySelector('#linkedin');
    const requiredTextInputs = form.querySelectorAll('input[required], textarea[required]');

    function validateForm() {
      let isValid = true;

      requiredTextInputs.forEach((field) => {
        if (!field.value.trim()) {
          field.reportValidity();
          isValid = false;
        }
      });

      if (!isValid) return false;
      if (emailInput && !emailInput.checkValidity()) return emailInput.reportValidity(), false;
      if (linkedInInput && !linkedInInput.checkValidity()) return linkedInInput.reportValidity(), false;

      return true;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!submitBtn) return;
      if (!validateForm()) return;

      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting...';

      const formData = new FormData(form);

      const data = {
        full_name: formData.get('full_name') as string,
        email: formData.get('email') as string,
        linkedin: formData.get('linkedin') as string,
        current_role: formData.get('current_role') as string,
        one_sentence_pitch: formData.get('one_sentence_pitch') as string,
        creative_growth_story: (formData.get('creative_growth_story') as string) || '',
        cofounder_vision: (formData.get('cofounder_vision') as string) || '',
      };

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(data),
        });

        if (!response.ok) {
          const error = await response.json().catch(() => null);
          console.error('Cofounder form submission failed:', error);
          throw new Error('Failed to submit cofounder form');
        }

        window.posthog?.capture('cofounder_application_submitted', {
          form_name: 'cofounder-conversation',
        });

        form.classList.add('hidden');
        if (successState) successState.classList.remove('hidden');
        window.scrollTo({ top: form.offsetTop - 100, behavior: 'smooth' });
      } catch {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Start the conversation';
        alert('Something went wrong. Please try again or email us directly.');
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCofounderForm);
  } else {
    initCofounderForm();
  }
</script>
