---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { AI_COHORT_PATH, aiCohort, formatNaira } from '../data/aiCohort';
---

<Layout
  title="Live Cohorts | UniversityX"
  description="Join a live UniversityX cohort and build practical, portfolio-ready skills with expert guidance and a focused learning community."
>
  <Navbar />

  <main class="min-h-[70vh] bg-[#F5F2EB] text-[#1A0533]">
    <header class="mx-auto max-w-6xl px-6 pb-12 pt-16 md:px-12 md:pb-16 md:pt-24">
      <p class="text-xs font-extrabold uppercase tracking-[0.16em] text-[#8A40F5]">Live UniversityX programmes</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-extrabold leading-tight tracking-tight md:text-6xl">Cohorts built around doing the work.</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-gray-600">Learn with an instructor, build alongside a focused group, and finish with practical proof of what you can do.</p>
    </header>

    <section class="mx-auto max-w-6xl px-6 pb-20 md:px-12 md:pb-28" aria-labelledby="current-cohorts-heading">
      <h2 id="current-cohorts-heading" class="sr-only">Current cohorts</h2>
      <article class="overflow-hidden rounded-3xl border border-[#1A0533]/10 bg-white shadow-xl shadow-[#1A0533]/5">
        <div class="grid gap-0 lg:grid-cols-[1fr_290px]">
          <div class="p-7 md:p-10">
            <span class="inline-flex rounded-full bg-[#8A40F5] px-3 py-1 text-xs font-bold uppercase tracking-wider text-white">Now enrolling</span>
            <h2 class="mt-5 max-w-3xl text-3xl font-extrabold leading-tight md:text-4xl">{aiCohort.title}</h2>
            <p class="mt-4 max-w-3xl leading-7 text-gray-600">Build AI applications that work with your own data, use tools and APIs, complete multi-step tasks, and are ready to deploy and demonstrate.</p>

            <dl class="mt-7 flex flex-wrap gap-x-7 gap-y-4 text-sm">
              <div><dt class="text-gray-400">Starts</dt><dd class="mt-1 font-bold">{aiCohort.startDateLabel}</dd></div>
              <div><dt class="text-gray-400">Duration</dt><dd class="mt-1 font-bold">{aiCohort.durationWeeks} weeks</dd></div>
              <div><dt class="text-gray-400">Prerequisite</dt><dd class="mt-1 font-bold">{aiCohort.prerequisite}</dd></div>
            </dl>
          </div>

          <div class="flex flex-col justify-between bg-[#1A0533] p-7 text-white md:p-9">
            <div>
              <p class="text-xs font-bold uppercase tracking-widest text-[#B98BFF]">Full payment</p>
              <p class="mt-3 text-4xl font-extrabold">{formatNaira(aiCohort.fullPaymentPrice)}</p>
              <p class="mt-2 text-sm text-white/55">Enrollment is currently open.</p>
            </div>
            <a href={AI_COHORT_PATH} class="mt-8 inline-flex items-center justify-center rounded-full bg-[#8A40F5] px-6 py-3.5 font-bold text-white transition hover:bg-[#7434D8] focus:outline-none focus:ring-2 focus:ring-[#B98BFF] focus:ring-offset-2 focus:ring-offset-[#1A0533]">
              View the cohort <span class="ml-2" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </article>
    </section>
  </main>

  <Footer />
</Layout>
