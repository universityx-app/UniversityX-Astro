---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CohortCard from '../components/CohortCard.astro';
---

<Layout title="Live Cohorts | UniversityX" description="Join a live UniversityX cohort and build practical, portfolio-ready skills with expert guidance and a focused learning community.">
  <Navbar />
  <main class="min-h-[70vh] bg-[#1A0533] text-white">
    <header class="mx-auto max-w-7xl px-6 pb-12 pt-16 md:px-12 md:pb-16 md:pt-24 lg:px-24">
      <p class="text-xs font-extrabold uppercase tracking-[0.16em] text-[#B98BFF]">Live UniversityX programmes</p>
      <h1 class="mt-4 max-w-4xl text-4xl font-extrabold leading-tight md:text-6xl">Cohorts built around doing the work.</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-white/65">Learn with an instructor, build alongside a focused group, and finish with practical proof of what you can do.</p>
    </header>
    <section class="mx-auto max-w-7xl px-6 pb-20 md:px-12 md:pb-28 lg:px-24" aria-labelledby="current-cohorts-heading">
      <h2 id="current-cohorts-heading" class="sr-only">Current cohorts</h2>
      <CohortCard />
    </section>
  </main>
  <Footer />
</Layout>
