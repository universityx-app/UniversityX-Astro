---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import OneToOneInquiryForm from '../../../components/OneToOneInquiryForm.astro';
import { availableCourses, type Course } from '../../../data/courses';

export function getStaticPaths() { return availableCourses.map((course) => ({ params: { slug: course.slug }, props: { course } })); }
interface Props { course: Course }
const { course } = Astro.props;
---

<Layout title={`Request 1-on-1 support for ${course.title} | UniversityX`} description={`Tell UniversityX what you need from personalised instruction for ${course.title}.`}>
  <Navbar />
  <main class="bg-[#F5F2EB] text-[#1A0533]">
    <section class="mx-auto grid min-h-[75vh] max-w-7xl items-start gap-12 px-6 py-12 md:px-12 md:py-18 lg:grid-cols-[.8fr_1.2fr] lg:px-16 xl:px-24">
      <div class="lg:sticky lg:top-8">
        <nav class="mb-8 flex flex-wrap items-center gap-2 text-sm text-gray-500" aria-label="Breadcrumb"><a href={`/course/${course.slug}/`} class="hover:text-[#8A40F5]">Course overview</a><span aria-hidden="true">/</span><span class="font-semibold text-[#1A0533]">1-on-1 request</span></nav>
        <p class="text-sm font-bold uppercase tracking-widest text-[#8A40F5]">Personal instruction</p>
        <h1 class="mt-3 text-4xl font-extrabold leading-tight md:text-5xl">Let’s shape the right support around you.</h1>
        <p class="mt-6 text-lg leading-8 text-gray-600">You’re requesting 1-on-1 support for <strong class="text-[#1A0533]">{course.title}</strong>.</p>
        <div class="mt-8 flex items-center gap-4 border-t border-[#1A0533]/10 pt-8"><img src={course.thumbnail} alt="" class="h-20 w-28 rounded-lg object-cover" /><div><p class="font-bold">{course.level}</p><p class="mt-1 text-sm text-gray-500">{course.track}</p></div></div>
      </div>
      <OneToOneInquiryForm course={course} />
    </section>
  </main>
  <Footer />
</Layout>
