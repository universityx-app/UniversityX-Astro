---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import { availableCourses, type Course } from '../../../data/courses';
import { aiCohort, formatNaira } from '../../../data/aiCohort';

export function getStaticPaths() { return availableCourses.map((course) => ({ params: { slug: course.slug }, props: { course } })); }
interface Props { course: Course }
const { course } = Astro.props;
---

<Layout title={`Cohorts for ${course.title} | UniversityX`} description={`Learn ${course.title} with a structured UniversityX cohort.`}>
  <Navbar />
  <main class="min-h-[70vh] bg-white text-[#1A0533]">
    <section class="bg-[#F5F2EB] py-14 md:py-20"><div class="mx-auto max-w-6xl px-6 md:px-12"><nav class="mb-7 text-sm text-gray-500" aria-label="Breadcrumb"><a href={`/course/${course.slug}/`} class="hover:text-[#8A40F5]">{course.title}</a><span class="mx-2">/</span><span class="font-semibold text-[#1A0533]">Cohorts</span></nav><p class="text-sm font-bold uppercase tracking-widest text-[#8A40F5]">Learn with others</p><h1 class="mt-3 max-w-4xl text-4xl font-extrabold leading-tight md:text-6xl">Available cohort</h1><p class="mt-5 max-w-3xl text-lg leading-8 text-gray-600">Build with a clear schedule, instructor guidance, peer momentum, and feedback along the way.</p></div></section>
    <section class="py-14 md:py-20"><div class="mx-auto max-w-5xl px-6 md:px-12"><a href={course.cohortPath || '#'} class="group grid gap-7 rounded-2xl border border-[#8A40F5]/25 bg-white p-7 shadow-xl shadow-[#1A0533]/6 transition hover:-translate-y-0.5 hover:border-[#8A40F5] md:grid-cols-[1fr_auto] md:items-center md:p-10"><div><span class="rounded-full bg-[#E9F8EF] px-3 py-1.5 text-xs font-bold text-[#16834A]">Now enrolling</span><h2 class="mt-5 text-2xl font-extrabold md:text-3xl">{aiCohort.title}</h2><p class="mt-4 max-w-3xl text-base leading-7 text-gray-600">The current AI Engineering cohort supports this course through guided building, project feedback, and a committed peer group.</p><div class="mt-6 flex flex-wrap gap-3 text-sm font-semibold"><span class="rounded-full bg-[#F5F2EB] px-3 py-2">{aiCohort.durationWeeks} weeks</span><span class="rounded-full bg-[#F5F2EB] px-3 py-2">Starts {aiCohort.startDateLabel}</span><span class="rounded-full bg-[#F5F2EB] px-3 py-2">From {formatNaira(aiCohort.fullPaymentPrice)}</span></div></div><span class="font-extrabold text-[#8A40F5] group-hover:underline">View cohort →</span></a></div></section>
  </main>
  <Footer />
</Layout>
