---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const lumaUrl = 'https://luma.com/rod4c06c';

const eventDetails = [
  {
    label: 'Date',
    value: 'Sunday, 31st May',
    icon: 'calendar',
  },
  {
    label: 'Time',
    value: '6:00 PM',
    icon: 'clock',
  },
  {
    label: 'Location',
    value: 'Online',
    icon: 'location',
  },
];

---

<Layout
  title="UniversityX Online Community Hangout"
  description="Couldn't join us yesterday? Join UniversityX online today by 6PM as we continue celebrating two years of the community."
  image="/images/social-card.png"
  url="https://universityx.app/hangout"
>
  <Navbar />

  <main class="bg-white pt-5 md:pt-7">
    <section class="relative overflow-hidden bg-[#1A0533] text-white">
      <div class="absolute inset-0 opacity-25">
        <img
          src="/images/community.jpg"
          alt=""
          class="h-full w-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="absolute inset-0 bg-linear-to-r from-[#1A0533] via-[#1A0533]/95 to-[#1A0533]/70"></div>

      <div class="relative max-w-7xl mx-auto px-6 md:px-12 lg:px-16 xl:px-24 pt-16 pb-18 md:pt-24 md:pb-24">
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_380px] gap-10 lg:gap-16 items-center">
          <div>
            <span class="inline-flex items-center rounded-full bg-white/10 px-4 py-2 text-sm font-semibold text-white border border-white/10 mb-6">
              Online Follow-Up Today
            </span>

            <h1 class="text-4xl md:text-6xl font-extrabold leading-tight tracking-tight max-w-3xl">
              Couldn't join us yesterday?
              <em class="block font-['Playfair_Display',serif] font-bold text-[#F5F2EB]">
                Join us online today by 6PM.
              </em>
            </h1>

            <p class="mt-6 text-lg md:text-xl text-gray-300 leading-relaxed max-w-2xl">
              The physical hangout happened yesterday, but the celebration is still open online.
              Come through today as we continue marking two years of UniversityX with the community.
            </p>

            <div class="mt-9 flex flex-wrap items-center gap-4">
              <a
                href={lumaUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 bg-[#BB39B4] hover:bg-[#a832a1] text-white font-semibold px-8 py-4 rounded-full transition-colors text-base"
              >
                Join Online on Luma
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </a>
              <p class="text-sm text-gray-400 max-w-xs">
                Use the same Luma link to get the online session details.
              </p>
            </div>
          </div>

          <aside class="bg-white text-[#1A0533] rounded-2xl shadow-2xl overflow-hidden">
            <img
              src="/images/UniversityX-Recap.jpeg"
              alt="UniversityX community members"
              class="w-full aspect-video object-cover object-top"
              loading="eager"
            />
            <div class="p-6">
              <p class="text-xs font-semibold text-[#BB39B4] uppercase tracking-widest mb-5">
                Event Details
              </p>
              <div class="space-y-4">
                {eventDetails.map((detail) => (
                  <div class="flex items-center gap-4">
                    <div class="w-11 h-11 rounded-xl bg-[#BB39B4]/10 text-[#BB39B4] flex items-center justify-center shrink-0">
                      {detail.icon === 'calendar' && (
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <rect x="3" y="4" width="18" height="18" rx="2" />
                          <line x1="16" y1="2" x2="16" y2="6" />
                          <line x1="8" y1="2" x2="8" y2="6" />
                          <line x1="3" y1="10" x2="21" y2="10" />
                        </svg>
                      )}
                      {detail.icon === 'clock' && (
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <circle cx="12" cy="12" r="10" />
                          <polyline points="12 6 12 12 16 14" />
                        </svg>
                      )}
                      {detail.icon === 'location' && (
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M21 10c0 7-9 12-9 12S3 17 3 10a9 9 0 0 1 18 0Z" />
                          <circle cx="12" cy="10" r="3" />
                        </svg>
                      )}
                    </div>
                    <div>
                      <p class="text-sm text-gray-500">{detail.label}</p>
                      <p class="text-lg font-bold">{detail.value}</p>
                    </div>
                  </div>
                ))}
              </div>

              <a
                href={lumaUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-7 block w-full text-center bg-[#BB39B4] hover:bg-[#a832a1] text-white font-semibold px-8 py-4 rounded-lg transition-colors duration-200 text-base"
              >
                Join Online on Luma
              </a>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section class="bg-[#F5F2EB] py-16 md:py-20">
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-16 xl:px-24">
        <div class="max-w-3xl">
          <p class="text-xs font-semibold text-[#BB39B4] uppercase tracking-widest mb-3">
            Join The Follow-Up
          </p>
          <h2 class="text-2xl md:text-4xl font-extrabold text-[#1A0533] leading-tight mb-6">
            The celebration continues online today.
          </h2>
          <div class="space-y-4 text-gray-700 leading-relaxed text-lg">
            <p>
              UniversityX started with a simple belief: learning should connect you to real people,
              useful skills, and practical opportunities. Yesterday brought the community together
              in person, and today keeps that energy going online.
            </p>
            <p>
              Join by 6PM to meet the community, celebrate the wins, share what you are building,
              and spend time with people who care about learning.
            </p>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
