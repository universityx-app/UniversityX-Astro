---
import Layout from '../../../../layouts/Layout.astro';
import Navbar from '../../../../components/Navbar.astro';
import Footer from '../../../../components/Footer.astro';
import { AI_COHORT_PATH, aiCohort, formatNaira } from '../../../../data/aiCohort';
---

<Layout title="AI Engineering Cohorts | UniversityX" description="Join practical UniversityX AI Engineering cohorts and build useful applications with expert guidance and project feedback.">
  <Navbar />
  <main class="bg-white text-[#1A0533]">
    <section class="bg-[#F5F2EB] py-16 md:py-24">
      <div class="mx-auto max-w-7xl px-6 md:px-12 lg:px-16 xl:px-24">
        <nav class="mb-8 flex items-center gap-2 text-sm text-gray-500"><a href="/paths/ai-data-science/" class="hover:text-[#8A40F5]">AI &amp; Data Science</a><span>→</span><a href="/paths/ai-data-science/ai-engineering/" class="hover:text-[#8A40F5]">AI Engineering</a><span>→</span><span class="font-semibold text-[#1A0533]">Cohorts</span></nav>
        <h1 class="max-w-4xl text-5xl font-extrabold leading-tight tracking-tight md:text-6xl">AI Engineering cohorts</h1>
        <p class="mt-6 max-w-3xl text-xl leading-8 text-gray-600">Focused learning experiences where developers build, get feedback, and finish with proof.</p>
      </div>
    </section>

    <section class="py-16 md:py-24">
      <div class="mx-auto max-w-6xl px-6 md:px-12">
        <a href={AI_COHORT_PATH} class="grid gap-7 rounded-3xl border border-[#8A40F5]/25 bg-white p-7 shadow-lg shadow-[#1A0533]/5 transition hover:-translate-y-0.5 hover:border-[#8A40F5] md:grid-cols-[1fr_auto] md:items-center md:p-10">
          <div><span class="rounded-full bg-[#8A40F5] px-3 py-1 text-xs font-bold text-white">Now enrolling</span><h2 class="mt-5 text-3xl font-extrabold">{aiCohort.title}</h2><p class="mt-4 max-w-3xl text-lg leading-8 text-gray-600">For developers with basic Python who want to move from watching tutorials to shipping AI applications.</p><p class="mt-5 font-bold">{aiCohort.durationWeeks} weeks · {aiCohort.startDateLabel} · {formatNaira(aiCohort.fullPaymentPrice)}</p></div>
          <span class="font-extrabold text-[#8A40F5]">View cohort →</span>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
