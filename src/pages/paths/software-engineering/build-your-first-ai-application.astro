---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const checkIcon = 'M20 6 9 17l-5-5';
const codeIcon = 'm16 18 6-6-6-6M8 6l-6 6 6 6';
const routeIcon = 'M3 6h6a4 4 0 0 1 4 4v4a4 4 0 0 0 4 4h4M17 14l4 4-4 4M3 18h4';
const searchIcon = 'm21 21-4.35-4.35M10.5 18a7.5 7.5 0 1 1 0-15 7.5 7.5 0 0 1 0 15Z';
const shieldIcon = 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z';
const playIcon = 'M7 4v16l13-8L7 4Z';
const clockIcon = 'M12 6v6l4 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z';
const usersIcon = 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75';
const trophyIcon = 'M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4ZM5 6H3v2a4 4 0 0 0 4 4M19 6h2v2a4 4 0 0 1-4 4';
const calendarIcon = 'M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z';
const messageIcon = 'M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4v8Z';

const heroStats = [
  { icon: calendarIcon, value: '6 weeks', label: 'Live online sprint' },
  { icon: clockIcon, value: '4 hrs', label: 'Focused weekly build time' },
  { icon: usersIcon, value: '20 max', label: 'Small cohort' },
];

const stack = ['Python', 'LangChain', 'LangGraph', 'RAG', 'Guardrails', 'Evals'];

const outcomes = [
  {
    icon: codeIcon,
    title: 'Tool-using agents',
    text: 'Assistants that call APIs and return structured outputs.',
  },
  {
    icon: routeIcon,
    title: 'Agent workflows',
    text: 'State, routing, memory, and human approval with LangGraph.',
  },
  {
    icon: searchIcon,
    title: 'Document intelligence',
    text: 'RAG and exact-section retrieval with cited answers.',
  },
  {
    icon: shieldIcon,
    title: 'Production habits',
    text: 'Guardrails, tracing, evaluations, and clear demo evidence.',
  },
];

const projects = [
  { title: 'Tool Assistant', build: 'API-calling assistant', icon: codeIcon },
  { title: 'Workflow Agent', build: 'Routed LangGraph flow', icon: routeIcon },
  { title: 'Document RAG', build: 'Ask questions over files', icon: searchIcon },
  { title: 'Research Assistant', build: 'Find exact sections', icon: messageIcon },
  { title: 'Guardrailed System', build: 'Checks, traces, evals', icon: shieldIcon },
  { title: 'Support Ops Agent', build: 'Capstone demo repo', icon: trophyIcon },
];

const weeks = [
  { label: 'Setup', title: 'Python environment', build: 'Ready local AI workspace' },
  { label: '01', title: 'Agents + tools', build: 'Tool-using assistant' },
  { label: '02', title: 'LangGraph workflows', build: 'Stateful workflow agent' },
  { label: '03', title: 'RAG retrieval', build: 'Document Q&A assistant' },
  { label: '04', title: 'Vectorless search', build: 'Research assistant' },
  { label: '05', title: 'Guardrails + evals', build: 'Safer AI system' },
  { label: '06', title: 'Capstone demo', build: 'Support operations agent' },
];

const tuitionIncludes = [
  { icon: calendarIcon, text: 'Six live weeks' },
  { icon: codeIcon, text: 'Six project repos' },
  { icon: messageIcon, text: 'Office hours' },
  { icon: shieldIcon, text: 'Code feedback' },
  { icon: trophyIcon, text: 'Capstone review' },
  { icon: checkIcon, text: 'Certificate' },
];

const faqs = [
  {
    q: 'Can a complete beginner join?',
    a: 'Not yet. You should already know basic Python, packages, JSON, and Git.',
  },
  {
    q: 'What do I leave with?',
    a: 'Six small AI systems, one capstone repo, a README, and a demo you can explain.',
  },
  {
    q: 'Why pay if resources are free?',
    a: 'The resources support you. The value is structure, deadlines, feedback, and finished work.',
  },
  {
    q: 'Does this guarantee a job?',
    a: 'No. It gives you practical AI engineering proof and better project conversations.',
  },
];
---

<Layout
  title="Build and Ship Agentic AI Applications in 6 Weeks | UniversityX"
  description="Build tool-using AI agents, LangGraph workflows, RAG systems, guardrails, evaluations, and a portfolio-ready capstone in a six-week UniversityX sprint."
>
  <Navbar />

  <main class="overflow-x-hidden bg-white text-[#1A0533]">
    <section class="max-w-7xl mx-auto px-6 md:px-12 lg:px-16 xl:px-24 pt-10 pb-0">
      <nav class="mb-8 flex items-center gap-2 overflow-x-auto whitespace-nowrap text-sm text-gray-500" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-[#8A40F5]">Home</a>
        <svg class="h-3.5 w-3.5 shrink-0 text-[#8A40F5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 18l6-6-6-6" />
        </svg>
        <a href="/paths/software-engineering" class="transition-colors hover:text-[#8A40F5]">Software Engineering</a>
        <svg class="h-3.5 w-3.5 shrink-0 text-[#8A40F5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 18l6-6-6-6" />
        </svg>
        <span class="font-medium text-[#1A0533] sm:hidden">AI Sprint</span>
        <span class="hidden font-medium text-[#1A0533] sm:inline">Agentic AI Engineering Sprint</span>
      </nav>

      <div class="grid grid-cols-1 gap-12 xl:gap-16 lg:grid-cols-[1fr_380px] lg:items-start">
        <div>
          <span class="mb-5 inline-block rounded-full bg-[#8A40F5]/10 px-4 py-1.5 text-sm font-bold text-[#8A40F5]">
            Six-week live engineering sprint
          </span>

          <h1 class="mb-5 text-3xl font-extrabold leading-tight text-[#1A0533] md:text-4xl">
            Build and Ship Agentic AI Applications in 6 Weeks
          </h1>

          <p class="mb-6 max-w-3xl text-lg leading-relaxed text-gray-700">
            A practical sprint for developers who already know basic Python and want to build AI systems that can use tools,
            retrieve knowledge, follow workflows, and show proof of quality.
          </p>

          <ul class="mb-8 space-y-2.5 text-lg">
            {[
              'Build tool-using assistants with Python, LangChain, and model APIs',
              'Create LangGraph workflows with state, routing, and human approval',
              'Ship RAG and vectorless retrieval systems with cited answers',
              'Add guardrails, tracing, evaluations, and a portfolio-ready capstone',
            ].map((item) => (
              <li class="flex items-start gap-3 text-gray-700">
                <svg class="mt-0.5 h-5 w-5 shrink-0 text-[#8A40F5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={checkIcon} />
                </svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <div class="mb-8 flex flex-wrap gap-3">
            {[
              { icon: calendarIcon, label: '6-week live cohort' },
              { icon: clockIcon, label: '4 hours/week' },
              { icon: usersIcon, label: '20 learners max' },
            ].map(({ icon, label }) => (
              <span class="inline-flex items-center gap-2 rounded-full bg-[#F5F2EB] px-4 py-2 text-base font-medium text-[#1A0533]">
                <svg class="h-4.5 w-4.5 text-[#8A40F5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={icon} />
                </svg>
                {label}
              </span>
            ))}
          </div>

          <div class="hidden border-t border-gray-100 pt-6">
            <p class="mb-4 text-xs font-semibold uppercase tracking-widest text-gray-400">Instructor</p>
            <div class="flex items-center gap-4">
              <div class="flex h-18 w-18 shrink-0 items-center justify-center rounded-full bg-[#8A40F5]/10 text-[#8A40F5]">
                <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={codeIcon} />
                </svg>
              </div>
              <div>
                <p class="text-lg font-semibold text-[#1A0533]">Practising software developer</p>
                <p class="text-base text-gray-500">Python applications, AI integrations, and live code review.</p>
              </div>
            </div>
          </div>
        </div>

        <aside class="lg:sticky lg:top-6">
          <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-lg">
            <div class="relative aspect-video overflow-hidden bg-[#F5F2EB]">
              <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_18%,rgba(138,64,245,0.24),transparent_30%),linear-gradient(135deg,#FBFAF7_0%,#F5F2EB_58%,#ECE5FA_100%)]"></div>
              <div class="absolute left-5 top-5 z-10 rounded-xl bg-white/92 px-4 py-3 shadow-md backdrop-blur">
                <p class="text-xs font-extrabold uppercase tracking-widest text-gray-500">Capstone</p>
                <p class="mt-1 text-sm font-extrabold text-[#1A0533]">AI Support Ops Agent</p>
              </div>
              <img
                src="/images/ai-robot-2.png"
                alt="Humanoid AI robot representing the sprint's agentic AI systems"
                class="absolute bottom-[-26px] right-1 h-[118%] w-auto object-contain drop-shadow-xl"
                loading="eager"
                fetchpriority="high"
              />
            </div>

            <div class="space-y-4 p-6">
              <div class="flex flex-wrap items-baseline gap-3">
                <span class="text-3xl font-extrabold text-[#1A0533]">&#8358;25,000</span>
                <span class="text-xl font-bold text-gray-400 line-through">&#8358;30,000</span>
                <span class="text-base text-gray-400">Live Cohort</span>
              </div>

              {heroStats.map((stat) => (
                <div class="flex items-center gap-2 text-lg text-gray-600">
                  <svg class="h-6 w-6 text-[#8A40F5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d={stat.icon} />
                  </svg>
                  <span>{stat.value} - {stat.label}</span>
                </div>
              ))}

              <a
                id="enroll"
                href="#registration"
                class="mt-8 block w-full rounded-lg bg-[#8A40F5] px-8 py-4 text-center text-base font-semibold text-white transition-colors duration-200 hover:bg-[#7434D8]"
              >
                Join the next cohort
              </a>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <section class="py-14 md:py-18">
      <div class="mx-auto max-w-7xl px-6 md:px-12 lg:px-16 xl:px-24">
        <div class="grid gap-8 lg:grid-cols-[0.72fr_1.28fr] lg:items-start">
          <div>
            <p class="text-xs font-extrabold uppercase tracking-widest text-[#8A40F5]">What you build</p>
            <h2 class="mt-3 text-3xl font-extrabold leading-tight md:text-4xl">Less reading. More shipped systems.</h2>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            {outcomes.map((item) => (
              <article class="rounded-lg border border-[#1A0533]/8 bg-white p-5 shadow-sm">
                <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-lg bg-[#8A40F5]/10 text-[#8A40F5]">
                  <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d={item.icon} />
                  </svg>
                </div>
                <h3 class="text-lg font-extrabold">{item.title}</h3>
                <p class="mt-2 leading-7 text-gray-600">{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="projects" class="scroll-mt-28 bg-white py-14 md:py-18">
      <div class="mx-auto max-w-7xl px-6 md:px-12 lg:px-16 xl:px-24">
        <div class="mb-8 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="text-xs font-extrabold uppercase tracking-widest text-[#8A40F5]">Project track</p>
            <h2 class="mt-3 text-3xl font-extrabold leading-tight md:text-4xl">Six builds, one capstone.</h2>
          </div>
          <div class="flex flex-wrap gap-2">
            {stack.map((item) => (
              <span class="rounded-lg bg-[#F5F2EB] px-3 py-2 text-sm font-bold text-[#1A0533]">{item}</span>
            ))}
          </div>
        </div>

        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {projects.map((project, index) => (
            <article class="group rounded-lg border border-gray-200 bg-[#F5F2EB] p-5 transition-transform duration-200 hover:-translate-y-1">
              <div class="flex items-start justify-between gap-4">
                <span class="text-sm font-extrabold text-gray-400">0{index + 1}</span>
                <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-white text-[#8A40F5] shadow-sm">
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d={project.icon} />
                  </svg>
                </span>
              </div>
              <h3 class="mt-8 text-xl font-extrabold">{project.title}</h3>
              <p class="mt-2 text-gray-600">{project.build}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="curriculum" class="scroll-mt-28 py-14 md:py-18">
      <div class="mx-auto max-w-7xl px-6 md:px-12 lg:px-16 xl:px-24">
        <div class="mb-8 max-w-2xl">
          <p class="text-xs font-extrabold uppercase tracking-widest text-[#8A40F5]">Curriculum</p>
          <h2 class="mt-3 text-3xl font-extrabold leading-tight md:text-4xl">A week-by-week path you can scan.</h2>
        </div>

        <div class="grid gap-3">
          {weeks.map((week) => (
            <article class="grid gap-4 rounded-lg border border-[#1A0533]/8 bg-white p-4 shadow-sm md:grid-cols-[92px_1fr_auto] md:items-center md:p-5">
              <span class="flex h-12 w-16 items-center justify-center rounded-lg bg-[#1A0533] text-sm font-extrabold text-white md:w-16">
                {week.label}
              </span>
              <div>
                <h3 class="text-lg font-extrabold md:text-xl">{week.title}</h3>
                <p class="mt-1 text-gray-600">Build: {week.build}</p>
              </div>
              <svg class="hidden h-5 w-5 text-[#8A40F5] md:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 5l7 7-7 7" />
              </svg>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="registration" class="scroll-mt-28 bg-[#1A0533] py-14 text-white md:py-18">
      <div class="mx-auto grid max-w-7xl gap-10 px-6 md:px-12 lg:grid-cols-[0.88fr_520px] lg:px-16 xl:px-24">
        <div>
          <p class="text-xs font-extrabold uppercase tracking-widest text-[#B98BFF]">Cohort tuition</p>
          <div class="mt-4 flex flex-wrap items-end gap-4">
            <span class="text-5xl font-extrabold leading-none md:text-6xl">&#8358;25,000</span>
            <span class="pb-2 text-2xl font-bold text-white/35 line-through">&#8358;30,000</span>
          </div>
          <p class="mt-5 max-w-xl text-xl font-semibold text-white">Pay for momentum, feedback, and a finished capstone.</p>

          <div class="mt-8 grid gap-3 sm:grid-cols-2">
            {tuitionIncludes.map((item) => (
              <div class="flex items-center gap-3 rounded-lg border border-white/10 bg-white/[0.06] p-4 font-semibold text-white/88">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white/10 text-[#B98BFF]">
                  <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d={item.icon} />
                  </svg>
                </span>
                {item.text}
              </div>
            ))}
          </div>
        </div>

        <div class="rounded-lg border border-white/10 bg-white/[0.07] p-6 shadow-2xl shadow-[#8A40F5]/15 md:p-8">
          <h3 class="text-2xl font-extrabold leading-tight md:text-3xl">Join the next cohort</h3>
          <p class="mt-3 leading-7 text-white/70">Drop your details. We will send payment and onboarding instructions.</p>

          <div id="course-register-success" class="mt-6 hidden rounded-lg border border-[#8A40F5]/30 bg-[#8A40F5]/15 p-5 text-white">
            Thanks. We have your details and will follow up with next steps.
          </div>

          <form
            id="course-register-form"
            class="mt-6 space-y-4"
          >
            <div>
              <label for="course-name" class="sr-only">Full name</label>
              <input id="course-name" name="name" type="text" required placeholder="Full name" class="w-full rounded-lg border border-white/10 bg-white/10 px-5 py-4 text-white placeholder-white/45 focus:border-[#8A40F5] focus:outline-none focus:ring-2 focus:ring-[#8A40F5]" />
            </div>
            <div>
              <label for="course-email" class="sr-only">Email address</label>
              <input id="course-email" name="email" type="email" required placeholder="Email address" class="w-full rounded-lg border border-white/10 bg-white/10 px-5 py-4 text-white placeholder-white/45 focus:border-[#8A40F5] focus:outline-none focus:ring-2 focus:ring-[#8A40F5]" />
            </div>
            <div>
              <label for="course-whatsapp" class="sr-only">WhatsApp number</label>
              <input id="course-whatsapp" name="whatsapp" type="tel" required placeholder="WhatsApp number" class="w-full rounded-lg border border-white/10 bg-white/10 px-5 py-4 text-white placeholder-white/45 focus:border-[#8A40F5] focus:outline-none focus:ring-2 focus:ring-[#8A40F5]" />
            </div>
            <div>
              <label for="course-experience" class="sr-only">Python background</label>
              <select id="course-experience" name="pythonExperience" required class="w-full rounded-lg border border-white/10 bg-[#2A0C4F] px-5 py-4 text-white focus:border-[#8A40F5] focus:outline-none focus:ring-2 focus:ring-[#8A40F5]">
                <option value="">Python background</option>
                <option value="I understand basic Python">I understand basic Python</option>
                <option value="I am a backend/software developer">I am a backend/software developer</option>
                <option value="I am a data or ML practitioner">I am a data or ML practitioner</option>
                <option value="I am not sure I meet the prerequisite">I am not sure I meet the prerequisite</option>
              </select>
            </div>
            <button id="course-register-submit" type="submit" class="w-full cursor-pointer rounded-lg bg-[#8A40F5] py-4 text-base font-extrabold text-white transition-colors duration-200 hover:bg-[#7434D8] focus:outline-none focus:ring-2 focus:ring-[#8A40F5] focus:ring-offset-2 focus:ring-offset-[#1A0533]">
              Join the next cohort
            </button>
            <p id="course-register-error" class="hidden text-center text-sm text-red-300">
              We couldn&rsquo;t capture your application. Please check your details and try again.
            </p>
          </form>
        </div>
      </div>
    </section>

    <section class="bg-white py-14 md:py-18">
      <div class="mx-auto max-w-7xl px-6 md:px-12 lg:px-16 xl:px-24">
        <div class="mb-8 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="text-xs font-extrabold uppercase tracking-widest text-[#8A40F5]">FAQ</p>
            <h2 class="mt-3 text-3xl font-extrabold leading-tight md:text-4xl">Short answers. Promise.</h2>
          </div>
          <a href="#registration" class="inline-flex items-center gap-2 text-base font-extrabold text-[#8A40F5] hover:text-[#7434D8]">
            Enroll
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 5l7 7-7 7" />
            </svg>
          </a>
        </div>

        <div class="grid gap-4 md:grid-cols-2">
          {faqs.map(({ q, a }) => (
            <article class="rounded-lg border border-gray-200 bg-[#F5F2EB] p-5">
              <h3 class="text-lg font-extrabold">{q}</h3>
              <p class="mt-2 leading-7 text-gray-600">{a}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  @media (prefers-reduced-motion: reduce) {
    a,
    button,
    article {
      transition: none !important;
    }
  }
</style>

<script>
  import PocketBase from 'pocketbase';

  function initCourseRegistration() {
    const form = document.getElementById('course-register-form') as HTMLFormElement | null;
    const success = document.getElementById('course-register-success');
    const error = document.getElementById('course-register-error');
    const submit = document.getElementById('course-register-submit') as HTMLButtonElement | null;
    if (!form || !success || !error || !submit) return;

    const pb = new PocketBase(import.meta.env.PUBLIC_POCKETBASE_URL);

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      error.classList.add('hidden');

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const formData = new FormData(form);
      submit.disabled = true;
      submit.textContent = 'Submitting...';

      try {
        await pb.collection('Join_The_Next_Cohort').create({
          Full_Name: formData.get('name') as string,
          Email: formData.get('email') as string,
          WhatsApp_Number: formData.get('whatsapp') as string,
          Python_Background: formData.get('pythonExperience') as string,
        });

        window.posthog?.capture('course_registration_interest_submitted', {
          course: 'agentic-ai-engineering-sprint',
          cohort: 'next-cohort',
        });

        form.classList.add('hidden');
        success.classList.remove('hidden');
      } catch (err) {
        window.posthog?.captureException?.(err);
        error.classList.remove('hidden');
        submit.disabled = false;
        submit.textContent = 'Join the next cohort';
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCourseRegistration);
  } else {
    initCourseRegistration();
  }
</script>
