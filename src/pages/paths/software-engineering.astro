---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Software Engineering Path | UniversityX" description="UniversityX Software Engineering programmes are being developed. Join the programme waitlist for updates.">
  <Navbar />
  <main class="bg-white text-[#1A0533]">
    <section class="bg-[#F5F2EB] py-20 md:py-28">
      <div class="mx-auto max-w-5xl px-6 md:px-12">
        <nav class="mb-8 flex items-center gap-2 text-sm text-gray-500"><a href="/#career-paths" class="hover:text-[#8A40F5]">Career Paths</a><span>→</span><span class="font-semibold text-[#1A0533]">Software Engineering</span></nav>
        <span class="inline-flex rounded-full bg-[#1A0533]/10 px-4 py-2 text-xs font-bold uppercase tracking-widest text-[#1A0533]/60">In development</span>
        <h1 class="mt-6 text-5xl font-extrabold leading-tight tracking-tight md:text-6xl">Software Engineering</h1>
        <p class="mt-6 max-w-3xl text-xl leading-8 text-gray-600">We’re developing practical Software Engineering programmes focused on strong foundations, real projects, and credible proof of skill.</p>
        <div class="mt-9 flex flex-wrap gap-4">
          <a href="/#programme-waitlist" class="rounded-full bg-[#8A40F5] px-7 py-3.5 font-bold text-white hover:bg-[#7434D8]">Get programme updates</a>
          <a href="/paths/ai-data-science/" class="rounded-full border border-[#1A0533]/15 px-7 py-3.5 font-bold hover:border-[#8A40F5] hover:text-[#8A40F5]">Explore AI &amp; Data Science</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
