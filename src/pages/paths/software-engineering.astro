---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const courseHref = '/paths/software-engineering/build-your-first-ai-application';

const audience = [
  'Self-taught developers',
  'Early-career software developers',
  'Bootcamp graduates who need stronger practical depth',
  'Developers who use AI but cannot yet rely on a consistent engineering workflow',
];

const courses = [
  {
    number: '01',
    title: 'Build and Ship Agentic AI Applications in 6 Weeks',
    status: 'Registration Open',
    meta: '6 weeks · Starts 17 August 2026',
    originalPrice: '₦30,000',
    price: '₦25,000',
    href: courseHref,
  },
  { number: '02', title: 'AI Engineering Deep Dive', status: 'Coming Soon', meta: 'RAG · Embeddings · Evaluation' },
  { number: '03', title: 'Full-Stack AI Development', status: 'Coming Soon' },
  { number: '04', title: 'Agent Orchestration and Production', status: 'Coming Soon' },
  { number: '05', title: 'System Design for AI Systems', status: 'Coming Soon' },
];
---

<Layout
  title="AI-Native Software Engineering Path | UniversityX"
  description="Build real software with AI while developing the technical depth to own intent, architecture and verification."
>
  <Navbar />

  <main class="bg-white">
    <section class="max-w-7xl mx-auto px-6 md:px-12 lg:px-16 xl:px-24 pt-10 pb-16">
      <nav class="flex items-center gap-2 text-sm text-gray-500 mb-8" aria-label="Breadcrumb">
        <a href="/#career-paths" class="hover:text-[#8A40F5] transition-colors">Career Paths</a>
        <svg class="w-3.5 h-3.5 text-[#8A40F5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 18l6-6-6-6" />
        </svg>
        <span class="text-[#1A0533] font-medium">Software Engineering</span>
      </nav>

      <div class="max-w-4xl">
        <span class="inline-block text-[#8A40F5] text-sm font-bold bg-[#8A40F5]/10 rounded-full px-4 py-1.5 mb-5">UniversityX Career Path</span>
        <h1 class="text-4xl md:text-6xl font-extrabold text-[#1A0533] leading-tight mb-5">
          AI-Native Software Engineering
        </h1>
        <p class="text-lg md:text-xl text-gray-700 leading-relaxed mb-8">
          Learn to command AI systems to build production software while you remain responsible for what should be built, how it is structured and whether it works.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href={courseHref} class="inline-flex items-center justify-center rounded-full bg-[#8A40F5] text-white font-semibold px-7 py-3.5 hover:bg-[#7434D8] transition-colors focus:outline-none focus:ring-2 focus:ring-[#8A40F5] focus:ring-offset-2">
            Join the 17 August Cohort
          </a>
          <a href="#course-path" class="inline-flex items-center justify-center rounded-full border border-[#1A0533]/20 text-[#1A0533] font-semibold px-7 py-3.5 hover:border-[#8A40F5] hover:text-[#8A40F5] transition-colors focus:outline-none focus:ring-2 focus:ring-[#8A40F5]">
            Explore the Course Path
          </a>
        </div>
      </div>
    </section>

    <section class="bg-[#F5F2EB] py-16 md:py-20">
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-16 xl:px-24 grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16">
        <h2 class="text-3xl md:text-4xl font-extrabold text-[#1A0533] leading-tight">
          Build with AI. Understand what you build.
        </h2>
        <p class="text-lg md:text-xl text-gray-700 leading-relaxed">
          Using AI to generate code is now common. The harder skill is knowing what to ask for, recognising when the result is weak and verifying that the system is reliable. This path develops both AI fluency and engineering judgement.
        </p>
      </div>
    </section>

    <section class="py-16 md:py-20">
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-16 xl:px-24">
        <div class="max-w-3xl mb-10">
          <p class="text-xs font-semibold text-[#8A40F5] uppercase tracking-widest mb-3">Audience</p>
          <h2 class="text-3xl md:text-4xl font-extrabold text-[#1A0533] mb-4">Who this path is for</h2>
          <p class="text-lg text-gray-700 leading-relaxed">
            This path is for intermediate or already-learning developers who understand basic programming and want to go deeper without restarting from zero.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {audience.map((item) => (
            <div class="bg-[#F5F2EB] rounded-2xl p-5 text-[#1A0533] font-semibold">{item}</div>
          ))}
        </div>
        <p class="mt-6 text-[#1A0533] font-bold">Basic JavaScript or Python is required.</p>
      </div>
    </section>

    <section id="course-path" class="scroll-mt-28 bg-[#F5F2EB] py-16 md:py-20">
      <div class="max-w-6xl mx-auto px-6 md:px-12 lg:px-16 xl:px-24">
        <p class="text-xs font-semibold text-[#8A40F5] uppercase tracking-widest mb-3">Course path</p>
        <h2 class="text-3xl md:text-4xl font-extrabold text-[#1A0533] mb-10">Course sequence</h2>

        <div class="space-y-4">
          {courses.map((course) => {
            const row = (
              <div class={`rounded-2xl border p-6 md:p-7 ${course.href ? 'border-[#8A40F5] bg-white' : 'border-[#1A0533]/10 bg-[#FDFCF8]'}`}>
                <div class="flex flex-col md:flex-row md:items-start gap-4 md:gap-8">
                  <span class={`text-4xl font-extrabold leading-none ${course.href ? 'text-[#8A40F5]/40' : 'text-[#1A0533]/20'}`}>{course.number}</span>
                  <div class="flex-1">
                    <div class="flex flex-wrap items-center gap-3 mb-2">
                      <h3 class="text-xl md:text-2xl font-bold text-[#1A0533]">{course.title}</h3>
                      <span class={`rounded-full px-3 py-1 text-xs font-semibold ${course.href ? 'bg-[#8A40F5] text-white' : 'bg-[#1A0533]/10 text-[#1A0533]/55'}`}>{course.status}</span>
                    </div>
                    {course.meta && (
                      <div class="flex flex-wrap items-center gap-2 text-gray-500 text-base md:text-lg">
                        <span>{course.meta}</span>
                        {course.originalPrice && (
                          <>
                            <span>·</span>
                            <span class="font-semibold text-[#1A0533]">{course.price}</span>
                            <span class="text-gray-400 line-through">{course.originalPrice}</span>
                          </>
                        )}
                      </div>
                    )}
                  </div>
                </div>
              </div>
            );

            return course.href ? (
              <a href={course.href} class="block focus:outline-none focus:ring-2 focus:ring-[#8A40F5] rounded-2xl">{row}</a>
            ) : row;
          })}
        </div>
      </div>
    </section>

    <section class="py-16 md:py-20">
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-16 xl:px-24">
        <h2 class="text-3xl md:text-4xl font-extrabold text-[#1A0533] mb-8">What the path is designed to unlock</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <article class="bg-[#F5F2EB] rounded-2xl p-7">
            <p class="text-xs font-semibold text-[#8A40F5] uppercase tracking-widest mb-3">After Course 01</p>
            <p class="text-lg text-gray-700 leading-relaxed">
              A strong AI-powered project, better readiness for internship applications and the ability to take on suitable freelance micro-projects.
            </p>
          </article>
          <article class="bg-[#F5F2EB] rounded-2xl p-7">
            <p class="text-xs font-semibold text-[#8A40F5] uppercase tracking-widest mb-3">After the complete path</p>
            <p class="text-lg text-gray-700 leading-relaxed">
              Deeper production engineering ability and stronger competitiveness for AI-native software roles.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="bg-[#1A0533] py-16 md:py-20 text-center">
      <div class="max-w-3xl mx-auto px-6">
        <h2 class="text-3xl md:text-4xl font-extrabold text-white mb-4">Start with Course 01.</h2>
        <p class="text-white/60 text-lg mb-8">Build a real AI-powered application, then decide how far you want to take the path.</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href={courseHref} class="inline-flex items-center justify-center rounded-full bg-[#8A40F5] text-white font-semibold px-7 py-3.5 hover:bg-[#7434D8] transition-colors">
            Join the 17 August Cohort
          </a>
          <a href="/#programme-waitlist" class="inline-flex items-center justify-center rounded-full border border-white/20 text-white font-semibold px-7 py-3.5 hover:border-white/50 transition-colors">
            Explore other programs
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
