---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { AI_COHORT_PATH, aiCohort, formatNaira } from '../../data/aiCohort';
---

<Layout title="AI & Data Science Learning Path | UniversityX" description="Build practical AI applications and create proof of what you can do through UniversityX AI & Data Science programmes.">
  <Navbar />
  <main class="bg-white text-[#1A0533]">
    <section class="bg-[#F5F2EB] py-16 md:py-24">
      <div class="mx-auto max-w-7xl px-6 md:px-12 lg:px-16 xl:px-24">
        <p class="text-xs font-extrabold uppercase tracking-widest text-[#8A40F5]">UniversityX learning path</p>
        <h1 class="mt-5 max-w-4xl text-5xl font-extrabold leading-tight tracking-tight md:text-6xl">AI &amp; Data Science</h1>
        <p class="mt-6 max-w-3xl text-xl leading-8 text-gray-600">Learn to turn models, data, and software into useful systems—and build evidence that you can apply the skill.</p>
      </div>
    </section>

    <section class="py-16 md:py-24">
      <div class="mx-auto max-w-7xl px-6 md:px-12 lg:px-16 xl:px-24">
        <div class="max-w-3xl"><p class="text-xs font-extrabold uppercase tracking-widest text-[#8A40F5]">Active track</p><h2 class="mt-3 text-3xl font-extrabold md:text-4xl">AI Engineering</h2><p class="mt-4 text-lg leading-8 text-gray-600">Build applications that work with your data, use tools, follow workflows, and behave reliably.</p></div>
        <a href="/paths/ai-data-science/ai-engineering/" class="mt-9 grid gap-6 rounded-3xl border border-[#8A40F5]/25 bg-[#F8F4FF] p-7 transition hover:-translate-y-0.5 hover:border-[#8A40F5] md:grid-cols-[1fr_auto] md:items-center md:p-9">
          <div><span class="rounded-full bg-[#8A40F5] px-3 py-1 text-xs font-bold text-white">Now enrolling</span><h3 class="mt-5 text-2xl font-extrabold">Build and Ship AI Applications with Python</h3><p class="mt-3 leading-7 text-gray-600">{aiCohort.durationWeeks} weeks · Starts {aiCohort.startDateLabel} · From {formatNaira(aiCohort.fullPaymentPrice)}</p></div>
          <span class="font-extrabold text-[#8A40F5]">View AI Engineering →</span>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
