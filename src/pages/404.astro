---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Page Not Found — UniversityX"
  description="The page you're looking for doesn't exist."
>
  <Navbar />

  <section class="bg-white pt-10 pb-20 md:pt-10 md:pb-20">
    <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-16 xl:px-24 text-center">

      <p class="text-[#8A40F5] font-semibold text-lg mb-4">404 - Page Not Found</p>

      <h1 class="text-4xl md:text-6xl font-extrabold text-[#1A0533] leading-tight mb-6">
        Looks like this page<br />
        <em class="font-['Playfair_Display',serif] font-bold">took the day off.</em>
      </h1>

      <p class="text-lg md:text-xl text-gray-500 max-w-lg mx-auto leading-relaxed mb-12">
        The page you're looking for doesn't exist or may have been moved. Let's get you back on track.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/"
          class="bg-[#8A40F5] hover:bg-[#7434D8] text-white font-semibold px-8 py-3.5 rounded-full transition-colors duration-200 text-base"
        >
          Back to Homepage
        </a>
        <a
          href="/#browse-courses"
          class="border-2 border-[#1A0533] text-[#1A0533] hover:bg-[#1A0533] hover:text-white font-semibold px-8 py-3.5 rounded-full transition-colors duration-200 text-base"
        >
          Browse Courses
        </a>
      </div>

    </div>
  </section>

  <Footer />
</Layout>
