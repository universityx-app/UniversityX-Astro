---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import OneToOneInquiryForm from '../components/OneToOneInquiryForm.astro';
---

<Layout title="Learn 1-on-1 with an Instructor | UniversityX" description="Tell UniversityX what you want to learn and get a personalised instructor and session recommendation.">
  <Navbar />
  <main class="bg-[#F5F2EB] text-[#1A0533]">
    <section class="mx-auto grid min-h-[75vh] max-w-7xl items-start gap-12 px-6 py-12 md:px-12 md:py-18 lg:grid-cols-[.8fr_1.2fr] lg:px-16 xl:px-24">
      <div class="lg:sticky lg:top-8">
        <p class="text-sm font-bold uppercase tracking-widest text-[#8A40F5]">Learn 1-on-1</p>
        <h1 class="mt-3 text-4xl font-extrabold leading-tight md:text-5xl">Get support shaped around what you want to learn.</h1>
        <p class="mt-6 text-lg leading-8 text-gray-600">Tell us the skill you want to build, what you need help with, and your estimated budget. We’ll recommend the right instructor, number of sessions, and learning plan.</p>
        <div class="mt-8 border-t border-[#1A0533]/10 pt-8">
          <p class="font-bold">One request, the right recommendation.</p>
          <p class="mt-2 leading-7 text-gray-600">There is no payment or booking today. We’ll review your request and contact you with suitable next steps.</p>
        </div>
      </div>
      <OneToOneInquiryForm />
    </section>
  </main>
  <Footer />
</Layout>
