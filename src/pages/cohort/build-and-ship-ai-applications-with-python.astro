---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import {
  AI_COHORT_PATH,
  aiCohort,
  formatNaira,
  paystackPaymentPages,
} from '../../data/aiCohort';

const painPoints = [
  {
    title: '“I can call an AI API, but I don’t know what to build next.”',
    body: 'Move from a model response to a useful application with data, logic, tools, and a workflow someone can actually use.',
    icon: 'M12 2v4m0 12v4M4.93 4.93l2.83 2.83m8.48 8.48 2.83 2.83M2 12h4m12 0h4M4.93 19.07l2.83-2.83m8.48-8.48 2.83-2.83',
  },
  {
    title: '“RAG and agents still feel abstract.”',
    body: 'Make the ideas concrete by building AI that answers from documents, uses APIs, searches for information, and completes tasks step by step.',
    icon: 'M4 19.5A2.5 2.5 0 0 1 6.5 17H20M4 4.5A2.5 2.5 0 0 1 6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15Z',
  },
  {
    title: '“I want proof that I can actually do this.”',
    body: 'Build weekly projects and finish with a deployed capstone you can show at work, in interviews, or when speaking with a client.',
    icon: 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8ZM14 2v6h6M9 15l2 2 4-4',
  },
];

const capabilities = [
  { label: 'Your data', detail: 'PDFs, policies, reports, private knowledge', icon: 'M4 4h16v16H4zM8 8h8M8 12h8M8 16h5' },
  { label: 'Useful actions', detail: 'APIs, search, databases, external services', icon: 'M12 2v6m0 8v6M4.93 4.93l4.24 4.24m5.66 5.66 4.24 4.24M2 12h6m8 0h6M4.93 19.07l4.24-4.24m5.66-5.66 4.24-4.24' },
  { label: 'Multi-step work', detail: 'Routing, memory, decisions, human approval', icon: 'M4 6h6v6h4v6h6M7 3 4 6l3 3m10 6 3 3-3 3' },
  { label: 'Reliable output', detail: 'Evaluation, guardrails, tracing, recovery', icon: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Zm-3-10 2 2 4-4' },
];

const weeks = [
  {
    number: '01',
    title: 'Build your first useful AI application',
    description: 'Connect Python to an AI model, ask for structured responses, and turn a model call into a small working product.',
    ship: 'A working Python AI application',
    tags: ['Python', 'LLM APIs', 'Structured output'],
  },
  {
    number: '02',
    title: 'Build AI that answers from your own files',
    description: 'Give your application PDFs, policies, notes, or internal documents and make it answer from that material with sources.',
    ship: 'A document assistant with cited answers',
    tags: ['Retrieval', 'RAG', 'Citations'],
  },
  {
    number: '03',
    title: 'Build AI that can actually do things',
    description: 'Connect search, APIs, databases, or other services so your application can fetch information and take useful actions.',
    ship: 'A tool-using AI workflow',
    tags: ['Tool calling', 'APIs', 'Structured data'],
  },
  {
    number: '04',
    title: 'Build AI that handles a task step by step',
    description: 'Create a workflow that chooses what happens next, keeps useful state, and asks for human approval when it matters.',
    ship: 'A multi-step AI agent',
    tags: ['LangGraph', 'Routing', 'Memory'],
  },
  {
    number: '05',
    title: 'Make your AI app something people can trust',
    description: 'Handle weak responses and failures, inspect what happened, and test whether your application behaves as expected.',
    ship: 'A reliable, evaluated application',
    tags: ['Guardrails', 'Tracing', 'Evals'],
  },
  {
    number: '06',
    title: 'Put your AI application online',
    description: 'Finish your capstone, deploy it, document the decisions you made, and prepare a clear demo of what it can do.',
    ship: 'Your portfolio-ready capstone',
    tags: ['Deployment', 'Documentation', 'Demo'],
  },
];

const projects = [
  {
    title: 'AI Research Assistant',
    tag: 'Own data + citations',
    description: 'Upload reports or internal documents and build an assistant that answers questions and points back to the source.',
    accent: 'purple',
  },
  {
    title: 'Customer Support Assistant',
    tag: 'Knowledge + tools',
    description: 'Answer from company knowledge, check customer information, and hand difficult cases to a human.',
    accent: 'green',
  },
  {
    title: 'Recruitment Assistant',
    tag: 'Workflow + evaluation',
    description: 'Read CVs or job descriptions, retrieve relevant details, and help a recruiter organise a review workflow.',
    accent: 'orange',
  },
];

const realWorldUses = [
  { title: 'At work', body: 'Build internal tools, document assistants, support workflows, and AI-powered features your team can use.', icon: 'M3 21h18M6 21V7l6-4 6 4v14M9 10h.01M15 10h.01M9 14h.01M15 14h.01' },
  { title: 'As a freelancer', body: 'Offer assistants, knowledge systems, workflow automation, and custom AI features to clients.', icon: 'M9 6V4h6v2m5 4H4a2 2 0 0 0-2 2v6h20v-6a2 2 0 0 0-2-2Zm-8 4 9 4 9-4' },
  { title: 'For your product', body: 'Add AI to an existing product or use these skills to prototype and launch a new one.', icon: 'M12 2c3 2 5 5 5 9l3 3-4 1-1 4-3-3-3 3-1-4-4-1 3-3c0-4 2-7 5-9Z' },
  { title: 'For your career', body: 'Build stronger portfolio proof and speak confidently about AI application development in interviews.', icon: 'M20 7h-4V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2H4a2 2 0 0 0-2 2v10h20V9a2 2 0 0 0-2-2ZM10 7V5h4v2' },
];

const included = [
  ['Live classes', 'Learn with the instructor and ask questions in context.'],
  ['Weekly builds', 'Turn every new capability into working code.'],
  ['Project feedback', 'Get practical reviews and corrections on your work.'],
  ['AI learning support', 'Use guided assistance while you build and get unstuck.'],
  ['Session recordings', 'Revisit classes and catch up when necessary.'],
  ['Cohort community', 'Share progress and build alongside other developers.'],
  ['Demo Day', 'Present your capstone and explain your technical choices.'],
  ['Certificate', 'Earn recognition after meeting the completion requirements.'],
];

const forYou = [
  'You already understand basic Python.',
  'You want to build with documents, tools, and AI agents.',
  'You learn best by making projects, not only watching videos.',
  'You want deadlines, feedback, and a clear path to follow.',
  'You want a project you can confidently show after six weeks.',
];

const notForYou = [
  'You have never written Python before.',
  'You want a no-code or prompt-only programme.',
  'You want to train machine-learning models from scratch.',
  'You cannot make time for the weekly builds.',
];

const faqs = [
  ['Is this for complete beginners?', 'Not quite. You should already know basic Python. You do not need previous AI or machine-learning experience.'],
  ['Will I build real projects?', 'Yes. You will build throughout the cohort and finish with a deployed capstone that combines the core skills covered in the six weeks.'],
  ['Do I need machine-learning knowledge?', 'No. This cohort is about building applications with existing AI models, not training models from scratch.'],
  ['Can I pay in installments?', `Yes. Pay ${formatNaira(aiCohort.installmentAmount)} now and ${formatNaira(aiCohort.installmentAmount)} later. The installment total is ${formatNaira(aiCohort.installmentTotal)}.`],
  ['Why is paying in full cheaper?', `Paying ${formatNaira(aiCohort.fullPaymentPrice)} in full saves ${formatNaira(aiCohort.fullPaymentSaving)} compared with the installment total.`],
  ['What if I miss a live class?', 'Classes are recorded so you can catch up, but you will still be expected to complete that week’s practical build.'],
  ['What will I have at the end?', 'Multiple practical builds, a deployed capstone, a documented repository, feedback, and stronger proof that you can build AI applications.'],
];

const fullPaymentAvailable = Boolean(paystackPaymentPages.full);
const installmentAvailable = Boolean(paystackPaymentPages.installment);
const anyPaymentAvailable = fullPaymentAvailable || installmentAvailable;
---

<Layout
  title={`${aiCohort.title} | UniversityX`}
  description="Go from watching AI tutorials to building useful AI applications with Python, your own data, tools, multi-step workflows, evaluation, and a deployed capstone."
>
  <Navbar />

  <main class="overflow-x-hidden bg-white text-[#1A0533]">
    <header class="relative overflow-hidden pb-20 pt-10 md:pb-28">
      <div class="hero-grid-pattern absolute inset-0 opacity-60" aria-hidden="true"></div>
      <div class="absolute -left-32 top-24 h-80 w-80 rounded-full bg-[#8A40F5]/12 blur-3xl" aria-hidden="true"></div>
      <div class="absolute -right-24 top-0 h-72 w-72 rounded-full bg-[#B98BFF]/20 blur-3xl" aria-hidden="true"></div>

      <div class="relative mx-auto max-w-7xl px-6 md:px-12 lg:px-16 xl:px-24">
        <nav class="mb-10 flex items-center gap-2 overflow-x-auto whitespace-nowrap text-sm text-gray-500" aria-label="Breadcrumb">
          <a href="/" class="transition-colors hover:text-[#8A40F5]">Home</a>
          <span class="text-[#8A40F5]" aria-hidden="true">→</span>
          <a href="/cohorts/" class="transition-colors hover:text-[#8A40F5]">Cohorts</a>
          <span class="text-[#8A40F5]" aria-hidden="true">→</span>
          <span class="font-semibold text-[#1A0533]">Build and Ship AI Applications with Python</span>
        </nav>

        <div class="grid items-start gap-12 lg:grid-cols-[1fr_390px] xl:gap-16">
          <div class="max-w-4xl">
            <div class="inline-flex items-center gap-2 rounded-full border border-[#8A40F5]/20 bg-[#F8F4FF] px-4 py-2 text-sm font-bold text-[#8A40F5]">
              <span class="h-2 w-2 rounded-full bg-[#8A40F5]"></span>
              {aiCohort.durationWeeks}-week live cohort · {aiCohort.capacity} builders maximum
            </div>

            <h1 class="mt-7 text-[2.65rem] font-extrabold leading-[0.98] tracking-[-0.045em] md:text-7xl">
              Go from <span class="mt-2 block font-['Playfair_Display',serif] italic text-[#8A40F5] xl:mt-0 xl:inline">“I’ve watched the tutorials”</span>
              <span class="mt-3 block text-2xl font-bold tracking-[-0.02em] text-gray-400 md:text-3xl">to</span>
              <span class="mt-2 block">“I can build real AI applications.”</span>
            </h1>

            <p class="mt-7 max-w-3xl text-lg leading-8 text-gray-600 md:text-xl">
              In six weeks, learn to build AI applications that answer from your own files, connect to real tools and APIs, complete multi-step tasks, and behave reliably enough to share with other people.
            </p>

            <div class="mt-9 flex flex-wrap gap-3">
              <a href="#pricing" data-enroll-cta class="inline-flex items-center gap-2 rounded-full bg-[#8A40F5] px-7 py-4 font-bold text-white shadow-lg shadow-[#8A40F5]/20 transition hover:-translate-y-0.5 hover:bg-[#7434D8] focus:outline-none focus:ring-2 focus:ring-[#8A40F5] focus:ring-offset-2">
                Join the cohort
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </a>
              <a href="#curriculum" class="inline-flex items-center rounded-full border border-[#1A0533]/15 bg-white px-7 py-4 font-bold transition hover:border-[#8A40F5] hover:text-[#8A40F5] focus:outline-none focus:ring-2 focus:ring-[#8A40F5]">See the six-week journey</a>
            </div>

            <div class="mt-10 grid gap-3 sm:grid-cols-3">
              {[
                ['Build every week', 'Turn concepts into working applications.'],
                ['Get real feedback', 'Learn with instructor and cohort support.'],
                ['Finish with proof', 'Deploy a capstone you can demonstrate.'],
              ].map(([title, body], index) => (
                <div class="rounded-2xl border border-[#1A0533]/8 bg-white/80 p-4 shadow-sm backdrop-blur">
                  <span class="text-xs font-extrabold text-[#8A40F5]">0{index + 1}</span>
                  <p class="mt-3 font-extrabold">{title}</p>
                  <p class="mt-1 text-sm leading-6 text-gray-500">{body}</p>
                </div>
              ))}
            </div>
          </div>

          <aside class="relative lg:sticky lg:top-6" aria-label="Cohort summary">
            <div class="overflow-hidden rounded-3xl border border-[#1A0533]/10 bg-white shadow-2xl shadow-[#1A0533]/10">
              <div class="bg-[#1A0533] p-6 text-white">
                <div class="flex items-center justify-between gap-4">
                  <span class="rounded-full bg-white/10 px-3 py-1 text-xs font-bold uppercase tracking-widest text-[#D8BDFF]">October cohort</span>
                  <span class="text-sm text-white/55">{aiCohort.capacity} seats</span>
                </div>
                <div class="mt-7 flex items-end gap-3">
                  <strong class="text-4xl font-extrabold">{formatNaira(aiCohort.fullPaymentPrice)}</strong>
                  <span class="pb-1 text-lg text-white/35 line-through">{formatNaira(aiCohort.originalPrice)}</span>
                </div>
                <p class="mt-2 text-sm font-semibold text-[#D8BDFF]">Pay in full and save {formatNaira(aiCohort.fullPaymentSaving)}</p>
              </div>

              <dl class="grid grid-cols-2 gap-px bg-[#1A0533]/8">
                {[
                  ['Duration', `${aiCohort.durationWeeks} weeks`],
                  ['Starts', aiCohort.startDateLabel],
                  ['Format', 'Online + live classes'],
                  ['Prerequisite', aiCohort.prerequisite],
                ].map(([term, value]) => (
                  <div class="bg-white p-5">
                    <dt class="text-xs font-bold uppercase tracking-widest text-gray-400">{term}</dt>
                    <dd class="mt-2 font-extrabold leading-6">{value}</dd>
                  </div>
                ))}
              </dl>

              <div class="p-6">
                <p class="text-sm font-bold text-[#8A40F5]">Installment option</p>
                <p class="mt-1 text-lg font-extrabold">{formatNaira(aiCohort.installmentAmount)} × {aiCohort.installmentCount}</p>
                <p class="mt-1 text-sm text-gray-500">{formatNaira(aiCohort.installmentTotal)} total. We’ll follow up about payment two.</p>
                <a href="#pricing" data-enroll-cta class="mt-5 flex w-full items-center justify-center rounded-xl bg-[#8A40F5] px-6 py-3.5 font-bold text-white transition hover:bg-[#7434D8] focus:outline-none focus:ring-2 focus:ring-[#8A40F5] focus:ring-offset-2">Choose how to pay</a>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </header>

    <section class="bg-[#F5F2EB] py-20 md:py-28">
      <div class="mx-auto max-w-7xl px-6 md:px-12 lg:px-16 xl:px-24">
        <div class="max-w-3xl">
          <p class="section-kicker">From watching to building</p>
          <h2 class="section-heading">You’ve watched the tutorials. But can you build without one?</h2>
          <p class="section-lead">If basic Python makes sense but building a useful AI product from scratch still feels unclear, this cohort gives you the path, projects, feedback, and deadlines to move forward.</p>
        </div>
        <div class="mt-12 grid gap-5 lg:grid-cols-3">
          {painPoints.map((point) => (
            <article class="rounded-3xl border border-[#1A0533]/8 bg-white p-7 shadow-sm">
              <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#8A40F5]/10 text-[#8A40F5]">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={point.icon} /></svg>
              </span>
              <h3 class="mt-7 text-xl font-extrabold leading-7">{point.title}</h3>
              <p class="mt-3 leading-7 text-gray-600">{point.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="py-20 md:py-28">
      <div class="mx-auto max-w-7xl px-6 md:px-12 lg:px-16 xl:px-24">
        <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
          <div>
            <p class="section-kicker">What changes</p>
            <h2 class="section-heading">Build AI that does more than return a chat response.</h2>
            <p class="section-lead">Learn the pieces that turn an AI model into an application: trusted knowledge, useful actions, clear workflows, and evidence that the result works.</p>
          </div>
          <div class="capability-map rounded-3xl bg-[#1A0533] p-5 text-white shadow-2xl md:p-8">
            <div class="mb-6 flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-white/45"><span class="h-2 w-2 rounded-full bg-[#B98BFF]"></span> Your AI application</div>
            <div class="grid gap-3 sm:grid-cols-2">
              {capabilities.map((item, index) => (
                <article class="rounded-2xl border border-white/10 bg-white/[0.06] p-5">
                  <div class="flex items-start gap-4">
                    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#8A40F5] text-white">
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={item.icon} /></svg>
                    </span>
                    <div><p class="font-extrabold">{item.label}</p><p class="mt-1 text-sm leading-6 text-white/55">{item.detail}</p></div>
                  </div>
                  <div class="mt-5 h-1.5 overflow-hidden rounded-full bg-white/8"><div class="h-full rounded-full bg-[#B98BFF]" style={`width:${55 + index * 12}%`}></div></div>
                </article>
              ))}
            </div>
            <div class="mt-4 flex items-center justify-between rounded-2xl border border-[#B98BFF]/20 bg-[#8A40F5]/15 p-4 text-sm">
              <span class="font-bold text-[#D8BDFF]">Input → retrieve → decide → act → evaluate</span>
              <span class="rounded-full bg-[#45D694]/15 px-3 py-1 font-bold text-[#76E5B3]">Working build</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="curriculum" class="scroll-mt-24 bg-[#F5F2EB] py-20 md:py-28">
      <div class="mx-auto max-w-6xl px-6 md:px-12 lg:px-16">
        <div class="max-w-3xl">
          <p class="section-kicker">Your six-week build journey</p>
          <h2 class="section-heading">One new capability. One useful build. Every week.</h2>
          <p class="section-lead">The skills build on each other until you can combine knowledge, tools, workflows, reliability, and deployment in one final application.</p>
        </div>

        <div class="relative mt-14 space-y-5 before:absolute before:bottom-10 before:left-7 before:top-10 before:w-px before:bg-[#8A40F5]/20 md:before:left-10">
          {weeks.map((week) => (
            <article class="relative grid gap-5 rounded-3xl border border-[#1A0533]/8 bg-white p-5 shadow-sm md:grid-cols-[80px_1fr_auto] md:items-center md:p-7">
              <span class="relative z-10 flex h-14 w-14 items-center justify-center rounded-2xl bg-[#1A0533] text-sm font-extrabold text-white md:h-20 md:w-20 md:text-base">{week.number}</span>
              <div>
                <p class="text-xs font-bold uppercase tracking-widest text-[#8A40F5]">Week {Number(week.number)}</p>
                <h3 class="mt-2 text-xl font-extrabold md:text-2xl">{week.title}</h3>
                <p class="mt-2 max-w-2xl leading-7 text-gray-600">{week.description}</p>
                <div class="mt-4 flex flex-wrap gap-2">{week.tags.map((tag) => <span class="rounded-full bg-[#F5F2EB] px-3 py-1 text-xs font-bold text-[#1A0533]/65">{tag}</span>)}</div>
              </div>
              <div class="rounded-2xl border border-[#8A40F5]/15 bg-[#F8F4FF] p-4 md:max-w-52">
                <p class="text-xs font-extrabold uppercase tracking-widest text-[#8A40F5]">You ship</p>
                <p class="mt-2 font-bold leading-6">{week.ship}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="projects" class="scroll-mt-24 py-20 md:py-28">
      <div class="mx-auto max-w-7xl px-6 md:px-12 lg:px-16 xl:px-24">
        <div class="max-w-3xl">
          <p class="section-kicker">Project possibilities</p>
          <h2 class="section-heading">What could you actually build with these skills?</h2>
          <p class="section-lead">Think beyond another chatbot. Build useful applications for a company, a client, or a product of your own.</p>
        </div>
        <div class="mt-12 grid gap-6 lg:grid-cols-3">
          {projects.map((project) => (
            <article class={`project-card project-card--${project.accent} overflow-hidden rounded-3xl border border-[#1A0533]/8 bg-white p-6`}>
              <span class="inline-flex rounded-full bg-[#F5F2EB] px-3 py-1 text-xs font-bold text-[#8A40F5]">{project.tag}</span>
              <h3 class="mt-5 text-2xl font-extrabold">{project.title}</h3>
              <p class="mt-3 leading-7 text-gray-600">{project.description}</p>
              <div class="project-window mt-8 rounded-2xl border border-[#1A0533]/10 bg-[#FBFAF7] p-3 shadow-inner" aria-hidden="true">
                <div class="flex gap-1.5"><span></span><span></span><span></span></div>
                <div class="mt-4 grid grid-cols-[0.35fr_1fr] gap-3">
                  <div class="space-y-2"><i></i><i></i><i></i><i></i></div>
                  <div class="space-y-3"><b></b><em></em><em></em><div class="flex gap-2"><strong></strong><strong></strong></div></div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-[#1A0533] py-20 text-white md:py-28">
      <div class="mx-auto max-w-7xl px-6 md:px-12 lg:px-16 xl:px-24">
        <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
          <div>
            <p class="text-xs font-extrabold uppercase tracking-widest text-[#B98BFF]">Your final proof of work</p>
            <h2 class="mt-4 text-4xl font-extrabold leading-tight tracking-tight md:text-5xl">Leave with proof, not just notes.</h2>
            <p class="mt-6 text-lg leading-8 text-white/65">Build, deploy, and present an AI application you can explain. Show the problem it solves, how it works, and the decisions you made while building it.</p>
            <p class="mt-6 rounded-2xl border border-[#B98BFF]/20 bg-[#8A40F5]/15 p-5 font-semibold leading-7 text-[#E7D8FF]">Use your capstone when applying for jobs, pitching freelance work, proposing an AI idea at work, or testing your own product.</p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            {[
              ['Works with your data', 'Answer from private or domain-specific knowledge.'],
              ['Connects to real tools', 'Use APIs, search, databases, or external services.'],
              ['Handles multiple steps', 'Route tasks and decide what should happen next.'],
              ['Deployed and demo-ready', 'Let another person use, test, and understand it.'],
            ].map(([title, body]) => (
              <article class="rounded-2xl border border-white/10 bg-white/[0.06] p-5">
                <svg class="h-6 w-6 text-[#B98BFF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                <h3 class="mt-5 font-extrabold">{title}</h3>
                <p class="mt-2 text-sm leading-6 text-white/55">{body}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 md:py-28">
      <div class="mx-auto max-w-7xl px-6 md:px-12 lg:px-16 xl:px-24">
        <div class="max-w-3xl">
          <p class="section-kicker">Put the skill to work</p>
          <h2 class="section-heading">Where could this skill take you?</h2>
        </div>
        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {realWorldUses.map((item) => (
            <article class="rounded-3xl bg-[#F5F2EB] p-6">
