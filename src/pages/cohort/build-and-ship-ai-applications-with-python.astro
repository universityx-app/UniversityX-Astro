  }
</style>

<script>
  declare global {
    interface Window {
      posthog?: { capture: (event: string, properties?: Record<string, unknown>) => void };
    }
  }

  function initCohortPage() {
    const cohort = {
      cohort_slug: 'build-and-ship-ai-applications-with-python',
      cohort_start_date: '2026-10-03',
    };
    window.posthog?.capture('cohort_page_viewed', cohort);

    let checkoutStarted = false;
    document.querySelectorAll<HTMLElement>('[data-enroll-cta]').forEach((cta) => {
      cta.addEventListener('click', () => {
        if (!checkoutStarted) {
          checkoutStarted = true;
          window.posthog?.capture('cohort_checkout_started', cohort);
        }
      });
    });

    document.getElementById('scholarship-cta')?.addEventListener('click', () => {
      window.posthog?.capture('scholarship_clicked', cohort);
    });

    const radios = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="cohort-payment-plan"]'));
    const continueButton = document.getElementById('paystack-continue') as HTMLButtonElement | null;
    const message = document.getElementById('checkout-message');
    if (!continueButton) return;

    const selectedPlan = () => radios.find((radio) => radio.checked && !radio.disabled)?.value as 'full' | 'installment' | undefined;
    radios.forEach((radio) => {
      radio.addEventListener('change', () => {
        if (radio.checked) window.posthog?.capture('cohort_payment_option_selected', { ...cohort, payment_option: radio.value });
      });
    });

    continueButton.addEventListener('click', () => {
      const plan = selectedPlan();
      const target = plan === 'full' ? continueButton.dataset.fullUrl : plan === 'installment' ? continueButton.dataset.installmentUrl : '';
      if (!plan || !target) {
        message?.classList.remove('hidden');
        if (message) message.textContent = 'That payment option is not available yet. Please choose another option or check back shortly.';
        return;
      }

      window.posthog?.capture('cohort_paystack_page_opened', { ...cohort, payment_option: plan });
      window.location.assign(target);
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initCohortPage, { once: true });
  else initCohortPage();
</script>
