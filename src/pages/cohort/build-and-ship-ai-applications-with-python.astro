---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import WorkshopFAQ from '../../components/WorkshopFAQ.astro';
import InstructorStrip from '../../components/InstructorStrip.astro';
import MeetInstructorSection from '../../components/MeetInstructorSection.astro';
import {
  AI_COHORT_SCHOLARSHIP_PATH,
  aiCohort,
  formatNaira,
  paystackPaymentPages,
} from '../../data/aiCohort';

const outcomes = [
  {
    title: 'Ground AI in real knowledge',
    body: 'You will build apps that answer from PDFs, policies, reports, and private knowledge, with sources people can check.',
    icon: 'M4 5.5A2.5 2.5 0 0 1 6.5 3H20v16H6.5A2.5 2.5 0 0 0 4 21.5v-16ZM4 18.5A2.5 2.5 0 0 1 6.5 16H20M8 7h7M8 11h5',
  },
  {
    title: 'Connect models to useful tools',
    body: 'You will connect APIs, search, databases, and other services so your app can find information and take action.',
    icon: 'M8 12h8M12 8v8M5 5l2.5 2.5M19 5l-2.5 2.5M5 19l2.5-2.5M19 19l-2.5-2.5',
  },
  {
    title: 'Design multi-step workflows',
    body: 'You will route tasks, keep useful context, add human approval, and help your app choose what to do next.',
    icon: 'M4 6h6v6h4v6h6M7 3 4 6l3 3m10 6 3 3-3 3',
  },
  {
    title: 'Ship something people can trust',
    body: 'You will test how your app behaves, handle failures, put it online, and finish with a capstone you can confidently show.',
    icon: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Zm-3-10 2 2 4-4',
  },
];

const weeks = [
  {
    number: '01',
    title: 'Build your first useful AI application',
    description: 'Connect Python to an AI model, ask for structured responses, and turn a model call into a small working product.',
    ship: 'A working Python AI application',
    tags: ['Python', 'LLM APIs', 'Structured output'],
  },
  {
    number: '02',
    title: 'Build AI that answers from your own files',
    description: 'Give your application PDFs, policies, notes, or internal documents and make it answer from that material with sources.',
    ship: 'A document assistant with cited answers',
    tags: ['Retrieval', 'RAG', 'Citations'],
  },
  {
    number: '03',
    title: 'Build AI that can actually do things',
    description: 'Connect search, APIs, databases, or other services so your application can fetch information and take useful actions.',
    ship: 'A tool-using AI workflow',
    tags: ['Tool calling', 'APIs', 'Structured data'],
  },
  {
    number: '04',
    title: 'Build AI that handles a task step by step',
    description: 'Create a workflow that chooses what happens next, keeps useful state, and asks for human approval when it matters.',
    ship: 'A multi-step AI agent',
    tags: ['LangGraph', 'Routing', 'Memory'],
  },
  {
    number: '05',
    title: 'Make your AI app something people can trust',
    description: 'Handle weak responses and failures, inspect what happened, and test whether your application behaves as expected.',
    ship: 'A reliable, evaluated application',
    tags: ['Guardrails', 'Tracing', 'Evals'],
  },
  {
    number: '06',
    title: 'Put your AI application online',
    description: 'Finish your capstone, deploy it, document the decisions you made, and prepare a clear demo of what it can do.',
    ship: 'Your portfolio-ready capstone',
    tags: ['Deployment', 'Documentation', 'Demo'],
  },
];

const projects = [
  {
    title: 'AI Research Assistant',
    tag: 'Own data + citations',
    description: 'Upload reports or internal documents and build an assistant that answers questions and points back to the source.',
  },
  {
    title: 'Customer Support Assistant',
    tag: 'Knowledge + tools',
    description: 'Answer from company knowledge, check customer information, and hand difficult cases to a human.',
  },
  {
    title: 'Recruitment Assistant',
    tag: 'Workflow + evaluation',
    description: 'Read CVs or job descriptions, retrieve relevant details, and help a recruiter organise a review workflow.',
  },
];

const cohortFeatures = [
  ['Live classes', 'Build with your instructor and ask questions as they come up.'],
  ['Weekly builds', 'Turn every new capability into working code.'],
  ['Project feedback', 'Get clear, practical feedback on the work you submit.'],
  ['Session recordings', 'Rewatch a class or catch up when you miss one.'],
  ['Cohort community', 'Share your progress and build alongside other developers.'],
  ['Demo Day and certificate', 'Show what you built and earn recognition for completing the work.'],
];

const suitability = [
  'You understand basic Python and can write small scripts.',
  'You want to build with documents, APIs, and AI agents.',
  'You learn best by building and getting practical feedback.',
  'You can make time for the live sessions and weekly projects.',
];

const faqs = [
  { question: 'What experience do I need?', answer: 'You should be comfortable with basic Python and able to write small scripts. You do not need any previous AI or machine-learning experience. We will focus on building applications with existing models.' },
  { question: 'What will I build and leave with?', answer: 'You will build practical projects throughout the cohort and finish with a deployed capstone, a documented repository, feedback on your work, and something real you can show.' },
  { question: 'What if I miss a live class?', answer: 'You can catch up with the recording. You will still need to complete that week’s practical build so you are ready for the next class.' },
  { question: 'Can I pay in installments?', answer: `Yes. You can pay ${formatNaira(aiCohort.installmentAmount)} now and the same amount later, for a total of ${formatNaira(aiCohort.installmentTotal)}. If you pay ${formatNaira(aiCohort.fullPaymentPrice)} in full, you save ${formatNaira(aiCohort.fullPaymentSaving)}.` },
];

---

<Layout
  title={`${aiCohort.title} | UniversityX`}
  description="Go from watching AI tutorials to building useful AI applications with Python, your own data, tools, multi-step workflows, evaluation, and a deployed capstone."
>
  <Navbar />

  <main class="overflow-x-hidden bg-white text-[#1A0533]">
    <header class="border-b border-[#1A0533]/8 py-16 md:py-24">
      <div class="section-shell grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_380px] lg:gap-16">
        <div class="max-w-3xl">
          <p class="inline-flex items-center gap-2 text-sm font-bold text-[#8A40F5]">
            <span class="h-2 w-2 rounded-full bg-[#8A40F5]" aria-hidden="true"></span>
            Live online cohort · {aiCohort.capacity} seats
          </p>
          <h1 class="mt-6 text-[2.75rem] font-extrabold leading-[1.02] tracking-[-0.045em] md:text-6xl lg:text-[4.25rem]">
            Build and ship AI applications with Python <span class="font-['Playfair_Display',serif] italic text-[#8A40F5]">in 6 weeks.</span>
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-gray-600 md:text-xl">Move beyond tutorials. Build AI applications that work with your data, use real tools, handle multi-step tasks, and are ready to deploy and demonstrate.</p>
          <div class="hero-actions mt-8 flex flex-col gap-4 sm:flex-row sm:items-center">
            <a href="#pricing" data-enroll-cta class="primary-button">
              Join the cohort
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
            <a href="#curriculum" class="text-link">View the six-week curriculum <span aria-hidden="true">↓</span></a>
          </div>
          <InstructorStrip
            name="Abasiodiong Udofia"
            role="CTO at ChatJourno · 3MTT Mentor · Ex-Senior Backend Engineer at Paydue"
            photo="/images/abasiodiong-hs.png"
            className="mt-8"
          />
        </div>

        <aside class="rounded-2xl border border-[#1A0533]/10 bg-[#F8F5EF] p-6 md:p-8" aria-label="Cohort summary">
          <p class="text-xs font-extrabold uppercase tracking-[0.16em] text-[#8A40F5]">October cohort</p>
          <div class="mt-5 flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <strong class="text-4xl font-extrabold tracking-tight">{formatNaira(aiCohort.fullPaymentPrice)}</strong>
            <span class="text-base text-gray-400 line-through">{formatNaira(aiCohort.originalPrice)}</span>
          </div>
          <p class="mt-2 text-sm font-semibold text-gray-600">or {formatNaira(aiCohort.installmentAmount)} × {aiCohort.installmentCount}</p>
          <dl class="mt-7 divide-y divide-[#1A0533]/10 border-y border-[#1A0533]/10">
            {[
              ['Starts', aiCohort.startDateLabel],
              ['Duration', `${aiCohort.durationWeeks} weeks`],
              ['Format', 'Online · Live classes'],
              ['Prerequisite', aiCohort.prerequisite],
            ].map(([term, value]) => (
              <div class="flex items-center justify-between gap-5 py-3.5">
                <dt class="text-sm text-gray-500">{term}</dt>
                <dd class="text-right text-sm font-bold">{value}</dd>
              </div>
            ))}
          </dl>
          <a href="#pricing" data-enroll-cta class="mt-7 flex w-full items-center justify-center rounded-xl bg-[#1A0533] px-6 py-3.5 font-bold text-white transition-colors hover:bg-[#341153] focus:outline-none focus:ring-2 focus:ring-[#8A40F5] focus:ring-offset-2">Choose a payment option</a>
        </aside>
      </div>
    </header>

    <section class="bg-[#F8F5EF] py-16 md:py-24">
      <div class="section-shell">
        <div class="max-w-3xl">
          <p class="section-kicker">What you will learn</p>
          <h2 class="section-heading">Here is what you will be able to build.</h2>
          <p class="section-lead">You will not stop at sending a prompt and printing the response. You will learn how to turn an AI model into an app that solves a real problem.</p>
        </div>
        <div class="mt-10 grid gap-px overflow-hidden rounded-2xl border border-[#1A0533]/10 bg-[#1A0533]/10 md:grid-cols-2">
          {outcomes.map((outcome) => (
            <article class="bg-white p-6 md:p-8">
              <span class="icon-tile">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={outcome.icon} /></svg>
              </span>
              <h3 class="mt-5 text-xl font-extrabold">{outcome.title}</h3>
              <p class="mt-3 leading-7 text-gray-600">{outcome.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="curriculum" class="scroll-mt-20 py-16 md:py-24">
      <div class="section-shell">
        <div class="max-w-3xl">
          <p class="section-kicker">The curriculum</p>
          <h2 class="section-heading">Build something useful every week.</h2>
          <p class="section-lead">We start with a simple model call, then add your own data, tools, workflows, testing, and deployment one week at a time.</p>
        </div>
        <div class="mt-12 divide-y divide-[#1A0533]/10 border-y border-[#1A0533]/10">
          {weeks.map((week) => (
            <article class="grid gap-5 py-7 md:grid-cols-[72px_minmax(0,1fr)_220px] md:items-start md:gap-7 md:py-9">
              <div>
                <span class="text-xs font-extrabold uppercase tracking-[0.16em] text-[#8A40F5]">Week</span>
                <p class="mt-1 text-3xl font-extrabold text-[#1A0533]/25">{week.number}</p>
              </div>
              <div>
                <h3 class="text-xl font-extrabold md:text-2xl">{week.title}</h3>
                <p class="mt-2 max-w-2xl leading-7 text-gray-600">{week.description}</p>
                <div class="mt-4 flex flex-wrap gap-2">{week.tags.map((tag) => <span class="rounded-full bg-[#F5F2EB] px-3 py-1 text-xs font-bold text-[#1A0533]/65">{tag}</span>)}</div>
              </div>
              <div class="border-l-2 border-[#8A40F5] pl-4">
                <p class="text-xs font-extrabold uppercase tracking-[0.14em] text-[#8A40F5]">You ship</p>
                <p class="mt-2 font-bold leading-6">{week.ship}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="projects" class="scroll-mt-20 bg-[#1A0533] py-16 text-white md:py-24">
      <div class="section-shell">
        <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
          <div>
            <p class="section-kicker section-kicker--dark">What you will leave with</p>
            <h2 class="section-heading">A project you will be proud to show.</h2>
          </div>
          <p class="max-w-2xl text-lg leading-8 text-white/65">You will build, deploy, and present an app you understand. You will be able to explain the problem it solves, how it works, and why you built it that way.</p>
        </div>
        <div class="mt-12 grid gap-4 lg:grid-cols-3">
          {projects.map((project, index) => (
            <article class="rounded-2xl border border-white/12 bg-white/6 p-6 md:p-7">
              <div class="flex items-center justify-between gap-4">
                <span class="rounded-full bg-[#8A40F5]/25 px-3 py-1 text-xs font-bold text-[#DEC9FF]">{project.tag}</span>
                <span class="text-sm font-extrabold text-white/25">0{index + 1}</span>
              </div>
              <h3 class="mt-8 text-xl font-extrabold">{project.title}</h3>
              <p class="mt-3 leading-7 text-white/60">{project.description}</p>
            </article>
          ))}
        </div>
        <div class="mt-6 flex flex-col gap-4 rounded-2xl border border-[#B98BFF]/25 bg-[#8A40F5]/15 p-6 md:flex-row md:items-center md:justify-between">
          <p class="max-w-3xl font-semibold leading-7 text-[#E9DCFA]">Your capstone will use real knowledge, connect to useful tools, handle multiple steps, and be online for someone else to try.</p>
          <span class="shrink-0 text-sm font-extrabold uppercase tracking-[0.14em] text-[#CFAEFF]">Demo ready</span>
        </div>
      </div>
    </section>

    <section class="bg-[#F8F5EF] py-16 md:py-24">
      <div class="section-shell grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
        <div>
          <p class="section-kicker">Inside the cohort</p>
          <h2 class="section-heading">You will not have to figure it out alone.</h2>
          <div class="mt-9 grid gap-px overflow-hidden rounded-2xl border border-[#1A0533]/10 bg-[#1A0533]/10 sm:grid-cols-2">
            {cohortFeatures.map(([title, body]) => (
              <article class="bg-white p-5 md:p-6">
                <svg class="h-5 w-5 text-[#8A40F5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                <h3 class="mt-4 font-extrabold">{title}</h3>
                <p class="mt-2 text-sm leading-6 text-gray-600">{body}</p>
              </article>
            ))}
          </div>
        </div>
        <aside class="self-start rounded-2xl border border-[#1A0533]/10 bg-white p-7 md:p-8">
          <p class="section-kicker">Is this for you?</p>
          <h2 class="mt-3 text-2xl font-extrabold tracking-tight md:text-3xl">You will get the most from this cohort if...</h2>
          <ul class="mt-7 space-y-4">
            {suitability.map((item) => (
              <li class="flex gap-3 leading-7 text-gray-700">
                <span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#8A40F5] text-[0.65rem] font-bold text-white" aria-hidden="true">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <p class="mt-7 border-t border-[#1A0533]/10 pt-6 text-sm leading-6 text-gray-500">This is not a no-code or prompt-only programme, and it does not teach Python from the beginning.</p>
        </aside>
      </div>
    </section>

    <MeetInstructorSection
      name="Abasiodiong Udofia"
      role="CTO at ChatJourno · 3MTT Mentor · Ex-Senior Backend Engineer at Paydue"
      photo="/images/abasiodiong-hs.png"
      background="white"
    />

    <section id="pricing" class="scroll-mt-20 bg-[#1A0533] py-16 text-white md:py-24">
      <div class="section-shell">
        <div class="mx-auto max-w-3xl text-center">
          <p class="section-kicker section-kicker--dark">Enrollment</p>
          <h2 class="section-heading">Pick the payment option that works for you.</h2>
          <p class="mt-5 text-lg leading-8 text-white/60">There are {aiCohort.capacity} seats. Choose your payment option below when you are ready to join us.</p>
        </div>

        <fieldset class="mx-auto mt-10 max-w-4xl">
          <legend class="sr-only">Choose a payment option</legend>
          <div class="grid gap-4 md:grid-cols-2">
            <label class="payment-card relative cursor-pointer rounded-2xl border p-6 transition md:p-7" data-payment-card="full">
              <input type="radio" name="cohort-payment-plan" value="full" class="sr-only" checked />
              <div class="flex items-start justify-between gap-4">
                <div><p class="text-sm font-bold text-[#D8BDFF]">Pay in full</p><p class="mt-3 text-4xl font-extrabold">{formatNaira(aiCohort.fullPaymentPrice)}</p></div>
                <span class="rounded-full bg-[#45D694]/15 px-3 py-1 text-xs font-extrabold text-[#76E5B3]">Save {formatNaira(aiCohort.fullPaymentSaving)}</span>
              </div>
              <p class="mt-5 text-sm leading-6 text-white/55">Pay once and get the lowest total price.</p>
              <span class="payment-radio mt-7 flex h-6 w-6 items-center justify-center rounded-full border border-white/30"><i class="h-3 w-3 rounded-full bg-[#B98BFF]"></i></span>
            </label>

            <label class="payment-card relative cursor-pointer rounded-2xl border p-6 transition md:p-7" data-payment-card="installment">
              <input type="radio" name="cohort-payment-plan" value="installment" class="sr-only" />
              <div class="flex items-start justify-between gap-4">
                <div><p class="text-sm font-bold text-[#D8BDFF]">Pay in installments</p><p class="mt-3 text-4xl font-extrabold">{formatNaira(aiCohort.installmentAmount)} <span class="text-base text-white/45">now</span></p></div>
                <span class="rounded-full bg-white/8 px-3 py-1 text-xs font-bold text-white/60">2 payments</span>
              </div>
              <p class="mt-5 text-sm leading-6 text-white/55">Pay {formatNaira(aiCohort.installmentAmount)} today and the same amount later. {formatNaira(aiCohort.installmentTotal)} total.</p>
              <span class="payment-radio mt-7 flex h-6 w-6 items-center justify-center rounded-full border border-white/30"><i class="h-3 w-3 rounded-full bg-[#B98BFF]"></i></span>
            </label>
          </div>
        </fieldset>

        <div class="mx-auto mt-4 max-w-4xl rounded-2xl border border-white/12 bg-white/5 p-5">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="font-bold">Secure checkout powered by Paystack</p>
              <p class="mt-1 text-sm leading-6 text-white/50">After you pay, you will fill out a short form so we can confirm your place and prepare your access.</p>
            </div>
            <button
              id="paystack-continue"
              type="button"
              data-full-url={paystackPaymentPages.full}
              data-installment-url={paystackPaymentPages.installment}
              class="shrink-0 rounded-xl bg-[#8A40F5] px-7 py-4 font-extrabold text-white transition-colors hover:bg-[#7434D8] disabled:cursor-not-allowed disabled:opacity-45 focus:outline-none focus:ring-2 focus:ring-[#B98BFF]"
            >Continue to secure payment →</button>
          </div>
          <p id="checkout-message" class="mt-4 hidden text-sm text-amber-300" aria-live="polite">
            Online checkout is being configured. Please check back shortly.
          </p>
        </div>

        <div class="mx-auto mt-8 grid max-w-4xl gap-px overflow-hidden rounded-2xl border border-white/12 bg-white/12 md:grid-cols-2">
          <div class="flex items-start gap-4 bg-[#21103A] p-6">
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl border border-white/10 bg-white/6 text-[#D8BDFF]" aria-hidden="true">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3 5 6v5c0 4.6 2.8 8.1 7 10 4.2-1.9 7-5.4 7-10V6l-7-3Z" />
                <path d="m9 12 2 2 4-4" />
              </svg>
            </span>
            <div class="min-w-0">
              <p class="text-base font-extrabold">UniversityX Promise</p>
              <p class="mt-2 text-sm leading-6 text-white/55">
                If the cohort is not right for you, you can request an eligible refund through {aiCohort.promiseDeadlineLabel}. Click here to <a href="/universityx-promise/" class="font-semibold text-white/75 underline decoration-white/30 underline-offset-4 transition-colors hover:text-white hover:decoration-white/70 focus:outline-none focus:ring-2 focus:ring-[#B98BFF]">Read the Promise</a>.
              </p>
            </div>
          </div>
          <div class="flex items-start gap-4 bg-[#21103A] p-6">
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl border border-white/10 bg-white/6 text-[#D8BDFF]" aria-hidden="true">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="m3 9 9-5 9 5-9 5-9-5Z" />
                <path d="M7 11.2V16c2.8 2.2 7.2 2.2 10 0v-4.8M21 9v6" />
              </svg>
            </span>
            <div class="min-w-0">
              <p class="text-base font-extrabold">Access scholarships</p>
              <p class="mt-2 text-sm leading-6 text-white/55">
                Need help with tuition? You can apply for one of the limited partial scholarships. Applying does not guarantee support. Click here to <a href={AI_COHORT_SCHOLARSHIP_PATH} id="scholarship-cta" class="font-semibold text-white/75 underline decoration-white/30 underline-offset-4 transition-colors hover:text-white hover:decoration-white/70 focus:outline-none focus:ring-2 focus:ring-[#B98BFF]">Request scholarship support</a>.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <WorkshopFAQ
      faqs={faqs}
      eyebrow="Before you join"
    />
  </main>

  <Footer />
</Layout>

<style>
  :global(html) { scroll-behavior: smooth; }
  .section-shell { width: min(100% - 3rem, 72rem); margin-inline: auto; }
  .section-kicker { font-size: .75rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: #8A40F5; }
  .section-heading { margin-top: .75rem; font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; letter-spacing: -.035em; line-height: 1.1; }
  .section-lead { margin-top: 1rem; font-size: 1.125rem; line-height: 1.75; color: #5f6368; }
  .section-kicker--dark { color: #CFAEFF; }
  .primary-button { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; align-self: flex-start; border-radius: 999px; background: #8A40F5; padding: .9rem 1.6rem; color: white; font-weight: 700; transition: background-color .2s ease; }
  .primary-button:hover { background: #7434D8; }
  .primary-button:focus-visible, .text-link:focus-visible { outline: 2px solid #8A40F5; outline-offset: 4px; }
  .text-link { display: inline-flex; align-items: center; gap: .45rem; align-self: flex-start; border-radius: .25rem; color: #1A0533; font-weight: 700; }
  .text-link:hover { color: #8A40F5; }
  .icon-tile { display: grid; width: 2.75rem; height: 2.75rem; place-items: center; border-radius: .75rem; background: #F0E8FC; color: #7632CE; }

  .payment-card { border-color: rgba(255,255,255,.12); background: rgba(255,255,255,.05); }
  .payment-card:hover { border-color: rgba(185,139,255,.5); background: rgba(255,255,255,.075); }
  .payment-card:has(input:checked) { border-color: #B98BFF; background: rgba(138,64,245,.18); box-shadow: 0 0 0 1px rgba(185,139,255,.25); }
  .payment-card:has(input:focus-visible) { outline: 2px solid #B98BFF; outline-offset: 4px; }
  .payment-card .payment-radio i { opacity: 0; }
  .payment-card:has(input:checked) .payment-radio { border-color: #B98BFF; }
  .payment-card:has(input:checked) .payment-radio i { opacity: 1; }
  @media (min-width: 768px) {
    .section-shell { width: min(100% - 6rem, 72rem); }
  }

  @media (min-width: 640px) {
    .hero-actions .text-link { align-self: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
    *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; }
  }
</style>

<script>
  declare global {
    interface Window {
      posthog?: any;
    }
  }

  function initCohortPage() {
    const cohort = {
      cohort_slug: 'build-and-ship-ai-applications-with-python',
      cohort_start_date: '2026-10-03',
    };
    window.posthog?.capture('cohort_page_viewed', cohort);

    let checkoutStarted = false;
    document.querySelectorAll<HTMLElement>('[data-enroll-cta]').forEach((cta) => {
      cta.addEventListener('click', () => {
        if (!checkoutStarted) {
          checkoutStarted = true;
          window.posthog?.capture('cohort_checkout_started', cohort);
        }
      });
    });

    document.getElementById('scholarship-cta')?.addEventListener('click', () => {
      window.posthog?.capture('scholarship_clicked', cohort);
    });

    const radios = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="cohort-payment-plan"]'));
    const continueButton = document.getElementById('paystack-continue') as HTMLButtonElement | null;
    const message = document.getElementById('checkout-message');
    if (!continueButton) return;

    const selectedPlan = () => radios.find((radio) => radio.checked && !radio.disabled)?.value as 'full' | 'installment' | undefined;
    radios.forEach((radio) => {
      radio.addEventListener('change', () => {
        message?.classList.add('hidden');
        if (radio.checked) window.posthog?.capture('cohort_payment_option_selected', { ...cohort, payment_option: radio.value });
      });
    });

    continueButton.addEventListener('click', () => {
      const plan = selectedPlan();
      const target = plan === 'full' ? continueButton.dataset.fullUrl : plan === 'installment' ? continueButton.dataset.installmentUrl : '';
      if (!plan || !target) {
        message?.classList.remove('hidden');
        if (message) message.textContent = 'That payment option is not available yet. Please choose another option or check back shortly.';
        return;
      }

      window.posthog?.capture('cohort_paystack_page_opened', { ...cohort, payment_option: plan });
      window.location.assign(target);
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initCohortPage, { once: true });
  else initCohortPage();
</script>
