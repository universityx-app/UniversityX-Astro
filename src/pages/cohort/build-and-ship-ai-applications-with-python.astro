  .project-window em { height: .6rem; }
  .project-window strong { height: 1.75rem; width: 4.5rem; }
  .project-card--purple .project-window b, .project-card--purple .project-window strong { background: rgba(138, 64, 245, .22); }
  .project-card--green .project-window b, .project-card--green .project-window strong { background: rgba(28, 160, 108, .2); }
  .project-card--orange .project-window b, .project-card--orange .project-window strong { background: rgba(232, 137, 52, .2); }

  .payment-card { border-color: rgba(255,255,255,.12); background: rgba(255,255,255,.05); }
  .payment-card:hover { border-color: rgba(185,139,255,.5); background: rgba(255,255,255,.075); }
  .payment-card:has(input:checked) { border-color: #B98BFF; background: rgba(138,64,245,.18); box-shadow: 0 0 0 1px rgba(185,139,255,.25); }
  .payment-card:has(input:focus-visible) { outline: 2px solid #B98BFF; outline-offset: 4px; }
  .payment-card .payment-radio i { opacity: 0; }
  .payment-card:has(input:checked) .payment-radio { border-color: #B98BFF; }
  .payment-card:has(input:checked) .payment-radio i { opacity: 1; }
  .payment-card.is-disabled { cursor: not-allowed; opacity: .5; }

  details summary::-webkit-details-marker { display: none; }

  @media (prefers-reduced-motion: reduce) {
