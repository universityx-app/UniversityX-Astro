---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { AI_COHORT_PATH, aiCohort } from '../data/aiCohort';
---

<Layout
  title="UniversityX Access Scholarship | October 2026"
  description="Request partial tuition support for the October 2026 Build and Ship AI Applications with Python cohort."
>
  <Navbar />

  <main class="bg-white text-[#1A0533]">
    <section class="bg-[#F5F2EB] py-14 md:py-20">
      <div class="mx-auto max-w-5xl px-6 md:px-12">
        <nav class="mb-8 flex items-center gap-2 text-sm text-gray-500" aria-label="Breadcrumb">
          <a href={AI_COHORT_PATH} class="hover:text-[#8A40F5]">Current cohort</a>
          <span aria-hidden="true" class="text-[#8A40F5]">/</span>
          <span class="font-medium text-[#1A0533]">Access Scholarship</span>
        </nav>
        <p class="text-xs font-extrabold uppercase tracking-widest text-[#8A40F5]">UniversityX Access Scholarships</p>
        <h1 class="mt-4 max-w-4xl text-4xl font-extrabold leading-tight md:text-5xl">Request Scholarship Support</h1>
        <p class="mt-5 max-w-3xl text-xl leading-8 text-gray-700">We don’t want cost to be the only reason a qualified developer cannot participate in Build and Ship AI Applications with Python.</p>
        <div class="mt-8 rounded-xl border border-[#8A40F5]/20 bg-white p-5 leading-7 text-gray-700">
          A limited number of <strong>partial scholarships</strong> are available for the cohort starting {aiCohort.startDateLabel}. Applying does not guarantee support, and UniversityX may not be able to fund every qualified applicant.
        </div>
      </div>
    </section>

    <section class="py-14 md:py-20">
      <div class="mx-auto grid max-w-5xl gap-10 px-6 md:px-12 lg:grid-cols-[0.72fr_1.28fr]">
        <div>
          <h2 class="text-2xl font-extrabold">Before you apply</h2>
          <ul class="mt-5 space-y-4 text-gray-700">
            <li class="rounded-lg bg-[#F5F2EB] p-4">You should already know basic Python and software development fundamentals.</li>
            <li class="rounded-lg bg-[#F5F2EB] p-4">You should be able to commit about four focused hours each week.</li>
            <li class="rounded-lg bg-[#F5F2EB] p-4">Tell us what you can contribute so limited support can reach more learners.</li>
          </ul>
          <a href={AI_COHORT_PATH} class="mt-6 inline-flex font-bold text-[#8A40F5] hover:text-[#7434D8]">Review the programme →</a>
        </div>

        <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-lg md:p-8">
          <div id="scholarship-success" class="hidden rounded-lg border border-[#8A40F5]/20 bg-[#8A40F5]/10 p-5">
            <h2 class="text-xl font-extrabold">Your request has been received.</h2>
            <p class="mt-2 leading-7 text-gray-700">We’ll review your application and contact you. Support is partial, limited, and not guaranteed.</p>
          </div>

          <form id="scholarship-form" class="space-y-5" data-cohort-name={aiCohort.shortTitle} data-cohort-start-date={aiCohort.startDate}>
            <div>
              <label for="scholarship-name" class="mb-2 block font-bold">Full name</label>
              <input id="scholarship-name" name="name" type="text" required autocomplete="name" class="w-full rounded-lg border border-gray-300 px-4 py-3.5 focus:border-[#8A40F5] focus:outline-none focus:ring-2 focus:ring-[#8A40F5]/30" />
            </div>
            <div class="grid gap-5 sm:grid-cols-2">
              <div><label for="scholarship-email" class="mb-2 block font-bold">Email address</label><input id="scholarship-email" name="email" type="email" required autocomplete="email" class="w-full rounded-lg border border-gray-300 px-4 py-3.5 focus:border-[#8A40F5] focus:outline-none focus:ring-2 focus:ring-[#8A40F5]/30" /></div>
              <div><label for="scholarship-whatsapp" class="mb-2 block font-bold">WhatsApp number</label><input id="scholarship-whatsapp" name="whatsapp" type="tel" required autocomplete="tel" class="w-full rounded-lg border border-gray-300 px-4 py-3.5 focus:border-[#8A40F5] focus:outline-none focus:ring-2 focus:ring-[#8A40F5]/30" /></div>
            </div>
            <div>
              <label for="scholarship-python" class="mb-2 block font-bold">Python background</label>
              <select id="scholarship-python" name="pythonExperience" required class="w-full rounded-lg border border-gray-300 bg-white px-4 py-3.5 focus:border-[#8A40F5] focus:outline-none focus:ring-2 focus:ring-[#8A40F5]/30">
                <option value="">Select your background</option>
                <option value="I understand basic Python">I understand basic Python</option>
                <option value="I am a backend/software developer">I am a backend/software developer</option>
                <option value="I am a data or ML practitioner">I am a data or ML practitioner</option>
                <option value="I am not sure I meet the prerequisite">I am not sure I meet the prerequisite</option>
              </select>
            </div>
            <div>
              <label for="scholarship-motivation" class="mb-2 block font-bold">Why will this programme help you now?</label>
              <textarea id="scholarship-motivation" name="motivation" required minlength="50" rows="5" placeholder="Tell us what you want to build and why structured support matters to you." class="w-full rounded-lg border border-gray-300 px-4 py-3.5 focus:border-[#8A40F5] focus:outline-none focus:ring-2 focus:ring-[#8A40F5]/30"></textarea>
              <p class="mt-1 text-sm text-gray-500">Minimum 50 characters.</p>
            </div>
            <div>
              <label for="scholarship-contribution" class="mb-2 block font-bold">How much can you contribute? (₦)</label>
              <input id="scholarship-contribution" name="contribution" type="number" required min="0" max={aiCohort.originalPrice} step="500" inputmode="numeric" placeholder="For example, 12500" class="w-full rounded-lg border border-gray-300 px-4 py-3.5 focus:border-[#8A40F5] focus:outline-none focus:ring-2 focus:ring-[#8A40F5]/30" />
              <p class="mt-1 text-sm text-gray-500">An honest amount helps us allocate partial support fairly.</p>
            </div>
            <label class="flex cursor-pointer items-start gap-3 rounded-lg bg-[#F5F2EB] p-4">
              <input name="weeklyAvailability" type="checkbox" required class="mt-1 h-4 w-4 accent-[#8A40F5]" />
              <span>I can commit about four focused hours each week to live learning and practical builds.</span>
            </label>
            <button id="scholarship-submit" type="submit" class="w-full rounded-lg bg-[#8A40F5] px-6 py-4 font-extrabold text-white transition-colors hover:bg-[#7434D8] disabled:cursor-not-allowed disabled:opacity-60 focus:outline-none focus:ring-2 focus:ring-[#8A40F5] focus:ring-offset-2">Submit Scholarship Request</button>
            <p id="scholarship-error" class="hidden text-center text-sm text-red-700">We couldn’t submit your request. Please check your details and try again.</p>
          </form>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  import PocketBase from 'pocketbase';

  declare global {
    interface Window { posthog?: { capture: (event: string, properties?: Record<string, unknown>) => void; captureException?: (error: unknown) => void }; }
  }

  function initScholarshipForm() {
    const form = document.getElementById('scholarship-form') as HTMLFormElement | null;
    const success = document.getElementById('scholarship-success');
    const error = document.getElementById('scholarship-error');
    const submit = document.getElementById('scholarship-submit') as HTMLButtonElement | null;
    if (!form || !success || !error || !submit) return;

    const params = new URLSearchParams(window.location.search);
    let trafficSource = params.get('utm_source');
    if (!trafficSource && document.referrer) {
      try { trafficSource = new URL(document.referrer).hostname; } catch { trafficSource = 'referral'; }
    }

    const context = {
      cohort_name: form.dataset.cohortName || '',
      cohort_start_date: form.dataset.cohortStartDate || '',
      traffic_source: trafficSource || 'direct',
      referral_code: params.get('referral_code') || params.get('ref') || undefined,
    };
    const pb = new PocketBase(import.meta.env.PUBLIC_POCKETBASE_URL);

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      error.classList.add('hidden');
      if (!form.checkValidity()) { form.reportValidity(); return; }

      const formData = new FormData(form);
      const pythonBackground = String(formData.get('pythonExperience') || '');
      submit.disabled = true;
      submit.textContent = 'Submitting...';

      try {
        await pb.collection('UniversityX_Access_Scholarships').create({
          Full_Name: String(formData.get('name') || ''),
          Email: String(formData.get('email') || ''),
          WhatsApp_Number: String(formData.get('whatsapp') || ''),
          Python_Background: pythonBackground,
          Motivation: String(formData.get('motivation') || ''),
          Weekly_Availability: formData.get('weeklyAvailability') === 'on',
          Amount_Able_To_Contribute: Number(formData.get('contribution')),
          Cohort_Name: context.cohort_name,
          Cohort_Start_Date: context.cohort_start_date,
          Traffic_Source: context.traffic_source,
          Referral_Code: context.referral_code || '',
        });

        window.posthog?.capture('scholarship_application_submitted', { ...context, python_background: pythonBackground });
        form.classList.add('hidden');
        success.classList.remove('hidden');
      } catch (err) {
        window.posthog?.captureException?.(err);
        error.classList.remove('hidden');
        submit.disabled = false;
        submit.textContent = 'Submit Scholarship Request';
      }
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initScholarshipForm, { once: true });
  else initScholarshipForm();
</script>
