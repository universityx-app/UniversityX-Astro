---
import Navbar from './Navbar.astro';

const cards = [
  { country: 'United States', flag: '/images/united-states.png', image: '/images/american-woman.png' },
  { country: 'Nigeria', flag: '/images/nigeria.png', image: '/images/nigerian-man.png' },
  { country: 'United Kingdom', flag: '/images/united-kingdom.png', image: '/images/uk-woman.png' },
  { country: 'Nigeria', flag: '/images/nigeria.png', image: '/images/nigerian-woman.png' },
  { country: 'United States', flag: '/images/united-states.png', image: '/images/american-man.png' },
  { country: 'India', flag: '/images/india.png', image: '/images/indian-man.png' },
];
---

<section class="relative bg-black text-white overflow-hidden">
  <Navbar />

  <!-- ===== HERO CONTENT ===== -->
  <div class="relative mb-8 pt-10 z-10 grid grid-cols-1 lg:grid-cols-2">
    <!-- Left Column: Text -->
    <div class="px-6 lg:pl-24 lg:pr-0 py-12 lg:py-0 relative">
      <p class="hero-eyebrow mb-5 inline-flex items-center gap-3 rounded-full border border-white/10 bg-white/7 px-5 py-2.5 text-sm font-semibold text-white/92 backdrop-blur-md">
        <span class="hero-eyebrow-dot h-2.5 w-2.5 rounded-full bg-[#8A40F5]"></span>
        Tired of watching tutorials?
      </p>

      <!-- Heading -->
      <div class="text-5xl md:text-6xl font-extrabold leading-[1.1] tracking-tight mb-6">
        <span>Build real-world projects that get you hired.</span>
        <!-- <span class="inline-block relative">
          <SideEye class="inline-flex w-15 h-15 align-middle mb-2" />
        </span> -->
      </div>

      <!-- Subtext -->
      <p class="text-gray-400 text-lg md:text-2xl mb-10">
        UniversityX combines real projects, expert guidance, daily accountability and AI-powered skill verification so you can build practical skills with evidence employers can trust.
      </p>

      <!-- Buttons -->
      <div class="flex flex-wrap items-center gap-4 mb-12">
        <a
          id="browse-courses-btn"
          href="/paths/software-engineering/build-your-first-ai-application"
          class="inline-flex items-center gap-2 bg-[#8A40F5] hover:bg-[#7434D8] text-white font-semibold px-7 py-3.5 rounded-full transition-colors text-base focus:outline-none focus:ring-2 focus:ring-[#8A40F5] focus:ring-offset-2 focus:ring-offset-black"
        >
          Join the next cohort
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <a
          id="how-it-works-btn"
          href="#career-paths"
          class="inline-flex items-center gap-2 border border-white/20 hover:border-white/40 text-white font-semibold px-7 py-3.5 rounded-full transition-colors text-base focus:outline-none focus:ring-2 focus:ring-white/60 focus:ring-offset-2 focus:ring-offset-black"
        >
          Explore other programs
        </a>
      </div>
    </div>

    <!-- Right Column: Marquee -->
    <div class="marquee-container relative h-125 lg:h-full overflow-hidden flex items-start!">
      <div class="marquee-track">
        <!-- First set of cards -->
        {cards.map((card) => (
          <div class="marquee-card relative rounded-2xl overflow-hidden shrink-0 w-70 h-110">
            <img
              src={card.image}
              alt="UniversityX learner portrait"
              class="w-full h-full object-cover"
              loading="eager"
              fetchpriority="high"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-linear-to-t from-black/80 via-black/40 to-transparent p-5 pt-16">
              <div class="flex flex-row items-center">
				{/* Name of Person */}
        {/* <p class="text-white font-semibold text-base">
					{card.name}
				</p> */}
				<img
				src={card.flag}
				alt={card.country}
				class="ml-1 h-6 w-auto"
        loading="eager"
        fetchpriority="high"
				/>
			</div>
              {/* Name of Workplace */}
              {/* <p class="text-gray-300 text-sm mt-0.5">{card.title}</p> */}
            </div>
          </div>
        ))}
        <!-- Duplicate set for seamless loop -->
        {cards.map((card) => (
          <div class="marquee-card relative rounded-2xl overflow-hidden shrink-0 w-70 h-110">
            <img
              src={card.image}
              alt="UniversityX learner portrait"
              class="w-full h-full object-cover"
              loading="eager"
              fetchpriority="high"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-linear-to-t from-black/80 via-black/40 to-transparent p-5 pt-16">
              <div class="flex flex-row items-center">
        {/* Name of Person */}
				{/* <p class="text-white font-semibold text-base">
					{card.name}
				</p> */}
				<img
				src={card.flag}
				alt={card.country}
				class="ml-1 h-6 w-auto"
        loading="eager"
        fetchpriority="high"
				/>
			</div>
              {/* Name of Workplace */}
              {/* <p class="text-gray-300 text-sm mt-0.5">{card.title}</p> */}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hero-eyebrow {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 0 0 1px rgba(138, 64, 245, 0.08),
      0 14px 40px rgba(0, 0, 0, 0.28);
    animation: eyebrow-pulse 3.2s ease-in-out infinite;
  }

  .hero-eyebrow-dot {
    box-shadow: 0 0 14px rgba(138, 64, 245, 0.9);
    animation: eyebrow-dot-pulse 1.8s ease-in-out infinite;
  }

  /* Marquee container with fade mask */
  .marquee-container {
    -webkit-mask-image: linear-gradient(90deg, #0000 0%, #000 70% 75%, #0000 100%);
    mask-image: linear-gradient(90deg, #0000 0%, #000 70% 75%, #0000 100%);
    display: flex;
    align-items: center;
  }

  /* The scrolling track */
  .marquee-track {
    display: flex;
    gap: 1.25rem;
    animation: marquee-scroll 40s linear infinite;
    width: max-content;
  }

  /* Keyframes: slide the entire track left by exactly one set width */
  @keyframes marquee-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      /* 6 cards × (280px + 20px gap) = 1800px */
      transform: translateX(-1800px);
    }
  }

  @keyframes eyebrow-pulse {
    0%,
    100% {
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.08),
        0 0 0 1px rgba(138, 64, 245, 0.08),
        0 14px 40px rgba(0, 0, 0, 0.28);
      transform: translateY(0);
    }
    50% {
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.1),
        0 0 0 1px rgba(138, 64, 245, 0.16),
        0 0 28px rgba(138, 64, 245, 0.18),
        0 16px 44px rgba(0, 0, 0, 0.3);
      transform: translateY(-1px);
    }
  }

  @keyframes eyebrow-dot-pulse {
    0%,
    100% {
      opacity: 0.82;
      transform: scale(1);
      box-shadow: 0 0 10px rgba(138, 64, 245, 0.55);
    }
    50% {
      opacity: 1;
      transform: scale(1.18);
      box-shadow: 0 0 18px rgba(138, 64, 245, 0.95);
    }
  }

  /* Pause on hover for accessibility */
  /* .marquee-container:hover .marquee-track {
    animation-play-state: paused;
  } */
</style>

<script is:inline>
  function initHeroTracking() {
    const browseCoursesBtn = document.getElementById('browse-courses-btn');
    const howItWorksBtn = document.getElementById('how-it-works-btn');

    browseCoursesBtn?.addEventListener('click', () => {
      window.posthog?.capture('cohort_cta_clicked', {
        location: 'hero_section'
      });
    });

    howItWorksBtn?.addEventListener('click', () => {
      window.posthog?.capture('career_paths_clicked', {
        location: 'hero_section'
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroTracking);
  } else {
    initHeroTracking();
  }
</script>
