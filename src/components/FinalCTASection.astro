---
import { AI_COHORT_PATH, aiCohort, formatNaira } from '../data/aiCohort';
---

<section class="bg-[#1A0533] py-24 md:py-32 px-6 md:px-12 lg:px-24 text-center">
  <div class="max-w-3xl mx-auto">
    <p class="text-white/50 text-xs font-semibold tracking-widest uppercase mb-8">
      Starts {aiCohort.startDateLabel} &nbsp;·&nbsp; {aiCohort.durationWeeks} weeks &nbsp;·&nbsp; {formatNaira(aiCohort.fullPaymentPrice)} in full &nbsp;·&nbsp; {aiCohort.prerequisite} required
    </p>

    <h2 class="text-4xl md:text-5xl font-extrabold text-white leading-tight mb-5">
      Build and ship real AI applications in {aiCohort.durationWeeks} weeks.
    </h2>

    <p class="text-white/60 text-xl leading-relaxed mb-10">
      Join Build and Ship AI Applications with Python and move from simple LLM calls to building, evaluating and presenting a real AI application.
    </p>

    <a
      href={AI_COHORT_PATH}
      class="inline-flex items-center gap-2 bg-[#8A40F5] hover:bg-[#7434D8] text-white font-semibold px-10 py-4 rounded-full text-lg transition-colors focus:outline-none focus:ring-2 focus:ring-[#8A40F5] focus:ring-offset-2 focus:ring-offset-[#1A0533]"
    >
      Join the October Cohort
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </a>

    <a href="#programme-waitlist" class="inline-block text-white/55 hover:text-white text-sm mt-6 underline underline-offset-4">
      Can&rsquo;t join in October? Get notified about the next cohort.
    </a>
  </div>
</section>
