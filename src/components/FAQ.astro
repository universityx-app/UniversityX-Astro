---
const faqs = [
  {
    question: 'How does UniversityX work?',
    answer:
      'UniversityX helps you learn through practical courses, live cohorts and 1-on-1 support. You practise through projects and real-world work, get feedback, and build experience you can show.',
  },
  {
    question: 'Do I need to join a cohort to learn on UniversityX?',
    answer:
      'No. You can learn at your own pace, join a structured cohort, or work 1-on-1 with an instructor. Choose the format that fits your goals, schedule and the level of support you need.',
  },
  {
    question: 'What makes UniversityX different from other online learning platforms?',
    answer:
      'UniversityX is built around doing, not just watching. You learn through projects, case studies, scenarios and practical work, with opportunities for feedback, mentorship and immersive learning experiences.',
  },
  {
    question: 'What happens after I finish learning?',
    answer:
      'You can take the next step with GetHiredX, where you can find relevant jobs, improve and submit applications with AI, practise interviews, and build a talent profile that shows employers what you can do beyond your CV.',
  },
  {
    question: 'Is UniversityX only for beginners?',
    answer:
      'No. UniversityX is designed for people at different stages. You can start with foundational courses or move into more advanced learning, projects and guided support depending on your experience and goals.',
  },
];
---

<section id="faq" class="scroll-mt-28 bg-white py-20 md:py-28">
  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-16 xl:px-24">
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-20">
      <div class="lg:col-span-2">
        <h2 class="text-4xl md:text-5xl font-extrabold leading-tight text-[#1A0533]">
          Frequently Asked
          <br />
          <em class="font-['Playfair_Display',serif] font-bold">Questions</em>
        </h2>
        <p class="mt-6 text-lg text-gray-500 leading-relaxed max-w-sm">
          Quick answers about learning, support and what comes next at UniversityX.
        </p>
      </div>

      <div class="lg:col-span-3 space-y-4" id="faq-accordion">
        {faqs.map((faq, index) => (
          <div class="faq-item rounded-2xl bg-[#F9F8F3] overflow-hidden" data-faq-index={index}>
            <button
              type="button"
              class="faq-trigger flex w-full items-center justify-between gap-4 px-6 py-5 text-left cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#8A40F5] focus:ring-inset"
              aria-expanded={index === 0 ? 'true' : 'false'}
            >
              <span class="text-lg md:text-xl font-semibold text-[#1A0533]">{faq.question}</span>
              <span class="faq-icon relative flex-shrink-0 w-10 h-10 rounded-full flex items-center justify-center transition-colors duration-300">
                <svg class="faq-icon-plus w-5 h-5 text-[#1A0533] transition-opacity duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="12" y1="5" x2="12" y2="19" />
                  <line x1="5" y1="12" x2="19" y2="12" />
                </svg>
                <svg class="faq-icon-minus absolute inset-0 m-auto w-5 h-5 text-white transition-opacity duration-300 opacity-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12" />
                </svg>
              </span>
            </button>
            <div class="faq-content">
              <div class="faq-content-inner">
                <p class="px-6 pb-6 text-base md:text-lg text-gray-500 leading-relaxed">{faq.answer}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .faq-content {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 350ms ease;
  }

  .faq-content-inner {
    overflow: hidden;
  }

  .faq-item.is-open .faq-content {
    grid-template-rows: 1fr;
  }

  .faq-item.is-open .faq-icon {
    background-color: #1A0533;
  }

  .faq-item.is-open .faq-icon-plus {
    opacity: 0;
  }

  .faq-item.is-open .faq-icon-minus {
    opacity: 1;
  }
</style>

<script>
  function initFaqAccordion() {
    const accordion = document.getElementById('faq-accordion');
    if (!accordion) return;

    const items = accordion.querySelectorAll('.faq-item');
    const triggers = accordion.querySelectorAll('.faq-trigger');

    items[0]?.classList.add('is-open');

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const parentItem = trigger.closest('.faq-item');
        if (!parentItem) return;

        const isCurrentlyOpen = parentItem.classList.contains('is-open');

        items.forEach((item) => {
          item.classList.remove('is-open');
          item.querySelector('.faq-trigger')?.setAttribute('aria-expanded', 'false');
        });

        if (!isCurrentlyOpen) {
          parentItem.classList.add('is-open');
          trigger.setAttribute('aria-expanded', 'true');

          const faqIndex = parentItem.getAttribute('data-faq-index');
          const questionText = trigger.querySelector('span')?.textContent || '';
          window.posthog?.capture('faq_item_expanded', {
            faq_index: parseInt(faqIndex || '0', 10),
            question: questionText
          });
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFaqAccordion);
  } else {
    initFaqAccordion();
  }
</script>
