---
import CohortCard from './CohortCard.astro';
---

<section class="bg-[#1A0533] px-6 py-16 text-white md:px-12 md:py-20 lg:px-24" aria-labelledby="upcoming-cohort-heading">
  <div class="mx-auto max-w-7xl">
    <div class="grid grid-cols-1 items-end gap-7 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">
      <div>
        <p class="inline-flex items-center rounded-full border border-white/10 bg-white/7 px-4 py-2 text-xs font-semibold uppercase tracking-widest text-white/60">Upcoming Cohort</p>
        <h2 id="upcoming-cohort-heading" class="mt-5 max-w-3xl text-3xl font-extrabold leading-tight md:text-5xl">Learn with more structure, support and feedback.</h2>
      </div>
      <p class="max-w-xl text-lg leading-relaxed text-white/65 md:text-xl">Cohorts give you the structure and accountability to stay on track. Learn with others, get live support from instructors, and receive personalised feedback through code reviews, project reviews and mentorship.</p>
    </div>
    <CohortCard className="mt-16" />
  </div>
</section>
