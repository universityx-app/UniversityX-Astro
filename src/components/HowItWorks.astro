---
const cards = [
  {
    title: 'Build real projects',
    copy: 'Work from practical briefs, meet deadlines and produce visible outputs throughout the cohort.',
    image: '/images/community.jpg',
    alt: 'UniversityX learners working together',
  },
  {
    title: 'Learn with expert guidance',
    copy: 'Join live sessions, ask questions, receive feedback and understand the reasoning behind better technical decisions.',
    image: '/videos/live-lessons.gif',
    alt: 'Live learning session preview',
  },
  {
    title: 'Explain what you built',
    copy: 'PrepCoach asks you to explain your work, defend your decisions and identify gaps that a finished project alone cannot reveal.',
    image: '/images/ai-robot-2.png',
    alt: 'AI assistant illustration',
  },
  {
    title: 'Daily Accountability',
    copy: 'Progress is based on visible output, not logging in or passively watching lessons.',
    image: '/images/gamification.png',
    alt: 'Progress tracking illustration',
  },
];
---

<section class="bg-white py-20 md:py-28 scroll-mt-28" id="how-it-works">
  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-16 xl:px-24">
    <div class="max-w-3xl mx-auto text-center mb-14">
      <h2 class="text-3xl md:text-5xl font-extrabold leading-tight text-[#1A0533]">
        How UniversityX
        <em class="font-['Playfair_Display',serif] font-bold"> Works</em>
      </h2>
      <p class="mt-5 text-lg md:text-xl leading-relaxed text-gray-600">
        UniversityX combines real work, human guidance and AI-powered accountability to help you build practical skills and prove that you understand them.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {cards.map((card) => (
        <article class="bg-[#F5F2EB] rounded-3xl flex flex-col overflow-hidden">
          <div class="p-7">
            <h3 class="text-xl md:text-2xl font-bold text-[#1A0533]">{card.title}</h3>
            <p class="mt-3 text-gray-600 text-base md:text-lg leading-relaxed">{card.copy}</p>
          </div>
          <div class="mt-auto px-4 pb-4">
            <img
              src={card.image}
              alt={card.alt}
              class="w-full h-44 object-cover rounded-2xl"
              loading="lazy"
            />
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
