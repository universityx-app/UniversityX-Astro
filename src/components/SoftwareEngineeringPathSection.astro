---
const courseHref = '/paths/software-engineering/build-your-first-ai-application';

const courses = [
  {
    number: '01',
    title: 'Build and Ship Agentic AI Applications in 6 Weeks',
    status: 'Registration Open',
    meta: '6 weeks · Starts 17 August 2026',
    originalPrice: '₦30,000',
    price: '₦25,000',
    href: courseHref,
  },
  {
    number: '02',
    title: 'AI Engineering Deep Dive',
    status: 'Coming Soon',
    meta: 'RAG · Embeddings · Evaluation',
  },
  {
    number: '03',
    title: 'Full-Stack AI Development',
    status: 'Coming Soon',
  },
  {
    number: '04',
    title: 'Agent Orchestration and Production',
    status: 'Coming Soon',
  },
  {
    number: '05',
    title: 'System Design for AI Systems',
    status: 'Coming Soon',
  },
];
---

<section class="bg-white py-20 md:py-28 px-6 md:px-12 lg:px-24">
  <div class="max-w-6xl mx-auto">
    <div class="max-w-3xl mb-12">
      <p class="inline-flex items-center gap-2 rounded-full border border-[#1A0533]/10 bg-[#F5F2EB] px-4 py-2 text-xs font-semibold text-[#1A0533]/50 tracking-widest uppercase mb-6">
        Software Engineering
      </p>
      <h2 class="text-3xl md:text-5xl font-extrabold text-[#1A0533] leading-tight mb-4">
        The AI-Native Software Engineering Path
      </h2>
      <p class="text-gray-600 text-lg md:text-xl leading-relaxed">
        A stackable learning path for developers who want to build real software with AI while developing the technical depth to understand, evaluate and improve what AI produces.
      </p>
    </div>

    <div class="space-y-4">
      {courses.map((course) => {
        const content = (
          <div class={`rounded-2xl border p-6 md:p-7 ${course.href ? 'border-[#8A40F5] bg-[#F8F4FF]' : 'border-gray-100 bg-[#F9F8F3]'}`}>
            <div class="flex flex-col md:flex-row md:items-start gap-4 md:gap-8">
              <span class={`text-4xl font-extrabold leading-none ${course.href ? 'text-[#8A40F5]/35' : 'text-[#1A0533]/20'}`}>{course.number}</span>
              <div class="flex-1">
                <div class="flex flex-wrap items-center gap-3 mb-2">
                  <h3 class="text-xl md:text-2xl font-bold text-[#1A0533]">{course.title}</h3>
                  <span class={`rounded-full px-3 py-1 text-xs font-semibold ${course.href ? 'bg-[#8A40F5] text-white' : 'bg-[#1A0533]/10 text-[#1A0533]/55'}`}>{course.status}</span>
                </div>
                {course.meta && (
                  <div class="flex flex-wrap items-center gap-2 text-gray-500 text-base md:text-lg">
                    <span>{course.meta}</span>
                    {course.originalPrice && (
                      <>
                        <span>·</span>
                        <span class="font-semibold text-[#1A0533]">{course.price}</span>
                        <span class="text-gray-400 line-through">{course.originalPrice}</span>
                      </>
                    )}
                  </div>
                )}
              </div>
            </div>
          </div>
        );

        return course.href ? (
          <a href={course.href} class="block focus:outline-none focus:ring-2 focus:ring-[#8A40F5] rounded-2xl">
            {content}
          </a>
        ) : content;
      })}
    </div>

    <p class="mt-8 text-gray-500 text-base md:text-lg leading-relaxed max-w-3xl">
      The full path is developed progressively. Future courses are shaped by the actual knowledge gaps observed in earlier cohorts.
    </p>

    <div class="mt-8 flex flex-wrap gap-4">
      <a href={courseHref} class="inline-flex items-center justify-center rounded-full bg-[#8A40F5] text-white font-semibold px-7 py-3.5 hover:bg-[#7434D8] transition-colors focus:outline-none focus:ring-2 focus:ring-[#8A40F5] focus:ring-offset-2">
        Join the 17 August Cohort
      </a>
      <a href="#programme-waitlist" class="inline-flex items-center justify-center rounded-full border border-[#1A0533]/20 text-[#1A0533] font-semibold px-7 py-3.5 hover:border-[#8A40F5] hover:text-[#8A40F5] transition-colors focus:outline-none focus:ring-2 focus:ring-[#8A40F5]">
        Explore other programs
      </a>
    </div>
  </div>
</section>
