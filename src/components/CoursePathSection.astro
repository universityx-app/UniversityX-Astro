---
const comingSoonCourses = [
  { title: "System Design for Working Developers", desc: "Learn to design systems that scale — and explain every decision." },
  { title: "Frontend Architecture (Beyond the Tutorial)", desc: "Stop writing code that works. Start writing code that lasts." },
  { title: "Backend Engineering Fundamentals", desc: "Databases, APIs, and the things most bootcamps skip entirely." },
  { title: "DevOps for Product Engineers", desc: "CI/CD, containers, and deploying with confidence." },
  { title: "Engineering for Senior Roles", desc: "The technical and non-technical skills that separate mid-level from senior." },
];
---

<section class="bg-white py-24 px-6 md:px-12 lg:px-24">
  <div class="max-w-4xl mx-auto">

    <!-- Header -->
    <div class="mb-4">
      <p class="inline-flex items-center gap-2 rounded-full border border-[#1A0533]/10 bg-[#F5F2EB] px-4 py-2 text-xs font-semibold text-[#1A0533]/50 tracking-widest uppercase mb-6">
        The path
      </p>
      <h2 class="text-3xl md:text-4xl font-extrabold text-[#1A0533] leading-tight mb-3">
        A curriculum built in public.
      </h2>
      <p class="text-gray-500 text-lg">One course is live now. Five are coming. We're building this alongside you.</p>
    </div>

    <div class="mt-12 flex flex-col gap-4">

      <!-- Live course card -->
      <div class="rounded-2xl border-2 border-[#8A40F5] bg-white p-7 md:p-8" style="box-shadow: 0 0 32px rgba(138, 64, 245, 0.08);">
        <div class="flex flex-wrap items-start justify-between gap-4 mb-5">
          <span class="bg-[#8A40F5] text-white rounded-full px-3 py-1 text-xs font-semibold tracking-wide uppercase">Live now</span>
          <div class="flex items-center gap-4 text-sm text-gray-400">
            <span>4 weeks</span>
            <span class="w-1 h-1 rounded-full bg-gray-300"></span>
            <span>Starting July 7</span>
            <span class="w-1 h-1 rounded-full bg-gray-300"></span>
            <span class="text-[#1A0533] font-semibold">₦25,000</span>
          </div>
        </div>
        <h3 class="text-xl md:text-2xl font-bold text-[#1A0533] mb-3">Build Your First AI Application</h3>
        <p class="text-gray-500 text-base leading-relaxed mb-6">
          Ship a real AI-powered product from scratch. Understand every layer — from prompting to backend to deployment. Cohort-based, live sessions, PrepCoach-guided.
        </p>
        <div class="flex flex-wrap items-center gap-4">
          <a href="/courses/build-your-first-ai-application" class="inline-flex items-center gap-2 bg-[#8A40F5] text-white font-semibold px-7 py-3.5 rounded-full text-base transition-colors hover:bg-[#7434D8]">
            Join Cohort 1
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <span class="text-gray-400 text-sm">20 spots · Cohort 1</span>
        </div>
      </div>

      <!-- Coming soon courses -->
      {comingSoonCourses.map((course) => (
        <div class="rounded-2xl border border-gray-100 bg-[#F9F8F3] p-6 md:p-7 flex items-start gap-5">
          <span class="mt-0.5 bg-gray-200/80 text-gray-400 rounded-full px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wide shrink-0 whitespace-nowrap">Soon</span>
          <div>
            <h4 class="font-bold text-[#1A0533]/70 text-base mb-1">{course.title}</h4>
            <p class="text-gray-400 text-sm leading-relaxed">{course.desc}</p>
          </div>
        </div>
      ))}

    </div>

  </div>
</section>
