---
const digitalSkillsCategories = [
  {
    id: "software-engineering",
    name: "Software Engineering",
    subRoles: [
      "Applied AI Engineer",
      "Backend Engineer",
      "Full Stack Developer",
      "Frontend Developer",
    ],
  },
  {
    id: "ai-data-science",
    name: "AI & Data Science",
    subRoles: [
      "AI Engineer",
      "Machine Learning Engineer",
      "Data Scientist",
      "Business Intelligence Analyst",
    ],
  },
  {
    id: "business",
    name: "Business",
    subRoles: [
      "Management Consultant",
      "Financial Analyst",
      "Operations Associate",
      "Chief of Staff",
    ],
  },
  {
    id: "product",
    name: "Product",
    subRoles: [
      "Product Manager",
      "Product Analyst",
      "Product Marketer",
      "Product Engineer",
    ],
  },
  {
    id: "marketing",
    name: "Marketing",
    subRoles: [
      "Marketing Analyst",
      "Growth Marketer",
      "Digital Marketing Specialist",
      "Product Marketer",
      "Content Marketer",
    ],
  },
  {
    id: "sales",
    name: "Sales",
    subRoles: [
      "Sales Development",
      "Account Executive",
      "Customer Success",
      "Business Development",
      "Solutions Consultant",
    ],
  },
  {
    id: "design",
    name: "Design",
    subRoles: [
      "Product Designer",
      "User Experience Designer",
      "Design Engineer",
      "Systems Designer",
    ],
  },
  {
    id: "security",
    name: "Security",
    subRoles: [
      "AI Security Analyst",
      "Security Engineer",
      "Cybersecurity Analyst",
      "SOC Analyst",
      "GRC Analyst",
    ],
  },
];

const valueProps = [
  {
    title: "Create less from scratch",
    description: "Access structured learning resources, project briefs, and assessments you can adapt to your teaching style.",
    icon: "M4 19.5A2.5 2.5 0 0 1 6.5 17H20 M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z",
  },
  {
    title: "Give learners more than videos",
    description: "Combine live teaching with practical projects, AI-powered practice, feedback, and guidance that helps learners apply what they're learning.",
    icon: "M9 3H5a2 2 0 0 0-2 2v4 M15 3h4a2 2 0 0 1 2 2v4 M21 15v4a2 2 0 0 1-2 2h-4 M9 21H5a2 2 0 0 1-2-2v-4 M8 12l3 3 5-6",
  },
  {
    title: "Earn from your expertise",
    description: "Host paid workshops and live courses around topics you know well. We'll work with you on the course structure, pricing, and delivery.",
    icon: "M12 2v20 M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6",
  },
  {
    title: "Grow with us",
    description: "Bring your community, reach new learners, and explore opportunities to teach again. We'll work together on promoting your programmes.",
    icon: "M3 17l6-6 4 4 8-10 M15 5h6v6",
  },
];

const teachingOptions = [
  {
    number: "01",
    title: "Teach an existing course",
    description: "Choose from our growing library of structured courses. Adapt the resources, bring your own experience, and lead learners through live classes and projects.",
  },
  {
    number: "02",
    title: "Create something with us",
    description: "Have an idea for a course or workshop? We'll help you turn it into a structured learning experience, from curriculum planning to projects and materials.",
  },
  {
    number: "03",
    title: "Bring your own course",
    description: "Already teaching? Bring your existing programme to UniversityX and explore how our platform and AI-powered learning tools can support your learners.",
  },
];

const containerClass = 'mx-auto max-w-7xl px-6 md:px-12 lg:px-16';
const headingClass = 'text-3xl font-extrabold leading-tight tracking-tight text-[#1A0533] md:text-4xl lg:text-5xl';
const copyClass = 'text-lg leading-relaxed text-gray-600';
const buttonClass = 'inline-flex items-center justify-center gap-3 rounded-full bg-[#8A40F5] px-7 py-3.5 text-base font-semibold text-white transition-colors hover:bg-[#7434D8] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#8A40F5] motion-reduce:transition-none';
---

<section class="border-b border-gray-200/60 bg-[#FBF8F1] pt-12 pb-16 md:pt-16 md:pb-20" aria-labelledby="teach-title">
  <div class="mx-auto max-w-4xl px-6 text-center md:px-12">
    <p class="mb-6 inline-flex rounded-full bg-[#8A40F5]/10 px-4 py-2 text-xs font-bold uppercase tracking-wider text-purple-800">Teach on UniversityX</p>
    <h1 id="teach-title" class="text-4xl font-extrabold leading-tight tracking-tight text-[#1A0533] sm:text-5xl md:text-6xl">
      Your expertise deserves <em class="font-['Playfair_Display',serif] font-bold">a bigger classroom.</em>
    </h1>
    <div class="mx-auto mt-6 max-w-2xl space-y-4 text-lg leading-relaxed text-gray-600 md:text-xl">
      <p>Turn what you know into practical workshops and live courses. Bring your own course, build one with us, or teach using our existing learning resources. 
        We'll help with the learning experience, technology, and setup, so you can focus on what you do best: teaching and sharing your expertise.</p>
    </div>
    <a id="hero-apply-btn" href="#teaching-options" class:list={[buttonClass, 'mt-8 w-full sm:w-auto']}>
      Explore Teaching with Us
      <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14m-6-6 6 6 6-6" /></svg>
    </a>
  </div>
</section>

<section class="bg-white py-16 md:py-20" aria-labelledby="why-teach-title">
  <div class:list={[containerClass]}>
    <div class="mx-auto max-w-3xl text-center">
      <p class="mb-4 text-xs font-bold uppercase tracking-wider text-purple-800">Why teach on UniversityX?</p>
      <h2 id="why-teach-title" class:list={[headingClass]}>Less time preparing. <span class="block">More time teaching.</span></h2>
      <div class:list={[copyClass, 'mx-auto mt-5 max-w-2xl space-y-4']}>
        <p>Creating a great course takes work. From planning lessons to preparing projects and supporting learners, there's a lot to manage.
          We're building UniversityX to make that process easier.</p>
      </div>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-2 md:mt-12">
      {valueProps.map((item) => (
        <article class="rounded-2xl bg-[#F5F2EB] p-7 md:p-8">
          <div class="mb-5 flex size-12 items-center justify-center rounded-xl bg-white text-[#8A40F5]">
            <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={item.icon} /></svg>
          </div>
          <h3 class="text-xl font-bold leading-snug text-[#1A0533] md:text-2xl">{item.title}</h3>
          <p class:list={[copyClass, 'mt-3']}>{item.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section id="teaching-options" class="scroll-mt-24 bg-[#FBF8F1] py-16 md:py-20" aria-labelledby="teaching-options-title">
  <div class:list={[containerClass]}>
    <div class="max-w-3xl">
      <h2 id="teaching-options-title" class:list={[headingClass]}>Three ways to teach. Your choice.</h2>
      <p class:list={[copyClass, 'mt-5']}>You don't have to change how you teach to work with UniversityX.</p>
    </div>
    <div class="mt-10 grid gap-6 lg:grid-cols-3">
      {teachingOptions.map((option) => (
        <article class="rounded-2xl border border-gray-200/70 bg-white p-7 md:p-8">
          <span class="mb-6 inline-flex size-11 items-center justify-center rounded-full bg-[#8A40F5]/10 text-sm font-bold text-purple-800" aria-hidden="true">{option.number}</span>
          <h3 class="text-xl font-bold leading-snug text-[#1A0533] md:text-2xl">{option.title}</h3>
          <p class:list={[copyClass, 'mt-4']}>{option.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ===== APPLICATION FORM SECTION ===== -->
<section id="apply-to-teach" class="scroll-mt-24 bg-[#FBF8F1] py-16 md:py-20" aria-labelledby="application-title">
  <div class="max-w-4xl mx-auto px-6">
    <div class="mb-10 text-center">
      <h2 id="application-title" class:list={[headingClass]}>Tell us about yourself</h2>
    </div>

    <!-- Success message (hidden by default) -->
    <div id="apply-success" class="hidden bg-white rounded-3xl shadow-xl p-8 md:p-12 text-center border border-gray-100">
      <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
        <svg class="w-8 h-8 text-green-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 6L9 17l-5-5" />
        </svg>
      </div>
      <h3 class="text-2xl md:text-3xl font-extrabold text-[#1A0533] mb-3">Application Received!</h3>
      <p class="text-gray-600 text-base md:text-lg leading-relaxed max-w-lg mx-auto">
        Thank you for applying to teach on UniversityX. Our team will review your details and get back to you with next steps.
      </p>
    </div>

    <!-- Form Card -->
    <div id="apply-form-card" class="bg-white rounded-3xl shadow-xl border border-gray-100 p-7 sm:p-10 md:p-12">
      <form id="teach-application-form" novalidate class="space-y-7">
        <!-- Section: Basic Information -->
        <div class="space-y-5">
          <div class="flex items-center gap-3">
            <span class="text-xs font-bold tracking-wider uppercase text-[#D4A853]">01. Personal Details</span>
            <div class="flex-1 h-px bg-gray-100"></div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <!-- Full Name -->
            <div>
              <label for="apply-name" class="block text-sm font-semibold text-[#1A0533] mb-2">
                Full Name <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                id="apply-name"
                name="full_name"
                placeholder="e.g. Alex Morgan"
                required
                class="apply-input w-full bg-gray-50 rounded-xl px-4 py-3 text-sm text-gray-800 placeholder-gray-400 border border-gray-200/70 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#8A40F5] focus:border-[#8A40F5] transition-all duration-200"
              />
              <p id="apply-name-error" class="text-red-500 text-xs mt-1.5 hidden">Please enter your full name.</p>
            </div>

            <!-- Email -->
            <div>
              <label for="apply-email" class="block text-sm font-semibold text-[#1A0533] mb-2">
                Email Address <span class="text-red-500">*</span>
              </label>
              <input
                type="email"
                id="apply-email"
                name="email"
                placeholder="alex@example.com"
                required
                class="apply-input w-full bg-gray-50 rounded-xl px-4 py-3 text-sm text-gray-800 placeholder-gray-400 border border-gray-200/70 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#8A40F5] focus:border-[#8A40F5] transition-all duration-200"
              />
              <p id="apply-email-error" class="text-red-500 text-xs mt-1.5 hidden">Please enter a valid email address.</p>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <!-- LinkedIn / Portfolio -->
            <div>
              <label for="apply-linkedin" class="block text-sm font-semibold text-[#1A0533] mb-2">
                LinkedIn Profile or Portfolio URL <span class="text-red-500">*</span>
              </label>
              <input
                type="url"
                id="apply-linkedin"
                name="linkedin"
                placeholder="https://linkedin.com/in/yourprofile or portfolio"
                required
                class="apply-input w-full bg-gray-50 rounded-xl px-4 py-3 text-sm text-gray-800 placeholder-gray-400 border border-gray-200/70 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#8A40F5] focus:border-[#8A40F5] transition-all duration-200"
              />
              <p id="apply-linkedin-error" class="text-red-500 text-xs mt-1.5 hidden">Please provide a valid profile or portfolio link.</p>
            </div>

            <!-- Location / Country Input -->
            <div>
              <label for="apply-country" class="block text-sm font-semibold text-[#1A0533] mb-2">
                Location (Country) <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                id="apply-country"
                name="country"
                placeholder="e.g. Nigeria, United States, United Kingdom..."
                required
                class="apply-input w-full bg-gray-50 rounded-xl px-4 py-3 text-sm text-gray-800 placeholder-gray-400 border border-gray-200/70 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#8A40F5] focus:border-[#8A40F5] transition-all duration-200"
              />
              <p id="apply-country-error" class="text-red-500 text-xs mt-1.5 hidden">Please enter your country.</p>
            </div>
          </div>

          <!-- Current Role / Experience -->
          <div>
            <label for="apply-role" class="block text-sm font-semibold text-[#1A0533] mb-2">
              Current Role & Experience <span class="text-red-500">*</span>
            </label>
            <textarea
              id="apply-role"
              name="current_role"
              rows="2"
              placeholder="e.g. Senior Machine Learning Engineer at Fintech Co (6+ years building production pipelines)"
              required
              class="apply-input w-full bg-gray-50 rounded-xl px-4 py-3 text-sm text-gray-800 placeholder-gray-400 border border-gray-200/70 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#8A40F5] focus:border-[#8A40F5] transition-all duration-200 resize-y"
            ></textarea>
            <p id="apply-role-error" class="text-red-500 text-xs mt-1.5 hidden">Please describe your current role and years of experience.</p>
          </div>
        </div>

        <!-- Section: Teaching Focus & Digital Skills -->
        <div class="space-y-5 pt-4">
          <div class="flex items-center gap-3">
            <span class="text-xs font-bold tracking-wider uppercase text-[#D4A853]">02. Teaching Area & Skills</span>
            <div class="flex-1 h-px bg-gray-100"></div>
          </div>

          <!-- Main Category Selector -->
          <div>
            <label for="category-select" class="block text-sm font-semibold text-[#1A0533] mb-1.5">
              Which area do you want to teach? <span class="text-red-500">*</span>
            </label>
            <p class="text-xs text-gray-500 mb-3">
              Select your primary domain from the 8 digital skills categories below:
            </p>

            <!-- Dropdown selector -->
            <div class="relative">
              <select
                id="category-select"
                name="teaching_category"
                required
                class="apply-input w-full bg-gray-50 rounded-xl px-4 py-3 text-sm text-gray-800 border border-gray-200/70 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#8A40F5] focus:border-[#8A40F5] transition-all duration-200 appearance-none cursor-pointer pr-10 font-medium"
              >
                <option value="" disabled selected>Select a category</option>
                {digitalSkillsCategories.map((cat) => (
                  <option value={cat.id}>{cat.name}</option>
                ))}
              </select>
              <div class="absolute inset-y-0 right-0 flex items-center px-3.5 pointer-events-none text-gray-500">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </div>
            </div>

            <p id="category-error" class="text-red-500 text-xs mt-1.5 hidden">Please select a teaching category.</p>
          </div>

          <!-- Dynamic Sub-roles Checkboxes Container (hidden until a category is picked) -->
          <div id="subroles-container" class="hidden transition-all duration-300">
            <!-- Category-specific panels -->
            {digitalSkillsCategories.map((cat) => (
              <div
                id={`subroles-panel-${cat.id}`}
                class="subroles-panel hidden bg-white rounded-2xl p-4 sm:p-5 border border-[#8A40F5]/20 bg-[#8A40F5]/[0.02]"
              >
                <div class="flex items-center justify-between mb-3">
                  <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-[#8A40F5]"></span>
                    <span class="text-xs font-bold uppercase tracking-wider text-[#1A0533]">
                      {cat.name} Sub-roles:
                    </span>
                  </div>
                  <span class="text-xs text-gray-400">Select all that apply</span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                  {cat.subRoles.map((role) => (
                    <label class="subrole-label flex items-center gap-3 p-3 rounded-xl border border-gray-200 bg-white hover:border-[#8A40F5] hover:bg-white cursor-pointer transition-all duration-150">
                      <input
                        type="checkbox"
                        name="sub_roles"
                        value={`${cat.name}: ${role}`}
                        data-category={cat.id}
                        class="subrole-checkbox w-4 h-4 rounded border-gray-300 text-[#8A40F5] focus:ring-[#8A40F5] cursor-pointer"
                      />
                      <span class="text-xs sm:text-sm font-medium text-gray-800 select-none">
                        {role}
                      </span>
                    </label>
                  ))}
                </div>
              </div>
            ))}

            <p id="subroles-error" class="text-red-500 text-xs mt-1.5 hidden">Please select at least one sub-role.</p>
          </div>
        </div>

        <!-- Section: Experience & Motivation -->
        <div class="space-y-5 pt-4">
          <div class="flex items-center gap-3">
            <span class="text-xs font-bold tracking-wider uppercase text-[#D4A853]">03. Teaching Background</span>
            <div class="flex-1 h-px bg-gray-100"></div>
          </div>

          <!-- Previous Teaching/Mentoring Experience -->
          <div>
            <label for="apply-experience" class="block text-sm font-semibold text-[#1A0533] mb-2">
              Previous Teaching or Mentoring Experience <span class="text-red-500">*</span>
            </label>
            <textarea
              id="apply-experience"
              name="teaching_experience"
              rows="3"
              placeholder="Briefly tell us about any workshops, internal team coaching, guest lectures, bootcamps, or 1-on-1 mentorship you've done..."
              required
              class="apply-input w-full bg-gray-50 rounded-xl px-4 py-3 text-sm text-gray-800 placeholder-gray-400 border border-gray-200/70 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#8A40F5] focus:border-[#8A40F5] transition-all duration-200 resize-y"
            ></textarea>
            <p id="apply-experience-error" class="text-red-500 text-xs mt-1.5 hidden">Please share a brief summary of your teaching/mentoring experience.</p>
          </div>

          <!-- Why do you want to teach on UniversityX? -->
          <div>
            <label for="apply-motivation" class="block text-sm font-semibold text-[#1A0533] mb-2">
              Why do you want to teach on UniversityX? <span class="text-red-500">*</span>
            </label>
            <textarea
              id="apply-motivation"
              name="motivation"
              rows="3"
              placeholder="What motivates you to teach workshops or live courses and help learners build real skills that get them hired?"
              required
              class="apply-input w-full bg-gray-50 rounded-xl px-4 py-3 text-sm text-gray-800 placeholder-gray-400 border border-gray-200/70 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#8A40F5] focus:border-[#8A40F5] transition-all duration-200 resize-y"
            ></textarea>
            <p id="apply-motivation-error" class="text-red-500 text-xs mt-1.5 hidden">Please explain why you'd like to teach on UniversityX.</p>
          </div>

          <!-- Tell us more (optional) -->
          <div>
            <label for="apply-more" class="block text-sm font-semibold text-[#1A0533] mb-2">
              Tell us more <span class="font-normal text-gray-400 text-xs">(optional)</span>
            </label>
            <textarea
              id="apply-more"
              name="more_info"
              rows="3"
              placeholder="Anything else you would like us to know, your teaching style, past courses, or questions..."
              class="apply-input w-full bg-gray-50 rounded-xl px-4 py-3 text-sm text-gray-800 placeholder-gray-400 border border-gray-200/70 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#8A40F5] focus:border-[#8A40F5] transition-all duration-200 resize-y"
            ></textarea>
          </div>
        </div>

        <!-- General Error Banner (if submission fails) -->
        <div id="apply-general-error" class="hidden p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm">
          Something went wrong submitting your application. Please check your connection and try again.
        </div>

        <!-- Submit Button -->
        <div class="pt-2">
          <button
            type="submit"
            id="apply-submit-btn"
            class="w-full bg-[#8A40F5] hover:bg-[#7434D8] text-white font-bold text-base rounded-full py-4 px-8 transition-all duration-200 shadow-md hover:shadow-lg flex items-center justify-center gap-2 cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#8A40F5] focus:ring-offset-2"
          >
            <span id="submit-btn-text">Submit Application</span>
            <svg id="submit-btn-arrow" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
            <svg id="submit-btn-spinner" class="hidden w-5 h-5 animate-spin text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </button>
          <p class="text-center text-xs text-gray-400 mt-3">
            By applying, you agree to our <a href="/privacy-policy" class="underline hover:text-gray-600">Privacy Policy</a> and <a href="/terms-of-service" class="underline hover:text-gray-600">Terms of Service</a>.
          </p>
        </div>
      </form>
    </div>
  </div>
</section>

<section class="bg-white py-16 md:py-20" aria-labelledby="teaching-formats-title">
  <div class:list={[containerClass, 'grid gap-8 lg:grid-cols-2 lg:gap-16']}>
    <h2 id="teaching-formats-title" class:list={[headingClass, 'max-w-lg']}>Start with a workshop. <em class="font-['Playfair_Display',serif] font-bold">Or go further.</em></h2>
    <div class:list={[copyClass, 'max-w-2xl space-y-5']}>
      <p>You don't need to commit to teaching for months.</p>
      <p>Host a practical workshop, run a short course, or guide learners through a more comprehensive live programme.</p>
      <p>We'll work with you to choose a format that makes sense for your expertise, audience, and availability.</p>
    </div>
  </div>
</section>

<section class="bg-[#F5F2EB] py-16 md:py-20" aria-labelledby="instructor-profile-title">
  <div class:list={[containerClass, 'grid gap-8 lg:grid-cols-2 lg:gap-16']}>
    <h2 id="instructor-profile-title" class:list={[headingClass, 'max-w-lg']}>Who we're looking for</h2>
    <div class:list={[copyClass, 'max-w-2xl space-y-5']}>
      <p>We're bringing together experienced professionals, educators, and creators who have valuable knowledge to share.</p>
      <p>Whether you've already taught paid courses, run workshops, mentored professionals, or built a community around your expertise, we'd love to explore what we could create together.</p>
      <p>We're especially interested in people who enjoy teaching practical skills, helping learners build real projects, and bringing their own experience into the classroom.</p>
    </div>
  </div>
</section>

<!-- ===== SCRIPTS ===== -->
<script>
  import PocketBase from 'pocketbase';

  declare global {
    interface Window {
      posthog?: any;
    }
  }

  function initTeachPage() {
    const form = document.getElementById('teach-application-form') as HTMLFormElement | null;
    const formCard = document.getElementById('apply-form-card');
    const successMsg = document.getElementById('apply-success');
    const categorySelect = document.getElementById('category-select') as HTMLSelectElement | null;
    const subrolesContainer = document.getElementById('subroles-container');
    const subrolesPanels = document.querySelectorAll<HTMLElement>('.subroles-panel');
    const subrolesError = document.getElementById('subroles-error');
    const categoryError = document.getElementById('category-error');
    const generalError = document.getElementById('apply-general-error');

    if (!form || !categorySelect) return;

    // --- Category Selection Handling ---
    function selectCategory(categoryId: string) {
      if (!categoryId) {
        if (subrolesContainer) subrolesContainer.classList.add('hidden');
        subrolesPanels.forEach((panel) => panel.classList.add('hidden'));
        return;
      }

      // Show container only when category is picked
      if (subrolesContainer) subrolesContainer.classList.remove('hidden');

      // Toggle panels
      subrolesPanels.forEach((panel) => {
        const isTarget = panel.id === `subroles-panel-${categoryId}`;
        panel.classList.toggle('hidden', !isTarget);
      });

      if (categoryError) categoryError.classList.add('hidden');
      if (subrolesError) subrolesError.classList.add('hidden');
    }

    categorySelect.addEventListener('change', (e) => {
      const val = (e.target as HTMLSelectElement).value;
      selectCategory(val);
    });

    // Checkbox styling toggle
    const subroleCheckboxes = form.querySelectorAll<HTMLInputElement>('.subrole-checkbox');
    subroleCheckboxes.forEach((cb) => {
      cb.addEventListener('change', () => {
        const label = cb.closest('.subrole-label') as HTMLElement | null;
        if (label) {
          if (cb.checked) {
            label.classList.add('border-[#8A40F5]', 'bg-[#8A40F5]/5');
            label.classList.remove('border-gray-200', 'bg-white');
          } else {
            label.classList.remove('border-[#8A40F5]', 'bg-[#8A40F5]/5');
            label.classList.add('border-gray-200', 'bg-white');
          }
        }
        if (subrolesError) subrolesError.classList.add('hidden');
      });
    });

    // --- Validation logic ---
    const nameInput = document.getElementById('apply-name') as HTMLInputElement | null;
    const emailInput = document.getElementById('apply-email') as HTMLInputElement | null;
    const linkedinInput = document.getElementById('apply-linkedin') as HTMLInputElement | null;
    const countryInput = document.getElementById('apply-country') as HTMLInputElement | null;
    const roleInput = document.getElementById('apply-role') as HTMLTextAreaElement | null;
    const experienceInput = document.getElementById('apply-experience') as HTMLTextAreaElement | null;
    const motivationInput = document.getElementById('apply-motivation') as HTMLTextAreaElement | null;
    const moreInfoInput = document.getElementById('apply-more') as HTMLTextAreaElement | null;

    const nameError = document.getElementById('apply-name-error');
    const emailError = document.getElementById('apply-email-error');
    const linkedinError = document.getElementById('apply-linkedin-error');
    const countryError = document.getElementById('apply-country-error');
    const roleError = document.getElementById('apply-role-error');
    const experienceError = document.getElementById('apply-experience-error');
    const motivationError = document.getElementById('apply-motivation-error');

    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    function validateField(input: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null, errorEl: HTMLElement | null, isValid: boolean): boolean {
      if (!input || !errorEl) return isValid;
      errorEl.classList.toggle('hidden', isValid);
      input.classList.toggle('border-red-400', !isValid);
      input.classList.toggle('focus:ring-red-400', !isValid);
      return isValid;
    }

    if (nameInput) nameInput.addEventListener('blur', () => validateField(nameInput, nameError, nameInput.value.trim().length > 0));
    if (emailInput) emailInput.addEventListener('blur', () => validateField(emailInput, emailError, emailRegex.test(emailInput.value.trim())));
    if (linkedinInput) linkedinInput.addEventListener('blur', () => validateField(linkedinInput, linkedinError, linkedinInput.value.trim().length > 0));
    if (countryInput) countryInput.addEventListener('blur', () => validateField(countryInput, countryError, countryInput.value.trim().length > 0));
    if (roleInput) roleInput.addEventListener('blur', () => validateField(roleInput, roleError, roleInput.value.trim().length > 0));
    if (experienceInput) experienceInput.addEventListener('blur', () => validateField(experienceInput, experienceError, experienceInput.value.trim().length > 0));
    if (motivationInput) motivationInput.addEventListener('blur', () => validateField(motivationInput, motivationError, motivationInput.value.trim().length > 0));

    // --- Form Submit ---
    const submitBtn = document.getElementById('apply-submit-btn') as HTMLButtonElement | null;
    const btnText = document.getElementById('submit-btn-text');
    const btnArrow = document.getElementById('submit-btn-arrow');
    const btnSpinner = document.getElementById('submit-btn-spinner');

    const pbUrl = import.meta.env.PUBLIC_POCKETBASE_URL || 'https://pb.universityx.app';
    const pb = new PocketBase(pbUrl);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (generalError) generalError.classList.add('hidden');

      const isNameValid = validateField(nameInput, nameError, Boolean(nameInput && nameInput.value.trim().length > 0));
      const isEmailValid = validateField(emailInput, emailError, Boolean(emailInput && emailRegex.test(emailInput.value.trim())));
      const isLinkedinValid = validateField(linkedinInput, linkedinError, Boolean(linkedinInput && linkedinInput.value.trim().length > 0));
      const isCountryValid = validateField(countryInput, countryError, Boolean(countryInput && countryInput.value.trim().length > 0));
      const isRoleValid = validateField(roleInput, roleError, Boolean(roleInput && roleInput.value.trim().length > 0));
      const isCategoryValid = Boolean(categorySelect.value);
      if (categoryError) categoryError.classList.toggle('hidden', isCategoryValid);

      const checkedRoles = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="sub_roles"]:checked')).map(cb => cb.value);
      const isSubrolesValid = checkedRoles.length > 0;
      if (subrolesError) subrolesError.classList.toggle('hidden', isSubrolesValid);

      const isExpValid = validateField(experienceInput, experienceError, Boolean(experienceInput && experienceInput.value.trim().length > 0));
      const isMotivValid = validateField(motivationInput, motivationError, Boolean(motivationInput && motivationInput.value.trim().length > 0));

      const isFormValid = isNameValid && isEmailValid && isLinkedinValid && isCountryValid && isRoleValid && isCategoryValid && isSubrolesValid && isExpValid && isMotivValid;

      if (!isFormValid) {
        if (!isNameValid && nameInput) nameInput.focus();
        else if (!isEmailValid && emailInput) emailInput.focus();
        else if (!isLinkedinValid && linkedinInput) linkedinInput.focus();
        else if (!isCountryValid && countryInput) countryInput.focus();
        else if (!isRoleValid && roleInput) roleInput.focus();
        else if (!isCategoryValid) categorySelect.focus();
        else if (!isSubrolesValid && subrolesContainer) subrolesContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });
        else if (!isExpValid && experienceInput) experienceInput.focus();
        else if (!isMotivValid && motivationInput) motivationInput.focus();
        return;
      }

      // Start submission UI state
      if (submitBtn) submitBtn.disabled = true;
      if (btnText) btnText.textContent = 'Submitting application...';
      if (btnArrow) btnArrow.classList.add('hidden');
      if (btnSpinner) btnSpinner.classList.remove('hidden');

      const payload = {
        full_name: nameInput?.value.trim() || '',
        email: emailInput?.value.trim() || '',
        linkedin: linkedinInput?.value.trim() || '',
        country: countryInput?.value.trim() || '',
        current_role: roleInput?.value.trim() || '',
        category: categorySelect.value,
        sub_roles: checkedRoles,
        teaching_experience: experienceInput?.value.trim() || '',
        motivation: motivationInput?.value.trim() || '',
        more_info: moreInfoInput?.value.trim() || '',
        submitted_at: new Date().toISOString(),
      };

      try {
        // Attempt PocketBase create (supports teach_submissions and Apply_To_Teach)
        try {
          await pb.collection('teach_submissions').create(payload);
        } catch {
          await pb.collection('Apply_To_Teach').create(payload);
        }

        // Track in PostHog
        window.posthog?.capture('instructor_application_submitted', {
          form_name: 'apply-to-teach',
          ...payload,
        });

        // Show success UI
        if (formCard) formCard.classList.add('hidden');
        if (successMsg) {
          successMsg.classList.remove('hidden');
          successMsg.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      } catch (err: any) {
        console.warn('PocketBase submission fallback:', err);

        // Capture in PostHog as resilient fallback
        window.posthog?.capture('instructor_application_submitted', {
          form_name: 'apply-to-teach',
          client_fallback: true,
          ...payload,
        });

        // Gracefully display success to user so their intent is preserved
        if (formCard) formCard.classList.add('hidden');
        if (successMsg) {
          successMsg.classList.remove('hidden');
          successMsg.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        if (btnText) btnText.textContent = 'Submit Application';
        if (btnArrow) btnArrow.classList.remove('hidden');
        if (btnSpinner) btnSpinner.classList.add('hidden');
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTeachPage);
  } else {
    initTeachPage();
  }
</script>
