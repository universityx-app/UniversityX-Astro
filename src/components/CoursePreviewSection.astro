---
import { courses, getCoursePath } from '../data/courses';

const filters = [
  { label: 'Featured', value: 'featured' },
  { label: 'AI & Data Science', value: 'ai-data-science' },
  { label: 'Software Engineering', value: 'software-engineering' },
  { label: 'Product & Design', value: 'product-design' },
];
---

<section class="bg-[#F5F2EB] px-6 py-20 md:px-12 md:py-28 lg:px-24" aria-labelledby="course-preview-heading" id="courses">
  <div class="mx-auto max-w-7xl">
    <div class="grid grid-cols-1 items-end gap-7 lg:grid-cols-[1.25fr_0.75fr] lg:gap-16">
      <div>
        <p class="inline-flex items-center rounded-full border border-[#1A0533]/10 bg-white px-4 py-2 text-xs font-semibold uppercase tracking-widest text-[#1A0533]/50">Choose what to learn</p>
        <h2 id="course-preview-heading" class="mt-5 max-w-3xl text-3xl font-extrabold leading-tight text-[#1A0533] md:text-5xl">Practical courses built around real skills.</h2>
      </div>
      <p class="max-w-xl text-lg leading-relaxed text-gray-600 md:text-xl">Learn by doing, not just watching. Practise what you learn, build real projects, and choose to learn at your own pace, with a cohort, or 1-on-1.</p>
    </div>

    <div class="mt-14 flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
      <div class="flex gap-2 overflow-x-auto pb-1" aria-label="Filter courses">
        {filters.map((filter, index) => (
          <button type="button" class:list={['course-filter shrink-0 rounded-full border px-5 py-3 text-sm font-semibold transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#8A40F5] focus-visible:ring-offset-2 md:text-base', index === 0 && 'is-active']} data-course-filter={filter.value} aria-pressed={index === 0 ? 'true' : 'false'}>{filter.label}</button>
        ))}
      </div>
      <div class="flex items-center gap-3 self-end md:self-auto" aria-label="Course carousel controls">
        <button type="button" class="course-arrow" data-course-previous aria-label="Show previous course" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg></button>
        <button type="button" class="course-arrow" data-course-next aria-label="Show next course"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg></button>
      </div>
    </div>

    <div class="course-track mt-7" data-course-track tabindex="0" aria-label="Courses">
      {courses.map((course) => {
        const content = (
          <>
            <div class="relative overflow-hidden">
              <img src={course.thumbnail} alt={course.title} class="aspect-video w-full object-cover" loading="lazy" />
              {course.status === 'coming-soon' && <span class="absolute left-4 top-4 rounded-full bg-[#1A0533] px-3 py-1.5 text-xs font-bold text-white">Coming soon</span>}
            </div>
            <div class="flex flex-1 flex-col bg-white p-5">
              <h3 class="text-lg font-bold leading-snug text-[#1A0533]">{course.title}</h3>
              <p class="mt-3 text-base leading-snug text-gray-600">{course.description}</p>
              <div class="mt-auto flex flex-wrap items-center gap-x-1.5 gap-y-1 pt-6 text-sm font-medium text-gray-400">
                <span>{course.path}</span>
                <span class="text-[#1A0533]/20" aria-hidden="true">·</span>
                <span>{course.track}</span>
                <span class="text-[#1A0533]/20" aria-hidden="true">·</span>
                <span>{course.level}</span>
              </div>
            </div>
          </>
        );
        return course.status === 'available' ? (
          <a href={getCoursePath(course)} class="course-card group" data-course-card data-category={course.category} data-featured={String(course.featured)} data-course-title={course.title}>{content}</a>
        ) : (
          <article class="course-card group" data-course-card data-category={course.category} data-featured={String(course.featured)} data-course-title={course.title} aria-label={`${course.title}, coming soon`}>{content}</article>
        );
      })}
    </div>
    <p class="sr-only" aria-live="polite" data-course-status>Showing featured courses.</p>
  </div>
</section>

<style>
  .course-filter { border-color: rgb(26 5 51 / 12%); background: white; color: rgb(26 5 51 / 68%); }
  .course-filter:hover { border-color: rgb(138 64 245 / 45%); color: #8a40f5; }
  .course-filter.is-active { border-color: #1a0533; background: #1a0533; color: white; }
  .course-arrow { display: grid; width: 2.75rem; height: 2.75rem; place-items: center; border: 1px solid rgb(26 5 51 / 16%); border-radius: 999px; background: white; color: #1a0533; cursor: pointer; transition: border-color .2s, color .2s, opacity .2s; }
  .course-arrow svg { width: 1.25rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .course-arrow:hover:not(:disabled) { border-color: #8a40f5; color: #8a40f5; }
  .course-arrow:focus-visible { outline: 2px solid #8a40f5; outline-offset: 3px; }
  .course-arrow:disabled { cursor: not-allowed; opacity: .32; }
  .course-track { display: flex; gap: 1.5rem; overflow-x: auto; padding-bottom: 1.75rem; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-inline: contain; }
  .course-track::-webkit-scrollbar { display: none; }
  .course-card { display: flex; min-width: calc((100% - 3rem) / 3); flex: 0 0 calc((100% - 3rem) / 3); scroll-snap-align: start; flex-direction: column; overflow: hidden; border-radius: 1rem; background: white; box-shadow: 0 10px 15px -3px rgb(0 0 0 / 10%), 0 4px 6px -4px rgb(0 0 0 / 10%); transition: box-shadow .3s; }
  a.course-card:hover { box-shadow: 0 20px 25px -5px rgb(0 0 0 / 10%), 0 8px 10px -6px rgb(0 0 0 / 10%); }
  a.course-card:focus-visible { outline: 3px solid #8a40f5; outline-offset: 3px; }
  .course-card[hidden] { display: none; }
  @media (max-width: 1023px) { .course-card { min-width: calc((100% - 1.5rem) / 2); flex-basis: calc((100% - 1.5rem) / 2); } }
  @media (max-width: 639px) { .course-card { min-width: 88%; flex-basis: 88%; } }
  @media (prefers-reduced-motion: reduce) { .course-track { scroll-behavior: auto !important; } .course-card, .course-card img { transition: none; } }
</style>

<script>
  function initCourseCarousel() {
    const track = document.querySelector<HTMLElement>('[data-course-track]');
    if (!track || track.dataset.initialized === 'true') return;
    track.dataset.initialized = 'true';
    const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-course-filter]'));
    const cards = Array.from(track.querySelectorAll<HTMLElement>('[data-course-card]'));
    const previous = document.querySelector<HTMLButtonElement>('[data-course-previous]');
    const next = document.querySelector<HTMLButtonElement>('[data-course-next]');
    const status = document.querySelector<HTMLElement>('[data-course-status]');
    const visibleCards = () => cards.filter((card) => !card.hidden);
    const updateControls = () => {
      const visible = visibleCards();
      const trackBounds = track.getBoundingClientRect();
      const firstBounds = visible[0]?.getBoundingClientRect();
      const lastBounds = visible.at(-1)?.getBoundingClientRect();
      const atStart = !firstBounds || firstBounds.left >= trackBounds.left - 2;
      const atEnd = !lastBounds || lastBounds.right <= trackBounds.right + 2;
      if (previous) previous.disabled = atStart || visible.length <= 1;
      if (next) next.disabled = atEnd || visible.length <= 1;
      if (status && visible.length) {
        const left = track.scrollLeft;
        const origin = visible[0].offsetLeft;
        let nearest = 0;
        visible.forEach((card, index) => { if (Math.abs(card.offsetLeft - origin - left) < Math.abs(visible[nearest].offsetLeft - origin - left)) nearest = index; });
        status.textContent = `${visible[nearest].dataset.courseTitle}. Course ${nearest + 1} of ${visible.length}.`;
      }
    };
    const move = (direction: number) => {
      const visible = visibleCards();
      if (!visible.length) return;
      const origin = visible[0].offsetLeft;
      let current = 0;
      visible.forEach((card, index) => { if (card.offsetLeft - origin <= track.scrollLeft + 6) current = index; });
      const target = visible[Math.max(0, Math.min(visible.length - 1, current + direction))];
      track.scrollTo({ left: target.offsetLeft - origin, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      window.setTimeout(updateControls, 450);
    };
    previous?.addEventListener('click', () => move(-1));
    next?.addEventListener('click', () => move(1));
    track.addEventListener('scroll', updateControls, { passive: true });
    track.addEventListener('keydown', (event) => { if (event.key === 'ArrowRight') { event.preventDefault(); move(1); } if (event.key === 'ArrowLeft') { event.preventDefault(); move(-1); } });
    filters.forEach((button) => button.addEventListener('click', () => {
      const selected = button.dataset.courseFilter || 'featured';
      filters.forEach((item) => { const active = item === button; item.classList.toggle('is-active', active); item.setAttribute('aria-pressed', String(active)); });
      cards.forEach((card) => { card.hidden = selected === 'featured' ? card.dataset.featured !== 'true' : card.dataset.category !== selected; });
      track.scrollTo({ left: 0, behavior: 'auto' });
      requestAnimationFrame(updateControls);
    }));
    window.addEventListener('resize', updateControls);
    updateControls();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initCourseCarousel); else initCourseCarousel();
</script>
