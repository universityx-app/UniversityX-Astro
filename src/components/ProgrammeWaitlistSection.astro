---
const programs = [
  'AI & Data Science',
  'Product',
  'Design',
  'Marketing',
  'Sales',
  'Business',
  'Security',
];

const levels = [
  'Beginner',
  'Intermediate',
  'Advanced',
  'Professional',
  'Not sure yet',
];
---

<section id="programme-waitlist" class="scroll-mt-28 bg-white py-20 md:py-28 px-6 md:px-12 lg:px-24">
  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-[0.9fr_1.1fr] gap-10 lg:gap-16 items-start">
    <div>
      <p class="inline-flex items-center gap-2 rounded-full border border-[#1A0533]/10 bg-[#F5F2EB] px-4 py-2 text-xs font-semibold text-[#1A0533]/50 tracking-widest uppercase mb-6">
        Future programmes
      </p>
      <h2 class="text-3xl md:text-5xl font-extrabold text-[#1A0533] leading-tight mb-5">
        Get updates when another path opens.
      </h2>
      <p class="text-gray-600 text-lg md:text-xl leading-relaxed">
        Software Engineering is the active UniversityX path right now. If you are interested in AI & Data Science, Product, Design, Marketing, Sales, Business or Security, join the waitlist and we will let you know when that path opens.
      </p>
    </div>

    <div class="bg-[#F5F2EB] rounded-3xl p-6 md:p-8 border border-[#1A0533]/10">
      <div id="programme-waitlist-success" class="hidden rounded-2xl bg-white p-6 text-[#1A0533] font-semibold">
        You&rsquo;re on the list. We&rsquo;ll let you know when your selected programme opens.
      </div>

      <form
        id="programme-waitlist-form"
        class="space-y-5"
      >
        <div>
          <label for="waitlist-program" class="block text-sm font-semibold text-[#1A0533] mb-2">Programme</label>
          <select
            id="waitlist-program"
            name="program"
            required
            class="w-full bg-white rounded-xl px-5 py-4 text-[#1A0533] border border-transparent focus:outline-none focus:ring-2 focus:ring-[#8A40F5] focus:border-[#8A40F5]"
          >
            <option value="">Select a programme</option>
            {programs.map((program) => (
              <option value={program}>{program}</option>
            ))}
          </select>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div>
            <label for="waitlist-name" class="block text-sm font-semibold text-[#1A0533] mb-2">Full name</label>
            <input
              id="waitlist-name"
              name="name"
              type="text"
              required
              placeholder="Your name"
              class="w-full bg-white rounded-xl px-5 py-4 text-[#1A0533] placeholder-gray-400 border border-transparent focus:outline-none focus:ring-2 focus:ring-[#8A40F5] focus:border-[#8A40F5]"
            />
          </div>

          <div>
            <label for="waitlist-email" class="block text-sm font-semibold text-[#1A0533] mb-2">Email address</label>
            <input
              id="waitlist-email"
              name="email"
              type="email"
              required
              placeholder="you@example.com"
              class="w-full bg-white rounded-xl px-5 py-4 text-[#1A0533] placeholder-gray-400 border border-transparent focus:outline-none focus:ring-2 focus:ring-[#8A40F5] focus:border-[#8A40F5]"
            />
          </div>
        </div>

        <div>
          <label for="waitlist-level" class="block text-sm font-semibold text-[#1A0533] mb-2">Current level</label>
          <select
            id="waitlist-level"
            name="currentLevel"
            required
            class="w-full bg-white rounded-xl px-5 py-4 text-[#1A0533] border border-transparent focus:outline-none focus:ring-2 focus:ring-[#8A40F5] focus:border-[#8A40F5]"
          >
            <option value="">Select your level</option>
            {levels.map((level) => (
              <option value={level}>{level}</option>
            ))}
          </select>
        </div>

        <button
          id="programme-waitlist-submit"
          type="submit"
          class="w-full bg-[#8A40F5] hover:bg-[#7434D8] text-white font-bold text-base rounded-xl py-4 transition-colors duration-200 cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#8A40F5] focus:ring-offset-2 focus:ring-offset-[#F5F2EB]"
        >
          Join the waitlist
        </button>

        <p id="programme-waitlist-error" class="hidden text-red-600 text-sm">
          We couldn&rsquo;t add you to the waitlist. Please check your details and try again.
        </p>
      </form>
    </div>
  </div>
</section>

<script>
  import PocketBase from 'pocketbase';

  function initProgrammeWaitlistForm() {
    const form = document.getElementById('programme-waitlist-form') as HTMLFormElement | null;
    const success = document.getElementById('programme-waitlist-success');
    const error = document.getElementById('programme-waitlist-error');
    const submit = document.getElementById('programme-waitlist-submit') as HTMLButtonElement | null;
    if (!form || !success || !error || !submit) return;

    const pb = new PocketBase(import.meta.env.PUBLIC_POCKETBASE_URL);

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      error.classList.add('hidden');

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const formData = new FormData(form);
      submit.disabled = true;
      submit.textContent = 'Joining...';

      try {
        await pb.collection('UniversityX_Future_Programs').create({
          Select_a_Program: formData.get('program') as string,
          Full_Name: formData.get('name') as string,
          Email: formData.get('email') as string,
          Select_Your_Level: formData.get('currentLevel') as string,
        });

        window.posthog?.capture('programme_waitlist_joined', {
          program: formData.get('program'),
          current_level: formData.get('currentLevel'),
          source: 'homepage-programme-waitlist',
        });

        form.classList.add('hidden');
        success.classList.remove('hidden');
      } catch (err) {
        window.posthog?.captureException?.(err);
        error.classList.remove('hidden');
        submit.disabled = false;
        submit.textContent = 'Join the waitlist';
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProgrammeWaitlistForm);
  } else {
    initProgrammeWaitlistForm();
  }
</script>
