---
const tracks = [
  {
    name: 'Software Engineering',
    roles: 'Frontend Developer · Backend Engineer · Full-Stack Developer · Platform Engineer',
  },
  {
    name: 'AI & Data Science',
    roles: 'AI Engineer · Applied AI Developer · Machine Learning Engineer · Data Professional',
  },
  {
    name: 'Product',
    roles: 'Product Manager · Product Analyst · Product Marketer · Product Engineer',
  },
  {
    name: 'Design',
    roles: 'Product Designer · User Experience Designer · Design Engineer · Systems Designer',
  },
  {
    name: 'Marketing',
    roles: 'Marketing Analyst · Growth Marketer · Digital Marketing Specialist · Product Marketer · Content Marketer',
  },
  {
    name: 'Sales',
    roles: 'Sales Development · Account Executive · Customer Success · Business Development · Solutions Consultant',
  },
  {
    name: 'Business',
    roles: 'Management Consultant · Financial Analyst · Operations Associate · Chief of Staff',
  },
  {
    name: 'Security',
    roles: 'AI Security Analyst · Security Engineer · Cybersecurity Analyst · SOC Analyst · GRC Analyst',
  },
];
---

<section id="career-paths" class="scroll-mt-28 bg-[#F5F2EB] py-20 md:py-28 px-6 md:px-12 lg:px-24">
  <div class="max-w-7xl mx-auto">
    <div class="mb-14 grid grid-cols-1 items-end gap-7 lg:grid-cols-[1.25fr_0.75fr] lg:gap-16">
      <div>
        <p class="inline-flex items-center rounded-full border border-[#1A0533]/10 bg-white px-4 py-2 text-xs font-semibold uppercase tracking-widest text-[#1A0533]/50">
          Choose what to learn
        </p>
        <h2 class="mt-5 max-w-3xl text-3xl font-extrabold leading-tight text-[#1A0533] md:text-5xl">
          Practical career paths built around real work.
        </h2>
      </div>
      <p class="max-w-xl text-lg leading-relaxed text-gray-600 md:text-xl">
        Each path brings together practical courses and projects that move you from learning concepts to completing real work that demonstrates your skills.
      </p>
    </div>

    <div class="overflow-hidden rounded-2xl border border-[#1A0533]/10 bg-white">
      {tracks.map((track) => (
        <div class="border-b border-[#1A0533]/10 bg-white last:border-b-0">
          <div class="grid grid-cols-1 gap-4 p-6 md:p-8 lg:grid-cols-[0.9fr_1.1fr] lg:gap-8">
            <div>
              <h3 class="text-2xl font-extrabold text-[#1A0533] md:text-3xl">{track.name}</h3>
            </div>
            <p class="text-base leading-relaxed text-gray-600 md:text-lg">{track.roles}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
