---
const courseHref = '/paths/software-engineering/build-your-first-ai-application';
const pathHref = '/paths/software-engineering';

const tracks = [
  {
    name: 'Software Engineering',
    status: 'Now Enrolling',
    roles: 'AI-Native Software Engineer · Frontend Developer · Backend Engineer · Full-Stack Developer',
    href: pathHref,
    active: true,
  },
  {
    name: 'AI & Data Science',
    status: 'Coming Soon',
    roles: 'AI Engineer · Machine Learning Engineer · Data Scientist · Business Intelligence Analyst',
  },
  {
    name: 'Product',
    status: 'Coming Soon',
    roles: 'Product Manager · Product Analyst · Product Marketer · Product Engineer',
  },
  {
    name: 'Design',
    status: 'Coming Soon',
    roles: 'Product Designer · User Experience Designer · Design Engineer · Systems Designer',
  },
  {
    name: 'Marketing',
    status: 'Coming Soon',
    roles: 'Marketing Analyst · Growth Marketer · Digital Marketing Specialist · Product Marketer · Content Marketer',
  },
  {
    name: 'Sales',
    status: 'Coming Soon',
    roles: 'Sales Development · Account Executive · Customer Success · Business Development · Solutions Consultant',
  },
  {
    name: 'Business',
    status: 'Coming Soon',
    roles: 'Management Consultant · Financial Analyst · Operations Associate · Chief of Staff',
  },
  {
    name: 'Security',
    status: 'Coming Soon',
    roles: 'AI Security Analyst · Security Engineer · Cybersecurity Analyst · SOC Analyst · GRC Analyst',
  },
];
---

<section id="career-paths" class="scroll-mt-28 bg-[#F5F2EB] py-20 md:py-28 px-6 md:px-12 lg:px-24">
  <div class="max-w-7xl mx-auto">
    <div class="max-w-3xl mb-12">
      <p class="inline-flex items-center gap-2 rounded-full border border-[#1A0533]/10 bg-white px-4 py-2 text-xs font-semibold text-[#1A0533]/50 tracking-widest uppercase mb-6">
        Career paths
      </p>
      <h2 class="text-3xl md:text-5xl font-extrabold text-[#1A0533] leading-tight mb-4">
        Explore UniversityX Career Paths
      </h2>
      <p class="text-gray-600 text-lg md:text-xl leading-relaxed">
        UniversityX is building practical, AI-native career paths across the roles shaping the modern economy. We are starting with Software Engineering. More paths will open as the first path is proven.
      </p>
    </div>

    <div class="bg-white rounded-3xl overflow-hidden border border-[#1A0533]/10">
      {tracks.map((track) => (
        <div class={`border-b border-[#1A0533]/10 last:border-b-0 ${track.active ? 'bg-white' : 'bg-[#FDFCF8]'}`}>
          {track.active ? (
            <a href={track.href} class="grid grid-cols-1 lg:grid-cols-[0.9fr_1.1fr_auto] gap-4 lg:gap-8 p-6 md:p-8 hover:bg-[#F9F8F3] transition-colors focus:outline-none focus:ring-2 focus:ring-[#8A40F5] focus:ring-inset">
              <div>
                <span class="inline-flex rounded-full bg-[#8A40F5] text-white text-xs font-semibold px-3 py-1 mb-3">
                  {track.status}
                </span>
                <h3 class="text-2xl md:text-3xl font-extrabold text-[#1A0533]">{track.name}</h3>
              </div>
              <p class="text-gray-600 text-base md:text-lg leading-relaxed">{track.roles}</p>
              <span class="text-[#8A40F5] font-semibold self-center">View path</span>
            </a>
          ) : (
            <div class="grid grid-cols-1 lg:grid-cols-[0.9fr_1.1fr_auto] gap-4 lg:gap-8 p-6 md:p-8">
              <div>
                <span class="inline-flex rounded-full bg-[#1A0533]/10 text-[#1A0533]/55 text-xs font-semibold px-3 py-1 mb-3">
                  {track.status}
                </span>
                <h3 class="text-2xl md:text-3xl font-extrabold text-[#1A0533]/70">{track.name}</h3>
              </div>
              <p class="text-gray-500 text-base md:text-lg leading-relaxed">{track.roles}</p>
              <a href="#programme-waitlist" class="text-[#8A40F5] font-semibold self-center hover:underline">Get updates</a>
            </div>
          )}

          {track.active && (
            <div class="mx-6 md:mx-8 mb-8 rounded-2xl border-2 border-[#8A40F5]/30 bg-[#F5F2EB] p-6 md:p-7">
              <div class="flex flex-wrap items-center gap-3 text-sm font-semibold text-[#1A0533]/70 mb-4">
                <span>Starts 17 August 2026</span>
                <span class="w-1 h-1 rounded-full bg-[#8A40F5]"></span>
                <span>6 weeks</span>
                <span class="w-1 h-1 rounded-full bg-[#8A40F5]"></span>
                <span>₦25,000</span>
                <span class="text-gray-400 line-through">₦30,000</span>
              </div>
              <h4 class="text-xl md:text-2xl font-bold text-[#1A0533] mb-3">Build and Ship Agentic AI Applications in 6 Weeks</h4>
              <p class="text-gray-600 text-base md:text-lg leading-relaxed mb-4">
                Build and deploy an AI-powered application while learning how to write clear specifications, direct AI tools, evaluate their output and verify that what you built actually works.
              </p>
              <p class="text-sm md:text-base text-[#1A0533] font-semibold mb-6">Basic JavaScript or Python required.</p>
              <div class="flex flex-wrap gap-3">
                <a href={courseHref} class="inline-flex items-center justify-center rounded-full border border-[#8A40F5] text-[#8A40F5] font-semibold px-6 py-3 hover:bg-white transition-colors focus:outline-none focus:ring-2 focus:ring-[#8A40F5]">
                  View Course
                </a>
                <a href={courseHref} class="inline-flex items-center justify-center rounded-full bg-[#8A40F5] text-white font-semibold px-6 py-3 hover:bg-[#7434D8] transition-colors focus:outline-none focus:ring-2 focus:ring-[#8A40F5] focus:ring-offset-2">
                  Join the 17 August Cohort
                </a>
              </div>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
