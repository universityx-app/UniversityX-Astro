---
const socialLinks = [
  {
    label: 'Facebook',
    href: 'https://www.facebook.com/universityxapp/',
    icon: 'M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z',
  },
  {
    label: 'LinkedIn',
    href: 'https://linkedin.com/company/universityx-app/',
    icon: 'M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2zM4 6a2 2 0 100-4 2 2 0 000 4z',
  },
  {
    label: 'Instagram',
    href: 'https://instagram.com/universityx_app/',
    paths: [
      'M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 01-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 017.8 2z',
      'M16.5 11.37A4.5 4.5 0 1112.63 7.5a4.5 4.5 0 013.87 3.87z',
      'M17.5 6.5h.01',
    ],
  },
  {
    label: 'X',
    href: 'https://x.com/universityx_app',
    viewBox: '0 0 24 24',
    pathD: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z',
  },
];

---

<footer class="bg-[#1C1410]">
  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-16 xl:px-24">
    <div class="flex flex-col md:flex-row items-start md:items-end justify-between gap-8 py-12 md:py-16">
      <img
        src="/images/universityx-svg.svg"
        class="w-full md:w-1/2"
        alt="UniversityX"
        loading="lazy"
      />

      <div class="flex items-center gap-3">
        {socialLinks.map((link) => (
          <a
            href={link.href}
            aria-label={link.label}
            class="w-10 h-10 rounded-full border border-gray-600 flex items-center justify-center text-gray-400 hover:text-white hover:border-gray-400 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-white/40"
          >
            {link.icon && (
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={link.icon} />
              </svg>
            )}
            {link.paths && (
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                {link.paths.map((p) => <path d={p} />)}
              </svg>
            )}
            {link.pathD && (
              <svg class="w-4 h-4" viewBox={link.viewBox || '0 0 24 24'} aria-hidden="true">
                <path d={link.pathD} fill="currentColor" />
              </svg>
            )}
          </a>
        ))}
      </div>
    </div>

    <div class="border-t border-[#2A2420] py-8 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
      <p class="text-gray-400 text-base">© {new Date().getFullYear()} UniversityX. All rights reserved.</p>
      <nav class="flex flex-wrap items-center gap-x-6 gap-y-3" aria-label="Footer">
        <a href="/#career-paths" class="text-gray-400 text-base hover:text-white transition-colors duration-200">Career Paths</a>
        <a href="/#faq" class="text-gray-400 text-base hover:text-white transition-colors duration-200">FAQ</a>
        <a href="/contact" class="text-gray-400 text-base hover:text-white transition-colors duration-200">Contact</a>
        <a href="/privacy-policy" class="text-gray-400 text-base hover:text-white transition-colors duration-200">Privacy Policy</a>
        <a href="/terms-of-service" class="text-gray-400 text-base hover:text-white transition-colors duration-200">Terms of Service</a>
      </nav>
    </div>
  </div>
</footer>
